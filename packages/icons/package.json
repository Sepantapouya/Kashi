{
  "name": "@kashi-ui/icons",
  "version": "2.9.0",
  "description": "آیکون‌های کاشی در شش سبک؛ SVG، اسپرایت و کامپوننت React، Vue و Svelte",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./svg/*": "./dist/svg/*",
    "./sprite.svg": "./dist/sprite.svg",
    "./sprite-*.svg": "./dist/sprite-*.svg",
    "./package.json": "./package.json",
    "./svg/bold/brand-*.svg": "./dist/svg/brand-*.svg",
    "./svg/bold/crypto-*.svg": "./dist/svg/crypto-*.svg",
    "./svg/bulk/brand-*.svg": "./dist/svg/brand-*.svg",
    "./svg/bulk/crypto-*.svg": "./dist/svg/crypto-*.svg",
    "./svg/two-tone/brand-*.svg": "./dist/svg/brand-*.svg",
    "./svg/two-tone/crypto-*.svg": "./dist/svg/crypto-*.svg",
    "./svg/broken/brand-*.svg": "./dist/svg/brand-*.svg",
    "./svg/broken/crypto-*.svg": "./dist/svg/crypto-*.svg",
    "./svg/curved/brand-*.svg": "./dist/svg/brand-*.svg",
    "./svg/curved/crypto-*.svg": "./dist/svg/crypto-*.svg"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "brand-sources.json",
    "Vazirmatn-OFL.txt",
    "audits/vazirmatn-glyphs.json",
    "general-sources.json",
    "Tabler-MIT.txt",
    "Iconoir-MIT.txt",
    "Hugeicons-MIT.txt",
    "Natural-Earth-PUBLIC-DOMAIN.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3",
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "persian",
    "rtl",
    "kashi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sepantapouya/Kashi.git",
    "directory": "packages/icons"
  },
  "homepage": "https://kashi.sepantapouya.com/docs/icons/",
  "bugs": "https://github.com/Sepantapouya/Kashi/issues",
  "author": "Sepanta Pouya (https://sepantapouya.com)",
  "license": "MIT",
  "devDependencies": {
    "svelte": "^5.57.3",
    "vue": "^3.5.45"
  }
}
