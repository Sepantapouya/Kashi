{
  "name": "@kashi-ui/tailwind",
  "version": "0.24.0",
  "description": "پریست Tailwind کاشی: رنگ‌ها، فونت، گردی گوشه و سایه‌های کاشی به‌شکل کلاس‌های Tailwind، همگام با تم تیره و روشن",
  "type": "module",
  "style": "./dist/theme.css",
  "exports": {
    ".": { "style": "./dist/theme.css", "default": "./dist/theme.css" },
    "./theme.css": "./dist/theme.css",
    "./preset": { "require": "./dist/preset.cjs", "default": "./dist/preset.mjs" },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@kashi-ui/css": "^0.24.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.0"
  },
  "publishConfig": { "access": "public" },
  "keywords": ["tailwind", "tailwindcss", "preset", "design-system", "persian", "rtl", "kashi"],
  "repository": { "type": "git", "url": "git+https://github.com/Sepantapouya/Kashi.git", "directory": "packages/tailwind" },
  "homepage": "https://kashi.sepantapouya.com/docs/tailwind/",
  "bugs": "https://github.com/Sepantapouya/Kashi/issues",
  "author": "Sepanta Pouya (https://sepantapouya.com)",
  "license": "MIT"
}
