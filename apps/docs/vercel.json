{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix ../..",
  "buildCommand": "npm run docs:build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "stats": false,
      "status": false
    }
  },
  "headers": [
    {
      "source": "/learn/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
