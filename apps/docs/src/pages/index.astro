              </li>
            ))}
          </ul>
          <div class="iconset__foot">
            <dl class="iconset__stats">
              <div><dt>آیکون</dt><dd>{fa(iconCount)}</dd></div>
              <div><dt>سبک</dt><dd>{fa(variants.length)}</dd></div>
              <div><dt>دسته</dt><dd>{fa(iconCategoryCount)}</dd></div>
            </dl>
            <div class="iconset__links">
              <a class="text-link" href="/docs/icons/category/persian/">آیکون‌های ایرانی <span aria-hidden="true">←</span></a>
              <a class="text-link" href="/docs/icons/">همهٔ آیکون‌ها <span aria-hidden="true">←</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───── ۰۴ کیفیت و حاکمیت ───── -->
    <section class="band band--alt" aria-labelledby="quality-title">
      <div class="wrap">
        <header class="band__head" data-reveal>
          <div>
            <p class="kicker"><span class="kicker__n">۰۴</span>کیفیت و نگه‌داری</p>
            <h2 id="quality-title">کیفیت در فرایند ساخت، نه در وعده</h2>
          </div>
          <p class="band__lead">هر تغییر در کاشی از یک مسیر خودکار می‌گذرد. چیزی که این مسیر را رد نکند، به دست تیم شما نمی‌رسد.</p>
        </header>

        <div class="quality">
          <ul class="quality__grid" role="list">
            {governance.map((g, i) => (
              <li class="quality__item" data-reveal style={`--i: ${i}`}>
                <span class="quality__icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={g.icon} /></svg>
                </span>
                <h3>{g.title}</h3>
                <p>{g.text}</p>
              </li>
            ))}
          </ul>

          <figure class="ci" data-reveal aria-labelledby="ci-caption">
            <div class="ci__head" dir="ltr">
              <span class="ci__repo">Sepantapouya/Kashi</span>
              <span class="ci__branch">main</span>
            </div>
            <ol class="ci__list" role="list">
              {checks.map(([job, desc]) => (
                <li>
                  <span class="ci__ok" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={ICON.check} /></svg></span>
                  <code>{job}</code>
                  <span class="ci__desc">{desc}</span>
                </li>
              ))}
            </ol>
            <figcaption id="ci-caption" class="ci__foot">
              <span>گام‌های CI روی هر Pull Request</span>
              <a href={`${author.repo}/actions`} target="_blank" rel="noopener">GitHub Actions<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ───── ۰۴ مقایسه ───── -->
    <section class="band" aria-labelledby="vs-title">
      <div class="wrap">
        <header class="band__head" data-reveal>
          <div>
            <p class="kicker"><span class="kicker__n">۰۵</span>مقایسه</p>
            <h2 id="vs-title">کاشی در کنار دیزاین‌سیستم‌های جهانی</h2>
          </div>
          <p class="band__lead">بر اساس مستندات عمومی هر پروژه؛ با صداقت دربارهٔ جایی که کاشی بهترین انتخاب نیست.</p>
        </header>

        <div class="vs" data-reveal>
          <table class="vs__table">
            <caption class="k-sr-only">مقایسهٔ کاشی با shadcn/ui، MUI و Ant Design</caption>
            <thead>
              <tr>
                <th scope="col">قابلیت</th>
                {systems.map((s, i) => <th scope="col" class={i === 0 ? "is-us" : undefined}>{s}</th>)}
              </tr>
            </thead>
            <tbody>
              {compare.map(([label, marks]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {marks.map((m, i) => (
                    <td class={i === 0 ? "is-us" : undefined}>
                      <span class={`mk mk--${m}`} role="img" aria-label={MARK[m]}>
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={MARK_PATH[m]} /></svg>
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <div class="vs__foot">
            <ul class="vs__legend" role="list">
              {(["yes", "part", "no", "na"] as const).map((m) => (
                <li><span class={`mk mk--${m}`} aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={MARK_PATH[m]} /></svg></span>{MARK[m]}</li>
              ))}
            </ul>
            <a class="text-link" href="/docs/compare/">جدول کامل و روش ارزیابی <span aria-hidden="true">←</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───── ۰۵ شروع ───── -->
    <section class="band band--alt" aria-labelledby="steps-title">
      <div class="wrap">
        <header class="band__head" data-reveal>
          <div>
            <p class="kicker"><span class="kicker__n">۰۶</span>شروع</p>
            <h2 id="steps-title">سه قدم تا اولین صفحه</h2>
          </div>
          <p class="band__lead">بدون پیکربندی، بدون افزونهٔ RTL و بدون بستهٔ تاریخ جداگانه.</p>
        </header>
        <ol class="steps" role="list">
          {steps.map((s, i) => (
            <li class="step" data-reveal style={`--i: ${i}`}>
              <span class="step__n" aria-hidden="true">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <code class="step__code">{s.code}</code>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ───── نگه‌دارنده و حمایت ───── -->
    <section class="band" aria-label="نگه‌دارنده و حمایت">
      <div class="wrap people">
        <article class="author" data-reveal aria-labelledby="author-title">
          <img class="author__photo" src={author.photo} alt={`عکس ${author.name}`} width="400" height="400" loading="lazy" decoding="async" />
          <div class="author__body">
            <p class="kicker">نگه‌دارنده</p>
            <h2 id="author-title" class="author__name">{author.name}</h2>
            <p class="author__role">{author.role}</p>
            <p class="author__bio">{author.bio} کاشی را ساخت تا تیم‌های فارسی‌زبان به ابزار طراحی‌ای هم‌سطح با بهترین دیزاین‌سیستم‌های دنیا دسترسی داشته باشند.</p>
            <ul class="author__links" role="list">
              {author.links.map((l) => (
                <li><a href={l.href} target="_blank" rel="noopener">{l.label}<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a></li>
              ))}
            </ul>
          </div>
        </article>

        <article class="support" data-reveal aria-labelledby="support-title">
          <p class="kicker">حمایت از کاشی</p>
          <h2 id="support-title">کاشی رایگان است، اما ساختنش هزینه دارد</h2>
          <p>طراحی، کدنویسی، تست دسترس‌پذیری و نگه‌داری مداوم کاشی با هزینهٔ شخصی انجام می‌شود. اگر کاشی به کار تیمتان آمده، با حمایت مالی به ادامهٔ آن کمک کنید.</p>
          <p class="support__how">برای حمایت، در تلگرام به <bdi dir="ltr">@{author.telegram.handle}</bdi> پیام بدهید.</p>
          <div class="support__actions">
            <a class="k-btn k-btn--primary" href={author.telegram.href} target="_blank" rel="noopener">پیام در تلگرام<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
            <a class="k-btn k-btn--secondary" href={author.repo} target="_blank" rel="noopener">ستاره در GitHub<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
          </div>
        </article>
      </div>
    </section>

    <!-- ───── دعوت به عمل ───── -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="wrap cta__inner">
        <div>
          <h2 id="cta-title">محصول فارسی بعدی‌تان را با کاشی بسازید.</h2>
          <p>رایگان و متن‌باز با لایسنس MIT. مستندات کامل برای هر کامپوننت، با نمونهٔ React و HTML.</p>
        </div>
        <div class="cta__actions">
          <a class="k-btn k-btn--primary k-btn--lg" href="/docs/installation/">راهنمای نصب</a>
          <a class="k-btn k-btn--secondary k-btn--lg" href={author.repo} target="_blank" rel="noopener">مشاهده در GitHub<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

