          </figure>
        </div>
      </div>
    </section>

    <!-- ───── ۰۷ مقایسه ───── -->
    <section class="band" aria-labelledby="vs-title">
      <div class="wrap">
        <header class="band__head" data-reveal>
          <div>
            <p class="kicker"><span class="kicker__n">۰۷</span>مقایسه</p>
            <h2 id="vs-title">کاشی در کنار دیزاین‌سیستم‌های جهانی</h2>
          </div>
          <p class="band__lead">بر اساس مستندات عمومی هر پروژه؛ با صداقت دربارهٔ جایی که کاشی بهترین انتخاب نیست.</p>
        </header>

        <div class="vs" data-reveal>
          <table class="vs__table">
            <caption class="k-sr-only">مقایسهٔ کاشی با shadcn/ui، MUI و Ant Design</caption>
            <thead>
              <tr>
                <th scope="col">قابلیت</th>
                {systems.map((s, i) => <th scope="col" class={i === 0 ? "is-us" : undefined}>{s}</th>)}
              </tr>
            </thead>
            <tbody>
              {compare.map(([label, marks]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {marks.map((m, i) => (
                    <td class={i === 0 ? "is-us" : undefined}>
                      <span class={`mk mk--${m}`} role="img" aria-label={MARK[m]}>
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={MARK_PATH[m]} /></svg>
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <div class="vs__foot">
            <ul class="vs__legend" role="list">
              {(["yes", "part", "no", "na"] as const).map((m) => (
                <li><span class={`mk mk--${m}`} aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={MARK_PATH[m]} /></svg></span>{MARK[m]}</li>
              ))}
            </ul>
            <a class="text-link" href="/docs/compare/">جدول کامل و روش ارزیابی <span aria-hidden="true">←</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───── ۰۸ متن‌باز ───── -->
    <section class="band band--alt community" aria-labelledby="community-title">
      <div class="wrap">
        <header class="band__head band__head--center" data-reveal>
          <div>
            <p class="kicker"><span class="kicker__n">۰۸</span>متن‌باز</p>
            <h2 id="community-title">ساخته‌شده در فضای باز، با همراهی شما</h2>
          </div>
          <p class="band__lead">کد، نقشهٔ راه و همهٔ تصمیم‌ها در GitHub است. عددهای زیر زنده از خود GitHub می‌آیند؛ ستاره‌ها لحظه‌ای و کلون‌ها روزانه.</p>
        </header>

        <div class="live" data-reveal>
          <dl class="live__stats">
            {ghLive.map((m) => (
              <div class="live__stat">
                <dt>{m.label}</dt>
                <dd data-gh-wait={m.value == null ? "" : undefined}>{m.key ? <span data-gh={m.key}>{m.value != null ? faNum(m.value) : "—"}</span> : <span>{faNum(m.value!)}</span>}</dd>
              </div>
            ))}
          </dl>
          <figure class="live__chart">
            <figcaption>
              <span class="live__title">کلون روزانهٔ مخزن</span>
              <span class="live__legend"><i></i>کلون<i class="is-2"></i>کلون‌کنندهٔ یکتا</span>
            </figcaption>
            <div class="live__svg" data-gh-chart set:html={ghChart} />
          </figure>
          <p class="live__note"><span class="live__dot" aria-hidden="true"></span>زنده از GitHub · ستاره‌ها لحظه‌ای، کلون‌ها روزانه</p>
        </div>

        <a class="tgcard" href={author.channel.href} target="_blank" rel="noopener" data-reveal>
          <span class="tgcard__icon" set:html={iconSvg("send", { size: 26 })} />
          <span class="tgcard__body"><b>کانال تلگرام کاشی</b><small>خبر نسخه‌ها، کامپوننت‌ها و آیکون‌های تازه و نکته‌های طراحی رابط فارسی؛ زودتر از همه.</small></span>
          <span class="k-btn k-btn--primary tgcard__cta">عضو شوید <bdi dir="ltr">@{author.channel.handle}</bdi></span>
          <span class="k-sr-only"> (در پنجرهٔ جدید)</span>
        </a>

        <div class="people">
        <article class="author" data-reveal aria-labelledby="author-title">
          <img class="author__photo" src={author.photo} alt={`عکس ${author.name}`} width="400" height="400" loading="lazy" decoding="async" />
          <div class="author__body">
            <p class="kicker">نگه‌دارنده</p>
            <h2 id="author-title" class="author__name">{author.name}</h2>
            <p class="author__role">{author.role}</p>
            <p class="author__bio">{author.bio} کاشی را ساخت تا تیم‌های فارسی‌زبان به ابزار طراحی‌ای هم‌سطح با بهترین دیزاین‌سیستم‌های دنیا دسترسی داشته باشند.</p>
            <ul class="author__links" role="list">
              {author.links.map((l) => (
                <li><a href={l.href} target="_blank" rel="noopener">{l.label}<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a></li>
              ))}
            </ul>
          </div>
        </article>

        <article class="support" data-reveal aria-labelledby="support-title">
          <p class="kicker">حمایت از کاشی</p>
          <h2 id="support-title">کاشی رایگان است، اما ساختنش هزینه دارد</h2>
          <p>طراحی، کدنویسی، تست دسترس‌پذیری و نگه‌داری مداوم کاشی با هزینهٔ شخصی انجام می‌شود. اگر کاشی به کار تیمتان آمده، با حمایت مالی به ادامهٔ آن کمک کنید.</p>
          <p class="support__how">برای حمایت، در تلگرام به <bdi dir="ltr">@{author.telegram.handle}</bdi> پیام بدهید.</p>
          <div class="support__actions">
            <a class="k-btn k-btn--primary" href={author.telegram.href} target="_blank" rel="noopener">پیام در تلگرام<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
            <a class="k-btn k-btn--secondary" href={author.repo} target="_blank" rel="noopener">ستاره در GitHub<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
          </div>
        </article>
      </div>
      </div>
    </section>

    <!-- ───── پرسش‌های رایج ───── -->
    <section class="band" aria-labelledby="faq-title">
      <div class="wrap faq">
        <header class="faq__head" data-reveal>
          <p class="kicker"><span class="kicker__n">۰۹</span>پرسش‌های رایج</p>
          <h2 id="faq-title">پیش از انتخاب کاشی</h2>
          <p class="band__lead">پاسخ پرسش‌هایی که تیم‌ها معمولاً پیش از استفاده می‌پرسند. پرسش دیگری دارید؟ <a href={author.telegram.href} target="_blank" rel="noopener">در تلگرام بپرسید<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>.</p>
        </header>
        <div class="k-accordion faq__list" data-reveal>
          {faq.map(([q, a], i) => (
            <details class="k-accordion__item faq__item" name="faq" open={i === 0}>
              <summary class="k-accordion__trigger">{q}</summary>
              <div class="k-accordion__content"><p>{a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ───── شروع و دعوت به عمل ───── -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="cta__card" data-reveal>
          <div class="cta__glow" aria-hidden="true"></div>
          <div class="cta__head">
            <div>
              <p class="kicker">شروع در سه قدم</p>
              <h2 id="cta-title">محصول فارسی بعدی‌تان را با کاشی بسازید.</h2>
              <p>بدون پیکربندی، بدون افزونهٔ RTL و بدون بستهٔ تاریخ جداگانه. رایگان و متن‌باز با لایسنس MIT.</p>
            </div>
            <div class="cta__actions">
              <a class="k-btn k-btn--primary k-btn--lg" href="/docs/installation/">راهنمای نصب</a>
              <a class="k-btn k-btn--secondary k-btn--lg" href={author.telegram.href} target="_blank" rel="noopener">گفتگو برای سازمان‌ها<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
            </div>
          </div>
          <ol class="steps" role="list">
          {steps.map((s, i) => (
            <li class="step">
              <span class="step__n" aria-hidden="true">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <code class="step__code">{s.code}</code>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>
  </main>
  <Footer cta={false} />
</Base>

<style>
  .home { --max: 80rem; overflow-x: clip; }
  .wrap { max-inline-size: var(--max); margin-inline: auto; padding-inline: var(--gutter); }
  .text-link { display: inline-flex; gap: var(--k-space-1); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); text-decoration: none; }
  .text-link:hover { text-decoration: underline; }

  /* ورود و ظاهر شدن با اسکرول — آرام و کوتاه */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-enter] { animation: enter 0.6s var(--k-ease-standard) both; animation-delay: calc(var(--d, 0) * 60ms); }
    :global(.js) [data-reveal] { opacity: 0; translate: 0 0.75rem; transition: opacity 0.6s var(--k-ease-standard), translate 0.6s var(--k-ease-standard); transition-delay: calc(var(--i, 0) * 50ms); }
    :global(.js) [data-reveal].is-in { opacity: 1; translate: none; }
  }
  @keyframes enter { from { opacity: 0; translate: 0 0.5rem; } }

  /* ───── نوار اطلاعیه ───── */
  .announce {
    display: flex; align-items: center; justify-content: center; gap: var(--k-space-3);
    min-block-size: 2.5rem; padding: var(--k-space-2) var(--gutter);
    border-block-end: 1px solid var(--k-border-secondary);
    background: var(--k-bg-secondary);
    color: var(--k-text-secondary); font-size: var(--k-text-sm); text-decoration: none;
  }
  .announce:hover .announce__more { text-decoration: underline; }
  .announce:focus-visible { outline: 2px solid transparent; box-shadow: inset var(--k-ring-brand); }
  .announce__tag { padding: 0 var(--k-space-2); border: 1px solid var(--k-border-brand); border-radius: var(--k-radius-sm); color: var(--k-text-brand); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .announce__more { color: var(--k-text-brand); font-weight: var(--k-weight-semibold); }
  @media (max-width: 40rem) { .announce__text { display: none; } }

  /* ───── هیرو ───── */
  .hero { position: relative; isolation: isolate; padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem); border-block-end: 1px solid var(--k-border-secondary); }


  /* نمای محصول */
  .product {
    position: relative; margin: 0;
    border: 1px solid var(--k-border-primary);
    border-radius: var(--k-radius-lg);
    background: var(--k-bg-secondary);
    box-shadow: var(--k-shadow-xl);
    overflow: clip;
    text-align: start;
  }
  .product__caption { margin: var(--k-space-4) 0 0; color: var(--k-text-quaternary); font-size: var(--k-text-xs); text-align: center; }
  .product__bar { display: flex; align-items: center; gap: var(--k-space-4); padding: var(--k-space-2) var(--k-space-4); border-block-end: 1px solid var(--k-border-secondary); direction: ltr; }
  .product__dots { display: flex; gap: 6px; }
  .product__dots i { inline-size: 9px; block-size: 9px; border-radius: 50%; background: var(--k-border-primary); }
  .product__url { flex: 1; max-inline-size: 20rem; margin-inline: auto; padding: 0.125rem 0.75rem; border-radius: var(--k-radius-sm); background: var(--k-bg-tertiary); color: var(--k-text-tertiary); font: 0.75rem var(--k-font-mono); text-align: center; }

  .product :global(.app) { display: grid; grid-template-columns: 14rem minmax(0, 1fr); min-block-size: 34rem; background: var(--k-bg-primary); }
  .product :global(.app__nav) { --k-sidenav-width: 100%; }
  .product :global(.app__brand) { font-size: var(--k-text-md); }
  .product :global(.app__me) { display: flex; align-items: center; gap: var(--k-space-2); padding-inline: var(--k-space-2); color: var(--k-text-secondary); font-size: var(--k-text-sm); font-weight: var(--k-weight-medium); }
  .product :global(.app__main) { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: var(--k-space-5); padding: var(--k-space-6); min-inline-size: 0; }
  .product :global(.app__head) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-space-3); }
  .product :global(.app__title) { margin: 0; color: var(--k-text-primary); font-size: var(--k-text-xl); font-weight: var(--k-weight-semibold); }
  .product :global(.app__sub) { margin: 0; color: var(--k-text-tertiary); font-size: var(--k-text-sm); }
  .product :global(.app__actions) { display: flex; align-items: center; gap: var(--k-space-2); }
  .product :global(.app__stats) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .product :global(.k-stat) { --k-stat-padding: var(--k-space-4) var(--k-space-5); --k-stat-value-size: var(--k-text-2xl); gap: var(--k-space-2); }
  .product :global(.spark) { inline-size: 100%; block-size: 2rem; }
  .product :global(.app__card) { border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: var(--k-bg-elevated); box-shadow: var(--k-shadow-xs), var(--k-highlight); overflow: clip; }
  .product :global(.app__card-head) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-space-3); padding: var(--k-space-4) var(--k-space-5); border-block-end: 1px solid var(--k-border-secondary); }
  .product :global(.app__card-title) { margin: 0; color: var(--k-text-primary); font-weight: var(--k-weight-semibold); }
  .product :global(.app__table) { inline-size: 100%; }
  .product :global(.app__cust) { display: inline-flex; align-items: center; gap: var(--k-space-2); color: var(--k-text-primary); font-weight: var(--k-weight-medium); }
  .product :global(.k-chip) { block-size: 1.75rem; font-size: var(--k-text-xs); }

  /* ───── سازگاری ───── */

  /* ───── هیرو ───── */
  .hero { overflow: clip; padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem); }
  .hero__bg {
    position: absolute; inset: 0 0 auto; block-size: 46rem; z-index: -1; pointer-events: none;
    background:
      linear-gradient(var(--k-border-secondary) 1px, transparent 1px) 0 0 / 3.5rem 3.5rem,
      linear-gradient(90deg, var(--k-border-secondary) 1px, transparent 1px) 0 0 / 3.5rem 3.5rem;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(ellipse 55% 65% at 50% 0%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 55% 65% at 50% 0%, #000 20%, transparent 75%);
  }
  .hero__glow {
    position: absolute; inset: -12rem 0 auto; block-size: 40rem; z-index: -1; pointer-events: none;
    background:
      radial-gradient(32rem 18rem at 50% 30%, color-mix(in srgb, var(--k-text-brand) 16%, transparent), transparent 70%),
      radial-gradient(24rem 14rem at 78% 55%, color-mix(in srgb, #3d5ef8 10%, transparent), transparent 70%);
    filter: blur(8px);
  }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero__copy { display: grid; justify-items: start; min-inline-size: 0; }
  .hero__copy > * { max-inline-size: 100%; min-inline-size: 0; }
  .hero__badge {
    display: inline-flex; align-items: center; gap: var(--k-space-2);
    padding: 0.3rem var(--k-space-3) 0.3rem 0.3rem;
    border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-full);
    background: var(--k-bg-primary);
    color: var(--k-text-secondary); font-size: var(--k-text-sm); text-decoration: none;
    transition: border-color var(--k-duration-fast), color var(--k-duration-fast);
  }
  .hero__badge:hover { border-color: var(--k-border-brand); color: var(--k-text-primary); }
  .hero__badge-tag { padding: 0.125rem 0.625rem; border-radius: var(--k-radius-full); background: var(--k-bg-brand); color: var(--k-text-on-brand, #fff); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .hero__title {
    max-inline-size: 16ch;
    margin-block: var(--k-space-6) var(--k-space-5);
    color: var(--k-text-primary);
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    font-weight: var(--k-weight-bold);
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .hero__accent { color: var(--k-text-brand); }
  .hero__lead { inline-size: min(100%, 40rem); max-inline-size: 40rem; margin: 0; color: var(--k-text-tertiary); font-size: var(--k-text-lg); line-height: 1.95; text-wrap: pretty; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: var(--k-space-3); margin-block-start: var(--k-space-7, 1.75rem); }
  .hero__cta { position: relative; overflow: hidden; }
  .hero__cta::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%); translate: 120% 0; pointer-events: none; }
  .hero__install { inline-size: min(100%, 26rem); margin-block-start: var(--k-space-4); text-align: start; }
  .proof { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: var(--k-space-2) var(--k-space-5); margin-block-start: var(--k-space-6); color: var(--k-text-tertiary); font-size: var(--k-text-sm); }
  .proof b { color: var(--k-text-primary); font-weight: var(--k-weight-bold); }
  .proof__gh { display: inline-flex; align-items: center; gap: var(--k-space-2); padding: 0.35rem var(--k-space-3); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-full); background: var(--k-bg-primary); color: inherit; text-decoration: none; transition: border-color var(--k-duration-fast); }
  .proof__gh:hover { border-color: var(--k-border-brand); }
  .proof__gh:focus-visible { outline: 2px solid transparent; box-shadow: var(--k-ring-brand); }
  .proof__gh svg { inline-size: 1rem; block-size: 1rem; color: var(--k-text-primary); }
  .proof__item { display: inline-flex; align-items: center; gap: var(--k-space-2); }
  .proof__item[data-gh-wait] { display: none; }
  .proof__item + .proof__item::before, .proof__gh + .proof__item::before { content: ""; inline-size: 1px; block-size: 1rem; margin-inline-end: var(--k-space-3); background: var(--k-border-primary); }
  .proof__mono { font-family: var(--k-font-mono); font-size: var(--k-text-xs); }
  .proof__dot { inline-size: 7px; block-size: 7px; border-radius: 50%; background: var(--k-text-success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--k-text-success) 22%, transparent); }

  /* نقشهٔ اکوسیستم کنار هیرو */
  .sysmap { border: 1px solid var(--k-border-primary); border-radius: var(--k-radius-xl); background: color-mix(in srgb, var(--k-bg-primary) 88%, transparent); box-shadow: var(--k-shadow-xl); backdrop-filter: blur(8px); overflow: clip; }
  .sysmap__head { display: flex; align-items: center; justify-content: space-between; gap: var(--k-space-3); padding: var(--k-space-4) var(--k-space-5); border-block-end: 1px solid var(--k-border-secondary); }
  .sysmap__title { color: var(--k-text-primary); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); }
  .sysmap__status { display: inline-flex; align-items: center; gap: var(--k-space-2); padding: 0.125rem var(--k-space-2); border-radius: var(--k-radius-full); background: var(--k-bg-success-subtle); color: var(--k-text-success); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .sysmap__list { margin: 0; padding: var(--k-space-2); list-style: none; }
  .sysmap__row { display: grid; grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto; align-items: center; gap: var(--k-space-3); padding: var(--k-space-2_5, 0.625rem) var(--k-space-3); border-radius: var(--k-radius-md); color: inherit; text-decoration: none; transition: background-color var(--k-duration-fast); }
  .sysmap__row:hover { background: var(--k-bg-hover); }
  .sysmap__row:focus-visible { outline: 2px solid transparent; box-shadow: var(--k-ring-brand); }
  .sysmap__row code { color: var(--k-text-primary); font-size: 0.8125rem; font-weight: var(--k-weight-semibold); white-space: nowrap; }
  .sysmap__role { overflow: hidden; color: var(--k-text-tertiary); font-size: var(--k-text-xs); white-space: nowrap; text-overflow: ellipsis; }
  .sysmap__ver { padding: 0 var(--k-space-2); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-sm); color: var(--k-text-tertiary); font: 0.6875rem var(--k-font-mono); }
  .sysmap__foot { padding: var(--k-space-3) var(--k-space-5); border-block-start: 1px solid var(--k-border-secondary); background: var(--k-bg-secondary); color: var(--k-text-tertiary); font-size: var(--k-text-xs); }
  .sysmap__foot bdi { font-family: var(--k-font-mono); }

  /* نوار استانداردها */
  .standards { padding-block: clamp(2.5rem, 5vw, 3.5rem); border-block-end: 1px solid var(--k-border-secondary); }
  .standards__title { margin: 0 0 var(--k-space-5); color: var(--k-text-tertiary); font-size: var(--k-text-sm); font-weight: var(--k-weight-medium); text-align: center; }
  .standards__list {
    position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; overflow: clip;
    border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl);
    background: linear-gradient(180deg, var(--k-bg-secondary), var(--k-bg-primary));
    box-shadow: var(--k-shadow-xs), var(--k-highlight, none);
  }
  /* خط نورانی بالای پنل */
  .standards__list::before { content: ""; position: absolute; inset: 0 15% auto; block-size: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--k-text-brand) 60%, transparent), transparent); }
  .standards__list li { display: grid; justify-items: center; align-content: start; gap: var(--k-space-1); padding: var(--k-space-6) var(--k-space-3) var(--k-space-5); min-inline-size: 0; text-align: center; transition: background-color var(--k-duration-fast); }
  .standards__list li + li { border-inline-start: 1px solid var(--k-border-secondary); }
  .standards__list li:hover { background: color-mix(in srgb, var(--k-text-brand) 5%, transparent); }
  .standards__icon { display: grid; flex: none; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; margin-block-end: var(--k-space-2); border: 1px solid color-mix(in srgb, var(--k-text-brand) 30%, var(--k-border-secondary)); border-radius: var(--k-radius-lg); background: var(--k-bg-brand-subtle); color: var(--k-text-brand); transition: transform var(--k-duration-normal) var(--k-ease-standard); }
  .standards__list li:hover .standards__icon { transform: translateY(-2px); }
  .standards__icon svg { inline-size: 1.25rem; block-size: 1.25rem; }
  .standards__list li > span:last-child { display: grid; gap: 2px; max-inline-size: 100%; }
  .standards__list b { display: block; color: var(--k-text-primary); font-size: var(--k-text-md); font-weight: var(--k-weight-bold); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .standards__list small { display: block; color: var(--k-text-tertiary); font-size: var(--k-text-xs); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: clamp(3rem, 6vw, 4.5rem) 0 0; border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: var(--k-bg-primary); box-shadow: var(--k-shadow-xs); }
  .metrics__item { padding: var(--k-space-5) var(--k-space-6); }
  .metrics__item + .metrics__item { border-inline-start: 1px solid var(--k-border-secondary); }
  .metrics dt { color: var(--k-text-tertiary); font-size: var(--k-text-sm); }
  .metrics dd { display: flex; align-items: baseline; gap: var(--k-space-2); margin: var(--k-space-1) 0 0; color: var(--k-text-primary); font-size: clamp(var(--k-text-2xl), 3vw, 2.25rem); font-weight: var(--k-weight-bold); letter-spacing: -0.02em; }
  .metrics small { color: var(--k-text-success); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }

  .stage { position: relative; margin-block-start: clamp(2.5rem, 5vw, 3.5rem); perspective: 1800px; }
  .product { border-color: var(--k-border-primary); box-shadow: var(--k-shadow-2xl, var(--k-shadow-xl)); transform-style: preserve-3d; transition: transform 0.4s var(--k-ease-standard), box-shadow 0.4s; will-change: transform; }
  .chips { position: absolute; inset: 0; z-index: 3; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .chip { position: absolute; display: flex; align-items: center; gap: var(--k-space-2); padding: var(--k-space-2) var(--k-space-3); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-lg); background: var(--k-bg-elevated); box-shadow: var(--k-shadow-lg); text-align: start; white-space: nowrap; }
  .chip small { display: block; color: var(--k-text-tertiary); font-size: 0.6875rem; }
  .chip b { display: block; color: var(--k-text-primary); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); }
  .chip__icon { display: grid; place-items: center; inline-size: 2rem; block-size: 2rem; border-radius: var(--k-radius-md); background: var(--k-bg-brand-subtle, var(--k-bg-secondary)); color: var(--k-text-brand); }
  .chip--1 { inset-block-start: -1.5rem; inset-inline-start: -1.5rem; }
  .chip--2 { inset-block-start: 22%; inset-inline-end: -2.25rem; }
  .chip--3 { inset-block-end: 20%; inset-inline-start: -2.5rem; }
  .chip--4 { inset-block-end: -1.25rem; inset-inline-end: 12%; }

  /* نوار پیشرفت خواندن */
  .scroll-progress { position: fixed; inset: 0 0 auto; z-index: 60; block-size: 2px; background: var(--k-text-brand); transform-origin: 100% 50%; scale: 0 1; pointer-events: none; }


  /* کارت‌های نورافکن */
  :global(.spot) { position: relative; }
  :global(.spot)::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(22rem circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--k-text-brand) 9%, transparent), transparent 60%); }
  :global(.spot):hover::after { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] { filter: blur(4px); transition: opacity 0.7s var(--k-ease-standard), translate 0.7s var(--k-ease-standard), filter 0.7s var(--k-ease-standard); }
    :global(.js) [data-reveal].is-in { filter: none; }
    .hero__cta:hover::after { translate: -120% 0; transition: translate 0.8s var(--k-ease-standard); }
    .chip { animation: float 6s ease-in-out infinite; }
    .chip--2 { animation-delay: -1.5s; } .chip--3 { animation-delay: -3s; } .chip--4 { animation-delay: -4.5s; }
    .iconset__grid.is-swapping .iconset__glyph:not([hidden]) { animation: pop 0.45s var(--k-ease-standard) both; animation-delay: calc(var(--i, 0) * 14ms); }
    .iconset__cell:hover :global(svg) { scale: 1.15; }
    .iconset__glyph :global(svg) { transition: scale 0.2s var(--k-ease-standard); }
    @supports (animation-timeline: scroll()) {
      .scroll-progress { animation: progress linear both; animation-timeline: scroll(root); }
    }
  }
  @keyframes float { 50% { translate: 0 -0.5rem; } }
  @keyframes pop { from { opacity: 0; scale: 0.6; } }
  @keyframes progress { to { scale: 1 1; } }
  @media (max-width: 64rem) {
    .chip--2, .chip--3 { display: none; }
    .chip--1 { inset-inline-start: 0.5rem; }
    .chip--4 { inset-inline-end: 0.5rem; }
  }
  @media (max-width: 40rem) {
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .metrics__item:nth-child(3) { border-inline-start: 0; }
    .metrics__item:nth-child(n + 3) { border-block-start: 1px solid var(--k-border-secondary); }
    .chips { display: none; }
  }


  /* ───── بخش‌ها ───── */
  .band { padding-block: clamp(4.5rem, 9vw, 7rem); border-block-end: 1px solid var(--k-border-secondary); }
  .band--alt { background: var(--k-bg-secondary); }

  /* بخش آیکون‌ها */
  .iconset { overflow: hidden; border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: var(--k-bg-elevated); }
  .iconset__styles { display: flex; flex-wrap: wrap; gap: var(--k-space-1); padding: var(--k-space-3); border-block-end: 1px solid var(--k-border-secondary); }
  .iconset__style { padding: var(--k-space-1) var(--k-space-3); border: 1px solid transparent; border-radius: var(--k-radius-full); background: none; color: var(--k-text-secondary); font: inherit; font-size: var(--k-text-sm); cursor: pointer; }
  .iconset__style:hover { color: var(--k-text-primary); }
  .iconset__style[aria-pressed="true"] { border-color: var(--k-border-primary); background: var(--k-bg-primary); box-shadow: var(--k-shadow-xs); color: var(--k-text-primary); }
  .iconset__style:focus-visible { outline: 2px solid var(--k-border-brand); outline-offset: 2px; }
  .iconset__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(3.5rem, 1fr)); margin: 0; padding: var(--k-space-3); list-style: none; }
  .iconset__cell { display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--k-radius-lg); color: var(--k-text-primary); transition: background-color var(--k-duration-fast), color var(--k-duration-fast); }
  .iconset__cell:hover { background: var(--k-bg-hover); color: var(--k-text-brand); }
  .iconset__cell:focus-visible { outline: 2px solid var(--k-border-brand); outline-offset: -2px; }
  .iconset__glyph { display: grid; }
  .iconset__glyph[hidden] { display: none; }
  .iconset__glyph :global(svg) { inline-size: 1.5rem; block-size: 1.5rem; }
  .iconset__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-space-4); padding: var(--k-space-4) var(--k-space-5); border-block-start: 1px solid var(--k-border-secondary); }
  .iconset__stats { display: flex; gap: var(--k-space-6); margin: 0; }
  .iconset__stats dt { color: var(--k-text-tertiary); font-size: var(--k-text-xs); }
  .iconset__stats dd { margin: 0; color: var(--k-text-primary); font-size: var(--k-text-lg); font-weight: var(--k-weight-semibold); }
  .iconset__links { display: flex; flex-wrap: wrap; gap: var(--k-space-5); }
  .band__head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--k-space-4) clamp(2rem, 6vw, 5rem); align-items: end; margin-block-end: clamp(2.5rem, 5vw, 3.5rem); }
  .band__head h2 { margin: var(--k-space-3) 0 0; color: var(--k-text-primary); font-size: clamp(var(--k-text-2xl), 3.4vw, 2.5rem); font-weight: var(--k-weight-bold); line-height: 1.35; text-wrap: balance; }
  .band__lead { margin: 0; color: var(--k-text-tertiary); line-height: 1.95; text-wrap: pretty; }
  .kicker { display: flex; align-items: center; gap: var(--k-space-2); margin: 0; color: var(--k-text-brand); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); }
  .kicker__n { padding-inline-end: var(--k-space-2); border-inline-end: 1px solid var(--k-border-primary); color: var(--k-text-quaternary); font-family: var(--k-font-mono); font-size: var(--k-text-xs); }

  /* ───── معماری ───── */
  .arch { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--k-space-6); }
  .arch__stack { display: grid; gap: var(--k-space-3); margin: 0; padding: 0; list-style: none; }
  .arch__layer { position: relative; display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); align-items: stretch; gap: var(--k-space-4); }
  /* خط اتصال بین لایه‌ها */
  .arch__layer:not(:last-child)::after {
    content: ""; position: absolute; inset-inline-start: calc(5.5rem + var(--k-space-4) + 1.5rem); inset-block-end: calc(var(--k-space-3) * -1);
    inline-size: 1px; block-size: var(--k-space-3); background: var(--k-border-primary);
  }
  .arch__tier { display: grid; place-items: center start; color: var(--k-text-quaternary); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .pkg {
    display: grid; gap: var(--k-space-1_5, 0.375rem); padding: var(--k-space-4) var(--k-space-5);
    border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-md);
    background: var(--k-bg-secondary); color: inherit; text-decoration: none;
    transition: border-color var(--k-duration-fast), background-color var(--k-duration-fast);
  }
  .pkg:hover { border-color: var(--k-border-brand); background: var(--k-bg-elevated); }
  .pkg:focus-visible { outline: 2px solid transparent; box-shadow: var(--k-ring-brand); }
  .pkg__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-space-2); }
  .pkg__name { color: var(--k-text-primary); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); }
  .pkg__kind { padding: 0 var(--k-space-2); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-sm); color: var(--k-text-tertiary); font-size: var(--k-text-xs); }
  .pkg__text { color: var(--k-text-tertiary); font-size: var(--k-text-sm); line-height: 1.8; }
  .arch__modules { display: grid; align-content: start; gap: var(--k-space-3); padding: var(--k-space-5); border: 1px dashed var(--k-border-primary); border-radius: var(--k-radius-lg); }
  .arch__label { margin: 0 0 var(--k-space-1); color: var(--k-text-quaternary); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .arch__modules ul { display: grid; gap: var(--k-space-3); margin: 0; padding: 0; list-style: none; }
  .pkg--module { background: var(--k-bg-primary); }

  /* ───── قابلیت‌ها: بنتو ───── */
  .band__head--center { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
  .band__head--center .kicker { justify-content: center; }
  .band__head--center .band__lead { max-inline-size: 42rem; }
  .bento { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-flow: row dense; gap: var(--k-space-4); }
  .tile {
    display: grid; grid-template-rows: auto 1fr; gap: var(--k-space-5); min-inline-size: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl);
    background: var(--k-bg-primary); box-shadow: var(--k-shadow-xs), var(--k-highlight, none);
    transition: border-color var(--k-duration-fast);
  }
  .tile:hover { border-color: var(--k-border-primary); }
  .tile__label { margin: 0 0 var(--k-space-2); color: var(--k-text-brand); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .tile h3 { margin: 0 0 var(--k-space-2); color: var(--k-text-primary); font-size: var(--k-text-lg); font-weight: var(--k-weight-semibold); line-height: 1.55; text-wrap: balance; }
  .tile__text > p:not(.tile__label) { margin: 0 0 var(--k-space-4); color: var(--k-text-tertiary); font-size: var(--k-text-sm); line-height: 1.9; text-wrap: pretty; }
  .tile__demo {
    display: grid; place-items: center; min-block-size: 11rem; padding: var(--k-space-5);
    border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-lg);
    background: radial-gradient(circle at 1px 1px, var(--k-border-secondary) 1px, transparent 0) 0 0 / 1rem 1rem, var(--k-bg-secondary);
  }
  /* چیدمان: تقویم بلند در یک ستون، بقیه دورش */
  .tile--calendar { grid-column: span 5; grid-row: span 2; }
  .tile--persian { grid-column: span 7; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); grid-template-rows: none; align-items: center; }
  .tile--rtl { grid-column: span 7; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); grid-template-rows: none; align-items: center; }
  .tile--a11y { grid-column: span 5; }
  .tile--theme { grid-column: span 7; }
  .tile__cal :global(.bento-cal) { --k-calendar-day-size: 2.125rem; font-size: var(--k-text-xs); }
  .tile__demo :global(.bento-dir) { display: grid; gap: var(--k-space-3); justify-items: start; inline-size: min(100%, 20rem); }
  .tile__demo :global(.bento-dir__card) { display: grid; gap: var(--k-space-3); inline-size: 100%; padding: var(--k-space-4); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-lg); background: var(--k-bg-elevated); }
  .tile--theme .swatches { margin-block-end: var(--k-space-4); }
  .tile--theme .tile__demo { padding: 0; border: 0; background: none; }

  .audit { display: grid; gap: var(--k-space-3); inline-size: min(100%, 20rem); padding: var(--k-space-5); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-lg); background: var(--k-bg-elevated); box-shadow: var(--k-shadow-sm); }
  .audit__score { display: flex; align-items: baseline; gap: var(--k-space-1); }
  .audit__score strong { color: var(--k-text-primary); font-size: var(--k-text-4xl); font-weight: var(--k-weight-bold); line-height: 1; }
  .audit__score span { color: var(--k-text-tertiary); font-size: var(--k-text-lg); }
  .audit__label { margin: 0 !important; color: var(--k-text-tertiary); font-size: var(--k-text-xs) !important; }
  .audit__bar { block-size: 0.375rem; border-radius: var(--k-radius-full); background: var(--k-bg-tertiary); overflow: hidden; }
  .audit__bar span { display: block; block-size: 100%; inline-size: 100%; background: var(--k-text-success); }
  .audit__rows { display: grid; gap: var(--k-space-2); margin: var(--k-space-2) 0 0; padding: var(--k-space-3) 0 0; border-block-start: 1px solid var(--k-border-secondary); list-style: none; font-size: var(--k-text-sm); }
  .audit__rows li { display: flex; justify-content: space-between; color: var(--k-text-tertiary); }
  .audit__rows b { color: var(--k-text-success); font-weight: var(--k-weight-semibold); }

  .swatches { display: flex; flex-wrap: wrap; gap: var(--k-space-2); margin-block-end: var(--k-space-5); }
  .swatch {
    display: inline-flex; align-items: center; gap: var(--k-space-2); min-block-size: 2.25rem; padding-inline: var(--k-space-3);
    border: 1px solid var(--k-border-primary); border-radius: var(--k-radius-md); background: var(--k-bg-primary);
    color: var(--k-text-secondary); font: inherit; font-size: var(--k-text-sm); cursor: pointer; box-shadow: var(--k-shadow-xs);
    transition: border-color var(--k-duration-fast), color var(--k-duration-fast);
  }
  .swatch:hover { color: var(--k-text-primary); }
  .swatch:focus-visible { outline: 2px solid transparent; box-shadow: var(--k-ring-brand); }
  .swatch[aria-pressed="true"] { border-color: var(--k-border-brand); color: var(--k-text-primary); }
  .swatch__dot { inline-size: 0.875rem; block-size: 0.875rem; border-radius: 50%; background: var(--sw); }
  .snippet { inline-size: 100%; margin: 0; padding: var(--k-space-5); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-md); background: var(--k-bg-primary); color: var(--k-text-secondary); font-size: 0.8125rem; line-height: 1.9; text-align: left; overflow-x: auto; }
  .tok-k { color: var(--k-text-brand); }
  .tok-s { color: var(--k-text-warning); transition: color var(--k-duration-normal); }
  .tok-n { color: var(--k-text-info); }

  /* ───── هوش مصنوعی ───── */
  .aiband__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .aiband__copy h2 { margin: var(--k-space-3) 0 var(--k-space-4); color: var(--k-text-primary); font-size: clamp(var(--k-text-2xl), 3.4vw, 2.5rem); font-weight: var(--k-weight-bold); line-height: 1.35; text-wrap: balance; }
  .aiband__points { display: grid; gap: var(--k-space-2); margin: var(--k-space-5) 0 0; padding: 0; list-style: none; color: var(--k-text-secondary); font-size: var(--k-text-sm); }
  .aiband__points li { display: flex; align-items: center; gap: var(--k-space-2); }
  .aiband__points span { display: grid; place-items: center; inline-size: 1.25rem; block-size: 1.25rem; border-radius: 50%; background: var(--k-bg-success-subtle); color: var(--k-text-success); }
  .aiband__cmd { display: flex; align-items: center; gap: var(--k-space-2); margin: var(--k-space-6) 0 var(--k-space-4); padding: var(--k-space-1) var(--k-space-1) var(--k-space-1) var(--k-space-4); border: 1px solid var(--k-border-primary); border-radius: var(--k-radius-md); background: var(--k-bg-primary); box-shadow: var(--k-shadow-xs); font: 0.8125rem var(--k-font-mono); }
  .aiband__cmd > span { color: var(--k-text-brand); }
  .aiband__cmd code { flex: 1; min-inline-size: 0; overflow-x: auto; color: var(--k-text-primary); white-space: nowrap; scrollbar-width: none; }
  .aiband__copy-btn { flex: none; }
  .aiband__copy-btn[data-copied] { color: var(--k-text-success); }
  .aiband__chat { overflow: clip; border: 1px solid var(--k-border-primary); border-radius: var(--k-radius-xl); background: var(--k-bg-primary); box-shadow: var(--k-shadow-xl); }
