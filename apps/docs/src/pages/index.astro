  }
</style>

<script>
  import { createTheme } from "@kashi-ui/tokens";

  // ظاهر شدن با اسکرول
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("is-in");
        io.unobserve(e.target);
      }
    },
    { rootMargin: "0px 0px -8% 0px" },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

  // تغییر رنگ برند کل صفحه
  const style = document.createElement("style");
  document.head.append(style);
  const code = document.querySelector("[data-brand-code]");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".swatch");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const value = btn.dataset.brand;
      style.textContent = value ? createTheme({ brand: value }) : "";
      if (code) code.textContent = `"${value || "#0fa89b"}"`;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    }),
  );
</script>

<script>
  // تعویض سبک در بخش آیکون‌ها؛ همهٔ سبک‌ها از پیش رندر شده‌اند
  const iconStyles = document.querySelectorAll<HTMLButtonElement>(".iconset__style");
  iconStyles.forEach((btn) => btn.addEventListener("click", () => {
    iconStyles.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    document.querySelectorAll<HTMLElement>(".iconset__glyph").forEach((g) => { g.hidden = g.dataset.v !== btn.dataset.variant; });
  }));
</script>

<script>
  // موشن هیرو و ریزتعامل‌ها؛ با prefers-reduced-motion همه خاموش می‌شوند
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(pointer: fine)").matches;
  const faNum = (n: number) => String(n).replace(/\d/g, (d) => "۰۱۲۳۴۵۶۷۸۹"[+d]);

  // شمارش عددها وقتی دیده می‌شوند
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const countIo = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      countIo.unobserve(e.target);
      const el = e.target as HTMLElement;
      const end = Number(el.dataset.count);
      if (calm) continue;
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 1400);
        el.textContent = faNum(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  }, { threshold: 0.6 });
  counters.forEach((c) => countIo.observe(c));

  if (!calm && fine) {
    // نمای محصول با کج شدن سه‌بعدی کم
    const tilt = document.querySelector<HTMLElement>("[data-tilt]");
    tilt?.addEventListener("pointermove", (e) => {
      const r = tilt.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.transform = `rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg)`;
    });
    tilt?.addEventListener("pointerleave", () => { tilt.style.transform = ""; });

    // نورافکن روی کارت‌ها
    document.querySelectorAll<HTMLElement>(".quality__item, .step, .vs, .arch, .explorer, .iconset, .author, .support, .metrics").forEach((card) => {
      card.classList.add("spot");
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - r.left}px`);
        card.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }

  // موج کوچک هنگام تعویض سبک آیکون‌ها
  const iconGrid = document.querySelector<HTMLElement>(".iconset__grid");
  document.querySelectorAll(".iconset__style").forEach((b) => b.addEventListener("click", () => {
    if (!iconGrid) return;
    iconGrid.classList.remove("is-swapping");
    void iconGrid.offsetWidth;
    iconGrid.classList.add("is-swapping");
  }));
</script>
