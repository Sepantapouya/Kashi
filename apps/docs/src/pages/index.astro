---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Install from "../components/Install.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import HeroApp from "../components/HeroApp";
import { BentoCalendar, BentoDirection, BentoPlate } from "../components/HomeBento";
import { nav } from "../data/nav";
import { author } from "../data/author";
import * as tokens from "@kashi-ui/tokens";
import pkg from "@kashi-ui/react/package.json";

const fa = (n: number | string) => String(n).replace(/\d/g, (d) => "۰۱۲۳۴۵۶۷۸۹"[+d]);
const count = (o: object): number => Object.values(o).reduce((n: number, v) => n + (typeof v === "object" ? count(v) : 1), 0);
const { themes, ...primitives } = tokens as Record<string, any>;
delete primitives.createTheme;
delete primitives.brandScale;
const tokenCount = count(primitives) + Object.keys(themes.dark).length;
const componentCount = nav
  .filter((g) => g.title === "کامپوننت‌ها" || g.title === "فارسی")
  .flatMap((g) => g.items)
  .filter((i) => !i.href.includes("utilities") && !i.href.includes("bank-logos")).length;
const newItems = nav.flatMap((g) => g.items).filter((i) => i.badge);
const version = fa(pkg.version.split(".").slice(0, 2).join("٫"));

const metrics = [
  { value: componentCount, label: "کامپوننت آماده" },
  { value: tokenCount, label: "توکن طراحی" },
  { value: 82, label: "جفت‌رنگ با کنتراست AA در هر بیلد" },
  { value: 0, label: "وابستگی زمان اجرا در هستهٔ CSS" },
];

const marquee = [
  "تقویم و بازهٔ تاریخ شمسی", "کد ملی با رقم کنترل", "شماره کارت و لوگوی ۳۱ بانک", "شبا", "موبایل و اپراتور", "تلفن ثابت و استان",
  "پلاک خودرو", "کد پستی", "مبلغ به حروف", "ساعت ۲۴ساعته", "یکدست‌سازی ي و ك", "ارقام فارسی", "شمارش معکوس",
];

const steps = [
  { n: "۰۱", title: "نصب", text: "دو پکیج: کامپوننت‌های React و استایل‌ها. فونت وزیرمتن همراه است.", code: "npm i @kashi-ui/react @kashi-ui/css" },
  { n: "۰۲", title: "یک خط CSS", text: "استایل‌ها در Cascade Layer هستند، پس CSS خودتان همیشه برنده است.", code: 'import "@kashi-ui/css";' },
  { n: "۰۳", title: "بسازید", text: "برچسب‌ها، پیام‌ها و ارقام از پیش فارسی‌اند؛ دسترس‌پذیری هم.", code: '<DatePicker label="تاریخ تولد" />' },
];

const brands = [
  { name: "فیروزه‌ای", value: "" },
  { name: "لاجوردی", value: "#3d5ef8" },
  { name: "زعفرانی", value: "#dd5e02" },
  { name: "اناری", value: "#e51d2a" },
  { name: "بنفش", value: "#7c3aed" },
];

const stacks = ["React", "HTML", "Vue", "Svelte", "Angular", "Astro"];
---
<Base>
  <Header />
  <main id="main" tabindex="-1" class="home">
    <!-- ───── هیرو ───── -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__bg" aria-hidden="true">
        <span class="aurora aurora--a"></span>
        <span class="aurora aurora--b"></span>
        <span class="aurora aurora--c"></span>
        <svg class="hero__pattern">
          <defs>
            <pattern id="shamseh" width="72" height="72" patternUnits="userSpaceOnUse">
              <path transform="translate(20 20)" d="M16.00 1.00 L11.61 5.39 L5.39 5.39 L5.39 11.61 L1.00 16.00 L5.39 20.39 L5.39 26.61 L11.61 26.61 L16.00 31.00 L20.39 26.61 L26.61 26.61 L26.61 20.39 L31.00 16.00 L26.61 11.61 L26.61 5.39 L20.39 5.39Z" />
              <path d="M0 0 L20 20 M72 0 L52 20 M0 72 L20 52 M72 72 L52 52" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#shamseh)" />
        </svg>
      </div>

      <div class="hero__inner">
        <a class="pill" href={newItems[0]?.href ?? "/docs/"} data-enter style="--d: 0">
          <span class="pill__tag">تازه</span>
          <span>{fa(newItems.length)} کامپوننت تازه در نسخهٔ {version}</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pill__arrow"><path d="m12 5-5 5 5 5" /></svg>
        </a>
        <h1 id="hero-title" class="hero__title" data-enter style="--d: 1">
          زیرساخت طراحی{" "}<br />
          <span class="gradient-text">محصولات فارسی</span>
        </h1>
        <p class="hero__lead" data-enter style="--d: 2">
          کامپوننت‌ها، توکن‌ها و الگوهای راست‌به‌چپ و دسترس‌پذیر، با ابزارهایی که فقط یک محصول فارسی لازم دارد: تقویم شمسی، کد ملی، شبا، پلاک و بیشتر.
        </p>
        <div class="hero__actions" data-enter style="--d: 3">
          <a class="k-btn k-btn--primary k-btn--xl" href="/docs/">
            شروع کنید
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-k-mirror=""><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
          </a>
          <a class="k-btn k-btn--secondary k-btn--xl" href="/docs/components/">مرور کامپوننت‌ها</a>
        </div>
        <div class="hero__install" data-enter style="--d: 4"><Install /></div>
      </div>

      <!-- نمای محصول: با اسکرول از حالت سه‌بعدی صاف می‌شود -->
      <div class="product" data-enter style="--d: 5">
        <div class="product__glow" aria-hidden="true"></div>
        <figure class="product__frame" aria-label="نمونهٔ پنل مدیریت ساخته‌شده با کاشی">
          <div class="product__bar" aria-hidden="true">
            <span class="product__dots"><i></i><i></i><i></i></span>
            <span class="product__url" dir="ltr">naroon.shop/dashboard</span>
          </div>
          <HeroApp client:visible />
        </figure>
      </div>
    </section>

    <!-- ───── نوار قابلیت‌های فارسی ───── -->
    <section class="marquee" aria-label="قابلیت‌های فارسی">
      <p class="marquee__label">ساخته‌شده برای فارسی، نه ترجمه‌شده</p>
      <div class="marquee__track">
        <ul class="marquee__list" role="list">
          {marquee.map((m) => <li><span class="marquee__dot" aria-hidden="true"></span>{m}</li>)}
        </ul>
        <ul class="marquee__list" aria-hidden="true">
          {marquee.map((m) => <li><span class="marquee__dot"></span>{m}</li>)}
        </ul>
      </div>
    </section>

    <!-- ───── اعداد ───── -->
    <section class="metrics" aria-label="کاشی در یک نگاه">
      <dl class="metrics__grid">
        {metrics.map((m, i) => (
          <div class="metric" data-reveal style={`--i: ${i}`}>
            <dt>{m.label}</dt>
            <dd data-count={m.value}>{fa(m.value)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ───── چرا کاشی (bento) ───── -->
    <section class="section" aria-labelledby="why-title">
      <header class="section__head" data-reveal>
        <p class="eyebrow">چرا کاشی</p>
        <h2 id="why-title">هر چیزی که یک محصول فارسی لازم دارد،{" "}<br /><span class="muted">از روز اول.</span></h2>
      </header>

      <div class="bento">
        <article class="tile tile--wide" data-reveal data-spot style="--i: 0">
          <div class="tile__text">
            <p class="tile__kicker">فارسی از پایه</p>
            <h3>پلاک، شبا، کد ملی؛ آماده و معتبرسنجی‌شده</h3>
            <p>نه فقط ترجمهٔ برچسب‌ها: ورودی‌هایی که ساختار داده‌های ایرانی را می‌شناسند، ارقام فارسی و انگلیسی را می‌پذیرند و خطا را به زبان کاربر می‌گویند.</p>
            <a class="tile__link" href="/docs/persian/plate/">پلاک خودرو <span aria-hidden="true">←</span></a>
          </div>
          <div class="tile__demo tile__demo--center"><BentoPlate client:visible /></div>
        </article>

        <article class="tile" data-reveal data-spot style="--i: 1">
          <div class="tile__text">
            <p class="tile__kicker">تقویم جلالی</p>
            <h3>تاریخ و بازهٔ شمسی</h3>
            <p>بدون کتابخانهٔ جانبی؛ تبدیل دقیق برای سال‌های ۱۳۰۰ تا ۱۵۰۰.</p>
          </div>
          <div class="tile__demo tile__demo--cal"><BentoCalendar client:only="react" /></div>
        </article>

        <article class="tile" data-reveal data-spot style="--i: 2">
          <div class="tile__text">
            <p class="tile__kicker">راست‌به‌چپ</p>
            <h3>یک کد، هر دو جهت</h3>
            <p>همهٔ استایل‌ها با Logical Properties؛ جهت را عوض کنید و ببینید.</p>
          </div>
          <div class="tile__demo"><BentoDirection client:visible /></div>
        </article>

        <article class="tile" data-reveal data-spot style="--i: 3">
          <div class="tile__text">
            <p class="tile__kicker">دسترس‌پذیری</p>
            <h3>شرط بیلد، نه وعده</h3>
            <p>کنتراست همهٔ جفت‌رنگ‌ها در هر دو تم بررسی می‌شود؛ بیلد ناموفق منتشر نمی‌شود.</p>
          </div>
          <div class="tile__demo tile__demo--center">
            <div class="ring" role="img" aria-label="۸۲ از ۸۲ جفت‌رنگ با کنتراست AA">
              <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" class="ring__track" /><circle cx="60" cy="60" r="52" class="ring__fill" pathLength="100" /></svg>
              <span class="ring__value" aria-hidden="true">{fa(82)}<small>/{fa(82)}</small></span>
              <span class="ring__label" aria-hidden="true">WCAG 2.2 AA</span>
            </div>
          </div>
        </article>

        <article class="tile" data-reveal data-spot style="--i: 4">
          <div class="tile__text">
            <p class="tile__kicker">مستقل از فریم‌ورک</p>
            <h3>CSS خالص در هسته</h3>
            <p>React امروز آماده است؛ همان کلاس‌ها در هر پشته‌ای کار می‌کنند.</p>
          </div>
          <ul class="stacks" role="list">
            {stacks.map((s) => <li dir="ltr">{s}</li>)}
          </ul>
        </article>
        <article class="tile tile--full tile--theme" data-reveal data-spot style="--i: 5">
          <div class="tile__text">
            <p class="tile__kicker">تم‌پذیری</p>
            <h3>برند شما، در یک خط کد</h3>
            <p>یک رنگ بدهید؛ کاشی طیف یازده‌پله‌ای را می‌سازد و همهٔ کامپوننت‌ها هماهنگ می‌شوند. همین‌جا امتحان کنید:</p>
            <div class="swatches" role="group" aria-label="رنگ برند">
              {brands.map((b, i) => (
                <button type="button" class="swatch" data-brand={b.value} aria-pressed={i === 0 ? "true" : "false"} style={`--sw: ${b.value || "var(--k-firoozeh-600)"}`}>
                  <span class="swatch__dot" aria-hidden="true"></span>{b.name}
                </button>
              ))}
            </div>
          </div>
          <pre class="snippet"><code><span class="tok-k">import</span> {"{ createTheme }"} <span class="tok-k">from</span> <span class="tok-s">"@kashi-ui/tokens"</span>;

<span class="tok-k">const</span> css = createTheme({"{"}
  brand: <span class="tok-s" data-brand-code>"#0fa89b"</span>,
  radius: <span class="tok-n">1.5</span>,
  density: <span class="tok-n">0.875</span>,
{"}"});</code></pre>
        </article>

      </div>
    </section>

    <!-- ───── سه قدم ───── -->
    <section class="section" aria-labelledby="steps-title">
      <header class="section__head" data-reveal>
        <p class="eyebrow">شروع</p>
        <h2 id="steps-title">سه قدم تا اولین صفحه</h2>
      </header>
      <ol class="steps" role="list">
        {steps.map((s, i) => (
          <li class="step" data-reveal style={`--i: ${i}`}>
            <span class="step__n" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <code class="step__code">{s.code}</code>
          </li>
        ))}
      </ol>
    </section>

    <!-- ───── سازنده ───── -->
    <section class="section" aria-labelledby="author-title">
      <div class="author" data-reveal data-spot>
        <img class="author__photo" src={author.photo} alt={`عکس ${author.name}`} width="400" height="400" loading="lazy" decoding="async" />
        <div class="author__body">
          <p class="eyebrow">سازنده</p>
          <h2 id="author-title" class="author__name">ساخته‌شده توسط {author.name}</h2>
          <p class="author__role">{author.role}</p>
          <p class="author__bio">{author.bio} کاشی را ساخت تا تیم‌های فارسی‌زبان به ابزار طراحی‌ای هم‌سطح با بهترین دیزاین‌سیستم‌های دنیا دسترسی داشته باشند.</p>
          <ul class="author__links" role="list">
            {author.links.map((l) => (
              <li><a class="k-btn k-btn--secondary k-btn--sm" href={l.href} target="_blank" rel="noopener">{l.label}<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ───── دعوت به عمل ───── -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="cta__mark" aria-hidden="true"><Logo size={56} /></div>
      <h2 id="cta-title" data-reveal>محصول فارسی بعدی‌تان را<br /><span class="gradient-text">با کاشی بسازید.</span></h2>
      <p data-reveal>رایگان و متن‌باز با لایسنس MIT. مستندات کامل برای هر کامپوننت، با نمونهٔ React و HTML.</p>
      <div class="cta__actions" data-reveal>
        <a class="k-btn k-btn--primary k-btn--lg" href="/docs/installation/">راهنمای نصب</a>
        <a class="k-btn k-btn--secondary k-btn--lg" href={author.repo} target="_blank" rel="noopener">ستاره در GitHub<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .home { --max: 76rem; overflow-x: clip; }
  .eyebrow { margin: 0; color: var(--k-text-brand); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); }
  .muted { color: var(--k-text-quaternary); }
  .gradient-text {
    background: linear-gradient(100deg, var(--k-brand-300), var(--k-brand-500) 45%, var(--k-lajvard-400));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  [data-theme="light"] .gradient-text { background-image: linear-gradient(100deg, var(--k-brand-600), var(--k-brand-700) 45%, var(--k-lajvard-600)); }

  /* ───── ورود و ظاهر شدن با اسکرول (فقط وقتی JS هست و کاربر حرکت را کم نکرده) ───── */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-enter] { animation: enter 0.9s var(--k-ease-standard) both; animation-delay: calc(var(--d, 0) * 90ms + 80ms); }
    :global(.js) [data-reveal] { opacity: 0; translate: 0 1.25rem; transition: opacity 0.8s var(--k-ease-standard), translate 0.8s var(--k-ease-standard); transition-delay: calc(var(--i, 0) * 70ms); }
    :global(.js) [data-reveal].is-in { opacity: 1; translate: none; }
  }
  @keyframes enter { from { opacity: 0; translate: 0 1rem; filter: blur(6px); } }

  /* ───── هیرو ───── */
  .hero { position: relative; isolation: isolate; padding: clamp(4rem, 9vw, 7rem) var(--gutter) 0; text-align: center; }
  .hero__bg { position: absolute; inset: 0 0 auto; block-size: 52rem; z-index: -1; overflow: hidden; pointer-events: none; }
  .aurora { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.35; }
  .aurora--a { inline-size: 38rem; block-size: 24rem; inset-block-start: -8rem; inset-inline-start: 50%; translate: 50% 0; background: var(--k-brand-500); animation: drift-a 18s ease-in-out infinite alternate; }
  .aurora--b { inline-size: 26rem; block-size: 20rem; inset-block-start: 4rem; inset-inline-start: 18%; background: var(--k-lajvard-500); opacity: 0.22; animation: drift-b 22s ease-in-out infinite alternate; }
  .aurora--c { inline-size: 22rem; block-size: 18rem; inset-block-start: 8rem; inset-inline-end: 14%; background: var(--k-brand-300); opacity: 0.18; animation: drift-b 26s ease-in-out infinite alternate-reverse; }
  [data-theme="light"] .aurora { opacity: 0.18; }
  @keyframes drift-a { to { translate: 40% 3rem; scale: 1.15; } }
  @keyframes drift-b { to { translate: -4rem 2rem; scale: 1.2; } }
  .hero__pattern {
    position: absolute; inset: 0; inline-size: 100%; block-size: 100%;
    fill: none; stroke: var(--k-border-secondary); stroke-width: 1; opacity: 0.8;
    mask-image: radial-gradient(ellipse 55% 60% at 50% 10%, #000 15%, transparent 70%);
  }
  .hero__inner { max-inline-size: 52rem; margin-inline: auto; }

  .pill {
    display: inline-flex; align-items: center; gap: var(--k-space-2);
    padding: 0.25rem 0.75rem 0.25rem 0.25rem; padding-inline: 0.25rem 0.75rem;
    border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-full);
    background: color-mix(in srgb, var(--k-bg-elevated) 80%, transparent); backdrop-filter: blur(8px);
    color: var(--k-text-secondary); font-size: var(--k-text-sm); font-weight: var(--k-weight-medium); text-decoration: none;
    box-shadow: var(--k-shadow-xs), var(--k-highlight);
    transition: border-color var(--k-duration-fast), color var(--k-duration-fast);
  }
  .pill:hover { border-color: var(--k-border-primary); color: var(--k-text-primary); }
  .pill:focus-visible { outline: 2px solid transparent; box-shadow: var(--k-ring-brand); }
  .pill__tag { padding: 0.125rem 0.625rem; border-radius: var(--k-radius-full); background: var(--k-bg-brand); color: var(--k-text-on-brand); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .pill__arrow { inline-size: 1rem; block-size: 1rem; transition: translate var(--k-duration-normal) var(--k-ease-standard); }
  .pill:hover .pill__arrow { translate: -3px 0; }

  .hero__title {
    margin-block: var(--k-space-6) var(--k-space-6);
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: var(--k-weight-black);
    line-height: 1.2;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .hero__lead { max-inline-size: 40rem; margin: 0 auto; color: var(--k-text-tertiary); font-size: clamp(var(--k-text-md), 1.8vw, var(--k-text-lg)); line-height: 2; text-wrap: pretty; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--k-space-3); margin-block-start: var(--k-space-10); }
  .hero__actions svg { transition: translate var(--k-duration-normal) var(--k-ease-standard); }
  .hero__actions a:hover svg { translate: -3px 0; }
  .hero__install { max-inline-size: 26rem; margin: var(--k-space-5) auto 0; }

  /* نمای محصول */
  .product { position: relative; max-inline-size: var(--max); margin: clamp(3.5rem, 8vw, 5.5rem) auto 0; perspective: 1800px; text-align: start; }
  .product__glow { position: absolute; inset: 10% 8% -4%; z-index: -1; border-radius: 50%; background: var(--k-brand-500); filter: blur(90px); opacity: 0.22; }
  .product__frame {
    margin: 0;
    border: 1px solid var(--k-border-secondary);
    border-radius: var(--k-radius-2xl);
    background: var(--k-bg-secondary);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--k-text-primary) 4%, transparent), var(--k-shadow-2xl), var(--k-highlight);
    overflow: clip;
    transform-origin: 50% 0;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .product__frame { animation: tilt linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
    }
  }
  @keyframes tilt { from { transform: rotateX(18deg) scale(0.94); opacity: 0.6; } to { transform: none; opacity: 1; } }
  .product__bar { display: flex; align-items: center; gap: var(--k-space-4); padding: var(--k-space-3) var(--k-space-4); border-block-end: 1px solid var(--k-border-secondary); direction: ltr; }
  .product__dots { display: flex; gap: 6px; }
  .product__dots i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--k-border-primary); }
  .product__url { flex: 1; max-inline-size: 20rem; margin-inline: auto; padding: 0.25rem 0.75rem; border-radius: var(--k-radius-md); background: var(--k-bg-tertiary); color: var(--k-text-tertiary); font: 0.75rem var(--k-font-mono); text-align: center; }

