  /* نوار فناوری‌ها: مارکی بی‌پایان */
  .marquee { display: flex; flex: 1; gap: var(--k-space-10); overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .marquee .stack__list { flex: none; flex-wrap: nowrap; justify-content: flex-start; min-inline-size: max-content; gap: var(--k-space-10); }

  /* کارت‌های نورافکن */
  :global(.spot) { position: relative; }
  :global(.spot)::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(22rem circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--k-text-brand) 9%, transparent), transparent 60%); }
  :global(.spot):hover::after { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] { filter: blur(4px); transition: opacity 0.7s var(--k-ease-standard), translate 0.7s var(--k-ease-standard), filter 0.7s var(--k-ease-standard); }
    :global(.js) [data-reveal].is-in { filter: none; }
    .hero__cta:hover::after { translate: -120% 0; transition: translate 0.8s var(--k-ease-standard); }
    .chip { animation: float 6s ease-in-out infinite; }
    .chip--2 { animation-delay: -1.5s; } .chip--3 { animation-delay: -3s; } .chip--4 { animation-delay: -4.5s; }
    .marquee .stack__list { animation: marquee 32s linear infinite; }
    .marquee:hover .stack__list { animation-play-state: paused; }
    .iconset__grid.is-swapping .iconset__glyph:not([hidden]) { animation: pop 0.45s var(--k-ease-standard) both; animation-delay: calc(var(--i, 0) * 14ms); }
    .iconset__cell:hover :global(svg) { scale: 1.15; }
    .iconset__glyph :global(svg) { transition: scale 0.2s var(--k-ease-standard); }
    @supports (animation-timeline: scroll()) {
