          <ul class="iconset__grid" role="list">
            {iconShowcase.map((n, k) => (
              <li style={`--i: ${k}`}>
                <a class="iconset__cell" href={`/docs/icons/${n}/`} aria-label={icons[n].title} title={icons[n].title}>
                  {variants.map((v, i) => <span class="iconset__glyph" data-v={v} hidden={i !== 0} set:html={iconSvg(n, { size: 24, variant: v })} />)}
