<script>
  import { createTheme } from "@kashi-ui/tokens";

  // ظاهر شدن با اسکرول
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("is-in");
        io.unobserve(e.target);
      }
    },
    { rootMargin: "0px 0px -8% 0px" },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

  // تغییر رنگ برند کل صفحه
  const style = document.createElement("style");
  document.head.append(style);
  const code = document.querySelector("[data-brand-code]");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".swatch");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const value = btn.dataset.brand;
      style.textContent = value ? createTheme({ brand: value }) : "";
      if (code) code.textContent = `"${value || "#0fa89b"}"`;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    }),
  );
</script>

<script>
  // تعویض سبک در بخش آیکون‌ها؛ همهٔ سبک‌ها از پیش رندر شده‌اند
  const iconStyles = document.querySelectorAll<HTMLButtonElement>(".iconset__style");
  iconStyles.forEach((btn) => btn.addEventListener("click", () => {
    iconStyles.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    document.querySelectorAll<HTMLElement>(".iconset__glyph").forEach((g) => { g.hidden = g.dataset.v !== btn.dataset.variant; });
    if (current) show(current, true);
  }));

  // ویترین آیکون: آیکون زیر ماوس یا فوکوس بزرگ نمایش داده می‌شود؛ وگرنه خودکار می‌چرخد
  const big = document.querySelector<HTMLElement>("[data-icx-big]");
  const nameEl = document.querySelector<HTMLElement>("[data-icx-name]");
  const codeEl = document.querySelector<HTMLElement>("[data-icx-code]");
  const sizes = [...document.querySelectorAll<HTMLElement>("[data-icx-size]")];
  const cells = [...document.querySelectorAll<HTMLAnchorElement>(".iconset__cell")];
  let current: HTMLAnchorElement | null = null;
  const show = (cell: HTMLAnchorElement, force = false) => {
    if (!big || (!force && cell === current)) return;
    current?.removeAttribute("data-current");
    current = cell;
    cell.setAttribute("data-current", "");
    const svg = cell.querySelector(".iconset__glyph:not([hidden]) svg");
    if (!svg) return;
    const variant = cell.querySelector<HTMLElement>(".iconset__glyph:not([hidden])")?.dataset.v ?? "light";
    big.replaceChildren(svg.cloneNode(true));
    big.classList.remove("is-in"); void big.offsetWidth; big.classList.add("is-in");
    sizes.forEach((box) => box.replaceChildren(svg.cloneNode(true)));
    if (nameEl) nameEl.textContent = cell.getAttribute("aria-label");
    if (codeEl) codeEl.textContent = `<Icon name="${cell.dataset.icxName}"${variant === "light" ? "" : ` variant="${variant}"`} />`;
  };
  if (cells.length) show(cells.find((c) => c.dataset.icxName === "samovar") ?? cells[0], true);
  const box = document.querySelector<HTMLElement>(".icx");
  let paused = false;
  box?.addEventListener("pointerenter", () => (paused = true));
  box?.addEventListener("pointerleave", () => (paused = false));
  cells.forEach((c) => {
    c.addEventListener("pointerenter", () => show(c));
    c.addEventListener("focus", () => { paused = true; show(c); });
    c.addEventListener("blur", () => (paused = false));
  });
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let k = 0;
    setInterval(() => {
      if (paused || document.hidden || !box || box.getBoundingClientRect().bottom < 0 || box.getBoundingClientRect().top > innerHeight) return;
      k = (cells.indexOf(current!) + 1) % cells.length;
      show(cells[k]);
    }, 2400);
  }
</script>

<script>
  // موشن هیرو و ریزتعامل‌ها؛ با prefers-reduced-motion همه خاموش می‌شوند
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(pointer: fine)").matches;
  const faNum = (n: number) => String(n).replace(/\d/g, (d) => "۰۱۲۳۴۵۶۷۸۹"[+d]);

  // شمارش عددها وقتی دیده می‌شوند
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const countIo = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      countIo.unobserve(e.target);
      const el = e.target as HTMLElement;
      const end = Number(el.dataset.count);
      if (calm) continue;
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 1400);
        el.textContent = faNum(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  }, { threshold: 0.6 });
  counters.forEach((c) => countIo.observe(c));

  if (!calm && fine) {
    // نمای محصول با کج شدن سه‌بعدی کم
    const tilt = document.querySelector<HTMLElement>("[data-tilt]");
    tilt?.addEventListener("pointermove", (e) => {
      const r = tilt.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.transform = `rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg)`;
    });
    tilt?.addEventListener("pointerleave", () => { tilt.style.transform = ""; });

    // نورافکن روی کارت‌ها
    document.querySelectorAll<HTMLElement>(".quality__item, .ent__item, .step, .vs, .arch, .tile, .iconset, .author, .support, .metrics, .live, .adopt").forEach((card) => {
      card.classList.add("spot");
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - r.left}px`);
        card.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }

  // موج کوچک هنگام تعویض سبک آیکون‌ها
  const iconGrid = document.querySelector<HTMLElement>(".iconset__grid");
  document.querySelectorAll(".iconset__style").forEach((b) => b.addEventListener("click", () => {
    if (!iconGrid) return;
    iconGrid.classList.remove("is-swapping");
    void iconGrid.offsetWidth;
    iconGrid.classList.add("is-swapping");
  }));

  // نور هیرو دنبال ماوس
  const heroEl = document.querySelector<HTMLElement>("[data-hero]");
  if (heroEl && matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
    heroEl.addEventListener("pointermove", (e) => {
      const r = heroEl.getBoundingClientRect();
      heroEl.style.setProperty("--hx", `${e.clientX - r.left}px`);
      heroEl.style.setProperty("--hy", `${e.clientY - r.top}px`);
    }, { passive: true });
  }
</script>
