<script>
  import { createTheme } from "@kashi-ui/tokens";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fa = (n: number) => String(n).replace(/\d/g, (d) => "۰۱۲۳۴۵۶۷۸۹"[+d]);

  // ظاهر شدن با اسکرول و شمارش اعداد
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("is-in");
        io.unobserve(e.target);
        const dd = e.target.querySelector<HTMLElement>("[data-count]");
        const to = Number(dd?.dataset.count);
        if (dd && to > 0 && !reduced) {
          const t0 = performance.now();
          const step = (t: number) => {
            const p = Math.min(1, (t - t0) / 1400);
            dd.textContent = fa(Math.round(to * (1 - (1 - p) ** 4)));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      }
    },
    { rootMargin: "0px 0px -10% 0px" },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

  // نور زیر موس روی کارت‌ها
  document.querySelectorAll<HTMLElement>("[data-spot]").forEach((el) =>
    el.addEventListener("pointermove", (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty("--mx", `${e.clientX - r.left}px`);
      el.style.setProperty("--my", `${e.clientY - r.top}px`);
    }),
  );

  // تغییر رنگ برند کل صفحه
  const style = document.createElement("style");
  document.head.append(style);
  const code = document.querySelector("[data-brand-code]");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".swatch");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const value = btn.dataset.brand;
      style.textContent = value ? createTheme({ brand: value }) : "";
      if (code) code.textContent = `"${value || "#0fa89b"}"`;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    }),
  );
</script>
