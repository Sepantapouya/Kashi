---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Install from "../components/Install.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import HeroApp from "../components/HeroApp";
import { BentoCalendar, BentoDirection, BentoPlate } from "../components/HomeBento";
import { nav } from "../data/nav";
import { author } from "../data/author";
import * as tokens from "@kashi-ui/tokens";
import { icons, iconSvg, categories, variants } from "@kashi-ui/icons";
import pkg from "@kashi-ui/react/package.json";

const fa = (n: number | string) => String(n).replace(/\d/g, (d) => "۰۱۲۳۴۵۶۷۸۹"[+d]);
const count = (o: object): number => Object.values(o).reduce((n: number, v) => n + (typeof v === "object" ? count(v) : 1), 0);
const { themes, ...primitives } = tokens as Record<string, any>;
delete primitives.createTheme;
delete primitives.brandScale;
const tokenCount = count(primitives) + Object.keys(themes.dark).length;
const componentCount = nav
  .filter((g) => g.title === "کامپوننت‌ها" || g.title === "فارسی")
  .flatMap((g) => g.items)
  .filter((i) => !i.href.includes("utilities") && !i.href.includes("bank-logos")).length;
const newItems = nav.flatMap((g) => g.items).filter((i) => i.badge);
const version = fa(pkg.version.split(".").slice(0, 2).join("٫"));

// آیکون‌های خطی ۲۰×۲۰ همین صفحه
const ICON = {
  check: "m5 10.5 3.2 3L15 7",
  arrow: "M16 10H4m5-5-5 5 5 5",
  layers: "m10 3 7 3.5-7 3.5-7-3.5L10 3Zm-7 7 7 3.5 7-3.5M3 13.5 10 17l7-3.5",
  shield: "M10 2.5 16 5v4.5c0 3.8-2.6 6.6-6 8-3.4-1.4-6-4.2-6-8V5l6-2.5Zm-2.5 7.7 1.8 1.8 3.4-3.6",
  contrast: "M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm0-14v14",
  tag: "M3 3.5h6.5l7.5 7.5-6 6-7.5-7.5V3.5Zm3.5 3.5h.01",
  branch: "M6 3.5v9m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8-5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm0 0c0 3-3 3.5-8 5",
  figma: "M7.5 17a2.5 2.5 0 0 0 2.5-2.5V12H7.5a2.5 2.5 0 0 0 0 5Zm0-5H10V7H7.5a2.5 2.5 0 0 0 0 5Zm0-5H10V2H7.5a2.5 2.5 0 0 0 0 5ZM10 2h2.5a2.5 2.5 0 0 1 0 5H10V2Zm2.5 10a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z",
  scale: "M10 3v14M5 17h10M3 7h14M5 7l-2.5 5a2.5 2.5 0 0 0 5 0L5 7Zm10 0-2.5 5a2.5 2.5 0 0 0 5 0L15 7Z",
};

const facts = [
  { label: "نسخهٔ پایدار", value: `v${pkg.version}`, ltr: true },
  { label: "لایسنس", value: "MIT", ltr: true },
  { label: "دسترس‌پذیری", value: "WCAG 2.2 AA", ltr: true },
  { label: "کامپوننت", value: fa(componentCount) },
  { label: "توکن طراحی", value: fa(tokenCount) },
  { label: "وابستگی زمان اجرای CSS", value: fa(0) },
];

const stacks = ["React", "TypeScript", "HTML", "Vue", "Svelte", "Angular", "Astro", "Figma"];

const layers = [
  { tier: "طراحی", name: "Kashi UI Kit", kind: "پلاگین فیگما", text: "حدود ۲۷۰ Variable و بیش از ۷۰ کامپوننت، مستقیم از روی همین کد.", href: "/docs/figma/" },
  { tier: "پایه", name: "@kashi-ui/tokens", kind: "CSS · JSON · JS", text: "رنگ، فاصله، تایپوگرافی و سایه؛ یک منبع حقیقت برای طراحی و کد.", href: "/docs/theming/" },
  { tier: "استایل", name: "@kashi-ui/css", kind: "CSS خالص", text: "استایل همهٔ کامپوننت‌ها در Cascade Layer؛ برای هر فریم‌ورکی.", href: "/docs/installation/" },
  { tier: "کامپوننت", name: "@kashi-ui/react", kind: "React · TypeScript", text: `${fa(componentCount)} کامپوننت دسترس‌پذیر با تایپ کامل و برچسب‌های فارسی.`, href: "/docs/components/" },
];
const modules = [
  { name: "@kashi-ui/persian", kind: "بدون وابستگی", text: "تاریخ شمسی، ارقام فارسی و اعتبارسنجی کد ملی، کارت و شبا.", href: "/docs/persian/utilities/" },
  { name: "@kashi-ui/icons", kind: "React · SVG", text: "۳۳۴۷ آیکون در شش سبک، هماهنگ با زبان بصری کاشی.", href: "/docs/icons/" },
  { name: "@kashi-ui/bank-logos", kind: "CC0", text: "لوگوی SVG ‏۴۰ بانک و ۱۰ درگاه پرداخت ایران.", href: "/docs/persian/bank-logos/" },
];

const features = [
  { id: "persian", label: "داده‌های ایرانی", title: "پلاک، شبا، کد ملی؛ آماده و معتبرسنجی‌شده", text: "ورودی‌هایی که ساختار داده‌های ایرانی را می‌شناسند، ارقام فارسی و انگلیسی را می‌پذیرند و خطا را به زبان کاربر می‌گویند.", href: "/docs/persian/input/" },
  { id: "calendar", label: "تقویم جلالی", title: "تاریخ و بازهٔ شمسی، بدون کتابخانهٔ جانبی", text: "تبدیل دقیق برای سال‌های ۱۳۰۰ تا ۱۵۰۰، انتخاب بازه، ماه و تعطیلات رسمی.", href: "/docs/persian/date-picker/" },
  { id: "rtl", label: "راست‌به‌چپ", title: "یک کد، هر دو جهت", text: "همهٔ استایل‌ها با Logical Properties نوشته شده‌اند؛ محصول دوزبانه بدون فورک کردن کامپوننت‌ها.", href: "/docs/components/" },
  { id: "a11y", label: "دسترس‌پذیری", title: "شرط بیلد، نه وعده", text: "کنتراست همهٔ جفت‌رنگ‌ها در هر دو تم بررسی می‌شود و بیلدی که رد شود منتشر نمی‌شود. الگوهای ARIA، فوکوس و صفحه‌کلید در همهٔ کامپوننت‌ها.", href: "/docs/accessibility/" },
  { id: "theme", label: "تم‌پذیری", title: "برند شما، در یک خط کد", text: "یک رنگ بدهید؛ کاشی طیف یازده‌پله‌ای را می‌سازد و همهٔ کامپوننت‌ها هماهنگ می‌شوند. همین‌جا امتحان کنید:", href: "/docs/theming/" },
];

const brands = [
  { name: "فیروزه‌ای", value: "" },
  { name: "لاجوردی", value: "#3d5ef8" },
  { name: "زعفرانی", value: "#dd5e02" },
  { name: "اناری", value: "#e51d2a" },
  { name: "بنفش", value: "#7c3aed" },
];

const governance = [
  { icon: ICON.contrast, title: "کنتراست AA در هر بیلد", text: "۸۲ جفت‌رنگ در تم تیره و روشن بررسی می‌شود؛ بیلدِ رد‌شده منتشر نمی‌شود." },
  { icon: ICON.shield, title: "الگوهای دسترس‌پذیر", text: "نقش‌ها و ویژگی‌های ARIA، مدیریت فوکوس و کار کامل با صفحه‌کلید، با تست خودکار." },
  { icon: ICON.tag, title: "نسخه‌گذاری معنایی", text: "انتشار با Changesets و یادداشت تغییر برای هر پکیج؛ تغییر ناسازگار همیشه اعلام می‌شود." },
  { icon: ICON.figma, title: "هم‌خوانی فیگما و کد", text: "پلاگین فیگما در CI ساخته و با CSS زنده مقایسه می‌شود؛ طراحی و کد از هم جدا نمی‌افتند." },
  { icon: ICON.branch, title: "CI روی هر تغییر", text: "هر Pull Request بیلد، تست و بررسی محتوای پکیج‌ها را پشت سر می‌گذارد." },
  { icon: ICON.scale, title: "لایسنس MIT", text: "استفادهٔ تجاری و داخلی بدون محدودیت؛ لوگوی بانک‌ها با CC0 و فونت با OFL." },
];

const checks = [
  ["npm ci", "نصب قفل‌شده"],
  ["build", "۶ پکیج و بررسی کنتراست WCAG"],
  ["test", "توکن‌ها، فارسی، آیکون‌ها، React"],
  ["figma:test", "هم‌خوانی پلاگین با CSS"],
  ["docs", "بیلد سایت مستندات"],
  ["pack", "بررسی محتوای پکیج‌ها"],
];

type Mark = "yes" | "part" | "no" | "na";
const MARK: Record<Mark, string> = { yes: "دارد", part: "بخشی یا با تنظیم", no: "ندارد", na: "اعلام نشده" };
const MARK_PATH: Record<Mark, string> = { yes: "m5 10.5 3.2 3L15 7", part: "M5 10h10", no: "m6 6 8 8M14 6l-8 8", na: "M5.5 10h.01M10 10h.01M14.5 10h.01" };
const systems = ["کاشی", "shadcn/ui", "MUI", "Ant Design"];
const compare: [string, Mark[]][] = [
  ["راست‌به‌چپ پیش‌فرض", ["yes", "part", "part", "part"]],
  ["تقویم و تاریخ شمسی", ["yes", "part", "part", "part"]],
  ["کد ملی، شبا، کارت و پلاک", ["yes", "no", "no", "no"]],
  ["فونت فارسی همراه پکیج", ["yes", "no", "no", "no"]],
  ["استفاده بدون React", ["yes", "no", "no", "no"]],
  ["بررسی خودکار کنتراست", ["yes", "na", "na", "na"]],
  ["اکوسیستم و جامعه", ["part", "yes", "yes", "yes"]],
];

const steps = [
  { n: "۰۱", title: "نصب", text: "دو پکیج: کامپوننت‌های React و استایل‌ها. فونت وزیرمتن همراه است.", code: "npm i @kashi-ui/react @kashi-ui/css" },
  { n: "۰۲", title: "یک خط CSS", text: "استایل‌ها در Cascade Layer هستند، پس CSS خودتان همیشه برنده است.", code: 'import "@kashi-ui/css";' },
  { n: "۰۳", title: "بسازید", text: "برچسب‌ها، پیام‌ها و ارقام از پیش فارسی‌اند؛ دسترس‌پذیری هم.", code: '<DatePicker label="تاریخ تولد" />' },
];

// بخش آیکون‌ها: نمونه‌ها در هر شش سبک رندر می‌شوند و دکمه‌ها فقط نمایششان را عوض می‌کنند
const iconShowcase = [
  "home", "search", "wallet", "credit-card", "calendar", "chat", "bell", "user",
  "shopping-bag", "chart-line", "shield", "lock", "camera", "music", "heart", "star",
  "sparkles", "ai-chat", "rocket", "coffee", "samovar", "windcatcher", "tar", "sangak",
  "pomegranate", "kashi-tile", "persian-star", "rial", "card-to-card", "text-rtl", "translate-fa", "azadi-tower",
].filter((n) => icons[n]);
const variantLabels = { light: "خطی", bold: "توپر", bulk: "حجمی", "two-tone": "دورنگ", broken: "شکسته", curved: "منحنی" };
const iconCount = Object.keys(icons).length;
const iconCategoryCount = Object.keys(categories).length;

// هیرو: عددهای کلیدی و تراشه‌های کنار نمای محصول
const metrics = [
  { label: "کامپوننت", value: componentCount },
  { label: "آیکون در شش سبک", value: iconCount },
  { label: "توکن طراحی", value: tokenCount },
  { label: "جفت‌رنگ AA", value: 82, suffix: "٪۱۰۰" },
];
const chips = [
  { icon: "calendar", label: "تقویم شمسی", value: "پنجشنبه ۷ آبان ۱۴۰۵" },
  { icon: "bank", label: "شبا معتبر", value: "IR06 0170 0000 …", ltr: true },
  { icon: "car", label: "پلاک خودرو", value: "۱۲ ب ۳۴۵ — ۶۷" },
  { icon: "contrast", label: "کنتراست", value: "WCAG 2.2 AA", ltr: true },
];
---
<Base>
  <a class="announce" href={newItems[0]?.href ?? "/docs/changelog/"}>
    <span class="announce__tag">نسخهٔ {version}</span>
    <span class="announce__text">{fa(newItems.length)} کامپوننت و ابزار تازه، از جمله پکیج آیکون‌ها</span>
    <span class="announce__more">یادداشت انتشار <span aria-hidden="true">←</span></span>
  </a>
  <Header />
  <main id="main" tabindex="-1" class="home">
    <!-- ───── هیرو ───── -->
    <div class="scroll-progress" aria-hidden="true"></div>
    <section class="hero" aria-labelledby="hero-title" data-hero>
      <div class="hero__bg" aria-hidden="true"></div>

      <div class="wrap hero__center">
        <a class="hero__badge" href="/docs/icons/" data-enter style="--d: 0">
          <span class="hero__badge-tag">تازه</span>
          {fa(iconCount)} آیکون در شش سبک
          <span aria-hidden="true">←</span>
        </a>
        <h1 id="hero-title" class="hero__title" data-enter style="--d: 1">
          زیرساخت طراحی محصولات فارسی،{" "}
          <span class="hero__accent">در مقیاس سازمان.</span>
        </h1>
        <p class="hero__lead" data-enter style="--d: 2">
          کامپوننت‌ها، توکن‌ها و الگوهای راست‌به‌چپ و دسترس‌پذیر، به‌همراه ابزارهایی که فقط یک محصول ایرانی لازم دارد: تقویم شمسی، کد ملی، شبا، پلاک و بیشتر.
        </p>
        <div class="hero__actions" data-enter style="--d: 3">
          <a class="k-btn k-btn--primary k-btn--lg hero__cta" href="/docs/">
            شروع کنید
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-k-mirror=""><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
          </a>
          <a class="k-btn k-btn--secondary k-btn--lg" href="/docs/components/">مرور کامپوننت‌ها</a>
        </div>
        <div class="hero__install" data-enter style="--d: 4"><Install /></div>
        <ul class="hero__facts" role="list" data-enter style="--d: 5">
          {facts.filter((x) => x.ltr).map((x) => <li><span>{x.label}</span><b dir="ltr">{x.value}</b></li>)}
        </ul>
      </div>

      <!-- عددها با شمارش زنده -->
      <div class="wrap">
        <dl class="metrics" data-enter style="--d: 6">
          {metrics.map((m) => (
            <div class="metrics__item">
              <dt>{m.label}</dt>
              <dd><span data-count={m.value}>{fa(m.value)}</span>{m.suffix && <small>{m.suffix}</small>}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- نمای محصول با تراشه‌های شناور -->
      <div class="wrap">
        <div class="stage" data-enter style="--d: 7">
          <ul class="chips" role="list" aria-label="نمونه‌ای از قابلیت‌های فارسی">
            {chips.map((c, k) => (
              <li class={`chip chip--${k + 1}`}>
                <span class="chip__icon" set:html={iconSvg(c.icon, { size: 18 })} />
                <span><small>{c.label}</small><b dir={c.ltr ? "ltr" : undefined}>{c.value}</b></span>
              </li>
            ))}
          </ul>
          <figure class="product" data-tilt aria-label="نمونهٔ پنل مدیریت ساخته‌شده با کاشی">
            <div class="product__bar" aria-hidden="true">
              <span class="product__dots"><i></i><i></i><i></i></span>
              <span class="product__url" dir="ltr">naroon.shop/dashboard</span>
            </div>
            <HeroApp client:visible />
          </figure>
        </div>
        <p class="product__caption">پنل بالا یک نمونهٔ زنده است و فقط با کامپوننت‌های کاشی ساخته شده؛ فیلترها و بازهٔ زمانی کار می‌کنند.</p>
      </div>
    </section>

    <!-- ───── سازگاری ───── -->
    <section class="stack" aria-labelledby="stack-title">
      <div class="wrap stack__inner">
        <h2 id="stack-title" class="stack__title">هماهنگ با پشتهٔ فنی تیم شما</h2>
        <div class="marquee">
          <ul class="stack__list" role="list">
            {stacks.map((s) => <li dir="ltr">{s}</li>)}
          </ul>
          <ul class="stack__list" role="list" aria-hidden="true">
            {stacks.map((s) => <li dir="ltr">{s}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ───── ۰۱ پلتفرم ───── -->
    <section class="band" aria-labelledby="platform-title">
      <div class="wrap">
        <header class="band__head" data-reveal>
          <div>
            <p class="kicker"><span class="kicker__n">۰۱</span>پلتفرم</p>
            <h2 id="platform-title">یک پلتفرم، از فیگما تا تولید</h2>
          </div>
          <p class="band__lead">کاشی لایه‌لایه ساخته شده: هر تیم فقط همان بخشی را برمی‌دارد که لازم دارد، و همه از یک منبع توکن تغذیه می‌شوند.</p>
        </header>

        <div class="arch" data-reveal>
          <ol class="arch__stack" role="list" aria-label="لایه‌های کاشی">
            {layers.map((l) => (
              <li class="arch__layer">
                <span class="arch__tier">{l.tier}</span>
                <a class="pkg" href={l.href}>
                  <span class="pkg__top"><code class="pkg__name">{l.name}</code><span class="pkg__kind">{l.kind}</span></span>
                  <span class="pkg__text">{l.text}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="arch__modules">
            <p class="arch__label">ماژول‌های فارسی و دارایی‌ها</p>
            <ul role="list">
              {modules.map((m) => (
                <li>
                  <a class="pkg pkg--module" href={m.href}>
                    <span class="pkg__top"><code class="pkg__name">{m.name}</code><span class="pkg__kind">{m.kind}</span></span>
                    <span class="pkg__text">{m.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ───── ۰۲ قابلیت‌ها ───── -->
    <section class="band band--alt" aria-labelledby="features-title">
      <div class="wrap">
        <header class="band__head" data-reveal>
          <div>
            <p class="kicker"><span class="kicker__n">۰۲</span>قابلیت‌ها</p>
            <h2 id="features-title">ساخته‌شده برای فارسی، نه ترجمه‌شده</h2>
          </div>
          <p class="band__lead">هر چیزی که یک محصول فارسی از روز اول لازم دارد، به شکل کامپوننت آماده و تست‌شده. هر بخش را باز کنید و نمونهٔ زنده‌اش را ببینید.</p>
        </header>

        <div class="explorer" data-tabs data-reveal>
          <div class="explorer__tabs" role="tablist" aria-label="قابلیت‌ها" aria-orientation="vertical">
            {features.map((f, i) => (
              <button type="button" role="tab" id={`tab-${f.id}`} aria-controls={`panel-${f.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class="explorer__tab">
                <span class="explorer__num" aria-hidden="true">{fa(`0${i + 1}`)}</span>
                {f.label}
              </button>
            ))}
          </div>
          {features.map((f, i) => (
            <div class="explorer__panel" role="tabpanel" id={`panel-${f.id}`} aria-labelledby={`tab-${f.id}`} hidden={i !== 0}>
              <div class="explorer__text">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                {f.id === "theme" && (
                  <div class="swatches" role="group" aria-label="رنگ برند">
                    {brands.map((b, j) => (
                      <button type="button" class="swatch" data-brand={b.value} aria-pressed={j === 0 ? "true" : "false"} style={`--sw: ${b.value || "var(--k-firoozeh-600)"}`}>
                        <span class="swatch__dot" aria-hidden="true"></span>{b.name}
                      </button>
                    ))}
                  </div>
                )}
                <a class="text-link" href={f.href}>مستندات {f.label} <span aria-hidden="true">←</span></a>
              </div>
              <div class="explorer__demo">
                {f.id === "persian" && <BentoPlate client:visible />}
                {f.id === "calendar" && <div class="explorer__cal"><BentoCalendar client:only="react" /></div>}
                {f.id === "rtl" && <BentoDirection client:visible />}
                {f.id === "a11y" && (
                  <div class="audit" role="img" aria-label="۸۲ از ۸۲ جفت‌رنگ با کنتراست AA در هر دو تم">
                    <div class="audit__score" aria-hidden="true"><strong>{fa(82)}</strong><span>/{fa(82)}</span></div>
                    <p class="audit__label" aria-hidden="true">جفت‌رنگ با کنتراست WCAG 2.2 AA</p>
                    <div class="audit__bar" aria-hidden="true"><span></span></div>
                    <ul class="audit__rows" aria-hidden="true">
