  .sz-wrap { overflow-x: auto; }
  .sz { display: table; inline-size: 100%; border-collapse: collapse; font-size: var(--k-text-sm); }
  .sz th, .sz td { padding: var(--k-space-2) var(--k-space-3); border-block-end: 1px solid var(--k-border-secondary); text-align: start; font-variant-numeric: tabular-nums; }
  .sz thead th { color: var(--k-text-tertiary); font-weight: var(--k-weight-medium); }
  .sz tbody th { font-weight: var(--k-weight-medium); }
  .sz tbody th code { margin-inline-start: var(--k-space-2); color: var(--k-text-tertiary); font-size: var(--k-text-xs); }
  .sz td { color: var(--k-text-secondary); white-space: nowrap; }
</style>
