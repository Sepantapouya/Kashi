---
import Docs from "../../layouts/Docs.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { icons, iconSvg } from "@kashi-ui/icons";
import { toFaDigits } from "@kashi-ui/persian";
import mcpPkg from "../../../../../packages/mcp/package.json";
import { collectDocs } from "../../../../../packages/mcp/src/docs-to-md.mjs";
import { nav } from "../../data/nav";

// عددهای سرور از همان منبعی می‌آید که پکیج MCP می‌سازد
const fa = (n: number) => toFaDigits(n.toLocaleString("en-US").replace(/,/g, "٬"));
const ic = (name: string, size = 20) => iconSvg(name, { size }) ?? "";
// بیلد و dev از پوشهٔ apps/docs اجرا می‌شوند
const docCount = collectDocs(`${process.cwd()}/src/pages/docs`, nav).length;
const iconCount = Object.keys(icons).length;
const npx = "npx -y @kashi-ui/mcp";
const claudeCmd = `claude mcp add kashi -- ${npx}`;

const stats: [string, string][] = [
  [fa(8), "ابزار برای دستیار"],
  [fa(docCount), "صفحهٔ مستندات"],
  [fa(iconCount), "آیکون قابل جستجو"],
  [fa(0), "کلید API و سرور"],
];

const clientNames = ["Claude Code", "Cursor", "VS Code", "Windsurf", "Claude Desktop", "Zed"];

const json = (key: string) => JSON.stringify({ [key]: { kashi: { command: "npx", args: ["-y", "@kashi-ui/mcp"] } } }, null, 2);
const clients = [
  { id: "claude-code", name: "Claude Code", where: "در ترمینال، داخل پوشهٔ پروژه:", code: claudeCmd, lang: "bash" },
  { id: "cursor", name: "Cursor", where: "فایل .cursor/mcp.json در ریشهٔ پروژه:", code: json("mcpServers"), lang: "json" },
  { id: "vscode", name: "VS Code", where: "فایل .vscode/mcp.json برای GitHub Copilot:", code: json("servers"), lang: "json" },
  { id: "claude-desktop", name: "Claude Desktop", where: "Settings › Developer › Edit Config، فایل claude_desktop_config.json:", code: json("mcpServers"), lang: "json" },
  { id: "windsurf", name: "Windsurf", where: "فایل ~/.codeium/windsurf/mcp_config.json:", code: json("mcpServers"), lang: "json" },
];

const toolGroups: { title: string; icon: string; tools: [string, string, string][] }[] = [
  { title: "مستندات", icon: "book-open", tools: [
    ["kashi_get_docs", "مستندات کامل یک کامپوننت", "prop ها، نمونهٔ React و HTML، متغیرهای CSS و دسترس‌پذیری"],
    ["kashi_search_docs", "جستجو در مستندات", "فارسی یا انگلیسی: «شبا»، «modal»، «جدول»"],
    ["kashi_list_docs", "فهرست همهٔ صفحه‌ها", "کامپوننت‌ها، فیلدهای فارسی و راهنماها"],
  ] },
  { title: "آیکون و طراحی", icon: "palette", tools: [
    ["kashi_search_icons", "جستجوی آیکون", `بین ${fa(iconCount)} آیکون با نام فارسی یا انگلیسی`],
    ["kashi_get_icon", "کد آیکون", "کامپوننت React یا SVG در هر شش سبک"],
    ["kashi_get_tokens", "توکن‌های طراحی", "رنگ، فاصله، سایه و متغیرهای تم"],
    ["kashi_create_theme", "ساخت تم برند", "یک رنگ بدهید، CSS کامل تم بگیرید"],
  ] },
  { title: "ابزارهای فارسی", icon: "id-card", tools: [
    ["kashi_persian", "اعتبارسنجی و تبدیل", "کد ملی، شبا و کارت با نام بانک، موبایل با اپراتور، تاریخ شمسی، عدد به حروف"],
  ] },
];

const prompts = [
  "یک فرم ثبت‌نام با کد ملی، موبایل و تاریخ تولد شمسی با کاشی بساز.",
  "صفحهٔ پرداخت با شماره کارت، شبا و مبلغ به حروف درست کن.",
  "داشبورد فروش با کارت آمار، جدول سفارش‌ها و نمودار ماهانه.",
  "تم برند ما با رنگ ‎#3d5ef8 و گوشه‌های گردتر را بساز.",
  "برای دکمهٔ «افزودن به سبد» یک آیکون مناسب پیدا کن.",
  "این کد ملی و شبا معتبرند؟ داده‌های تستی درست هم بساز.",
];

const faq: [string, string][] = [
  ["کلید API یا حساب کاربری لازم دارد؟", "نه. سرور روی کامپیوتر خودتان با npx اجرا می‌شود و همهٔ مستندات داخل خود پکیج است. چیزی به جایی فرستاده نمی‌شود و بعد از نصب بدون اینترنت هم کار می‌کند."],
  ["مستندات سرور با سایت فرق دارد؟", "نه. متن سرور از همین صفحه‌های سایت ساخته می‌شود و با هر نسخهٔ کاشی منتشر می‌شود. دستور npx -y همیشه آخرین نسخه را اجرا می‌کند."],
  ["کدام دستیارها پشتیبانی می‌شوند؟", "هر ابزاری که MCP را پشتیبانی کند: Claude Code، Claude Desktop، Cursor، VS Code با Copilot، Windsurf، Zed و بقیه. تنظیمات همه یک دستور است: npx -y @kashi-ui/mcp."],
  ["دستیار من MCP ندارد؛ چه کنم؟", "از llms.txt استفاده کنید. نشانی kashi.sepantapouya.com/llms-full.txt کل مستندات را در یک فایل متنی دارد که می‌شود به گفتگو داد یا دستیار خودش بخواند."],
];

const headings = [
  { depth: 2, slug: "why", text: "چرا MCP" },
  { depth: 2, slug: "install", text: "نصب در سه قدم" },
  { depth: 2, slug: "tools", text: "ابزارها" },
  { depth: 2, slug: "prompts", text: "چه بپرسیم" },
  { depth: 2, slug: "llms", text: "llms.txt" },
  { depth: 2, slug: "faq", text: "پرسش‌های رایج" },
];
---
<Docs title="استفاده با هوش مصنوعی" description="سرور MCP کاشی دستیارهای هوش مصنوعی را مستقیم به مستندات، آیکون‌ها، توکن‌ها و ابزارهای فارسی کاشی وصل می‌کند." headings={headings}>

  <!-- ───── هیرو ───── -->
  <section class="ai-hero" aria-label="معرفی">
    <div class="ai-hero__glow" aria-hidden="true"></div>
    <div class="ai-hero__copy">
      <span class="ai-eyebrow"><span class="ai-eyebrow__dot" aria-hidden="true"></span>سرور MCP کاشی · <bdi dir="ltr">v{mcpPkg.version}</bdi></span>
      <p class="ai-hero__title">دستیار هوش مصنوعی‌تان، <span>کاشی را از نزدیک می‌شناسد.</span></p>
      <p class="ai-hero__text">Claude، Cursor و Copilot دیگر prop های کاشی را حدس نمی‌زنند. <bdi class="ai-mono" dir="ltr">@kashi-ui/mcp</bdi> مستندات هر کامپوننت، {fa(iconCount)} آیکون، توکن‌ها و ابزارهای فارسی را در اختیارشان می‌گذارد تا کدی بنویسند که همان بار اول اجرا شود.</p>
      <div class="ai-cmd">
        <span class="ai-cmd__prompt" aria-hidden="true">$</span>
        <code dir="ltr">{claudeCmd}</code>
        <button type="button" class="k-btn k-btn--tertiary k-btn--icon k-btn--sm ai-copy" aria-label="کپی دستور" data-copy={claudeCmd} set:html={ic("copy")} />
      </div>
      <div class="ai-hero__links">
        <a class="text-link" href="#install">تنظیمات Cursor، VS Code و بقیه <span aria-hidden="true">←</span></a>
        <a class="text-link" href="https://www.npmjs.com/package/@kashi-ui/mcp" target="_blank" rel="noopener">npm<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a>
      </div>
    </div>

    <div class="ai-chat" aria-hidden="true">
      <div class="ai-chat__bar"><i></i><i></i><i></i><span>Claude Code · my-shop</span></div>
      <div class="ai-chat__body">
        <p class="ai-chat__user" style="--s: 0">یک فرم ثبت‌نام با کد ملی و تاریخ تولد شمسی بساز</p>
        <ul class="ai-chat__calls">
          <li style="--s: 1"><span class="ai-chat__tool">kashi</span><code>get_docs</code><span>NationalIdInput</span><b set:html={ic("check", 14)} /></li>
          <li style="--s: 2"><span class="ai-chat__tool">kashi</span><code>get_docs</code><span>DatePicker</span><b set:html={ic("check", 14)} /></li>
          <li style="--s: 3"><span class="ai-chat__tool">kashi</span><code>search_icons</code><span>«کاربر»</span><b set:html={ic("check", 14)} /></li>
        </ul>
        <pre class="ai-chat__code" style="--s: 4" dir="ltr"><span class="t-k">import</span> {"{"} <span class="t-c">NationalIdInput</span>, <span class="t-c">DatePicker</span>, <span class="t-c">Button</span> {"}"}
  <span class="t-k">from</span> <span class="t-s">"@kashi-ui/react"</span>;

&lt;<span class="t-c">NationalIdInput</span> <span class="t-a">label</span>=<span class="t-s">"کد ملی"</span> <span class="t-a">required</span> /&gt;
&lt;<span class="t-c">DatePicker</span> <span class="t-a">label</span>=<span class="t-s">"تاریخ تولد"</span> /&gt;
&lt;<span class="t-c">Button</span> <span class="t-a">variant</span>=<span class="t-s">"primary"</span>&gt;ثبت‌نام&lt;/<span class="t-c">Button</span>&gt;</pre>
        <p class="ai-chat__ok" style="--s: 5"><span set:html={ic("check", 14)} />prop ها از مستندات کاشی خوانده شد</p>
      </div>
    </div>

    <div class="ai-hero__foot">
      <span>کار می‌کند با</span>
      <ul role="list">{clientNames.map((c) => <li dir="ltr">{c}</li>)}</ul>
    </div>
  </section>

  <dl class="ai-stats">
    {stats.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}
  </dl>

  <!-- ───── چرا ───── -->
  <h2 id="why">چرا MCP</h2>
  <p>کاشی جدید است و مدل‌های زبانی تقریباً چیزی دربارهٔ آن نمی‌دانند؛ بی‌اطلاع، prop هایی می‌سازند که وجود ندارند. با MCP، دستیار پیش از نوشتن از خود کاشی می‌پرسد.</p>
  <div class="ai-vs">
    <figure class="ai-vs__card ai-vs__card--bad">
      <figcaption><span class="ai-vs__badge">بدون MCP</span>دستیار حدس می‌زند</figcaption>
      <pre dir="ltr">&lt;<span class="t-c">DatePicker</span>
  <span class="ai-vs__x">calendar="jalali"</span>
  <span class="ai-vs__x">format="jYYYY/jMM/jDD"</span>
  <span class="ai-vs__x">onDateSelect</span>=&#123;setDate&#125;
/&gt;</pre>
      <p>سه prop ساختگی؛ کد اجرا نمی‌شود یا بی‌صدا کار نمی‌کند.</p>
    </figure>
    <figure class="ai-vs__card ai-vs__card--good">
      <figcaption><span class="ai-vs__badge">با MCP کاشی</span>دستیار مستندات را می‌خواند</figcaption>
      <pre dir="ltr">&lt;<span class="t-c">DatePicker</span>
  <span class="t-a">label</span>=<span class="t-s">"تاریخ تولد"</span>
  <span class="t-a">max</span>=&#123;new Date()&#125;
  <span class="t-a">onChange</span>=&#123;setDate&#125;
/&gt;</pre>
      <p>همان prop هایی که در جدول ویژگی‌های کامپوننت آمده؛ شمسی به‌طور پیش‌فرض.</p>
    </figure>
  </div>

  <figure class="ai-flow" aria-label="روند کار: دستیار شما از سرور MCP کاشی که روی کامپیوتر خودتان اجرا می‌شود می‌پرسد">
    <div class="ai-flow__node">
      <span class="ai-flow__icon" set:html={ic("ai-chat", 22)} />
      <b>دستیار شما</b>
      <small>Claude، Cursor، Copilot</small>
    </div>
    <div class="ai-flow__link" aria-hidden="true"><span>پرسش</span><i></i><span>پاسخ دقیق</span></div>
    <div class="ai-flow__node ai-flow__node--kashi">
      <span class="ai-flow__icon" set:html={ic("persian-star", 22)} />
      <b>سرور MCP کاشی</b>
      <small>روی کامپیوتر خودتان</small>
    </div>
    <div class="ai-flow__link" aria-hidden="true"><span>داخل پکیج</span><i></i><span>بدون اینترنت</span></div>
    <div class="ai-flow__node">
      <span class="ai-flow__icon" set:html={ic("layers", 22)} />
      <b>دانش کاشی</b>
      <small>مستندات، آیکون، توکن، ابزار فارسی</small>
    </div>
  </figure>

  <!-- ───── نصب ───── -->
  <h2 id="install">نصب در سه قدم</h2>
  <ol class="ai-steps" role="list">
    <li>
      <span class="ai-steps__n" aria-hidden="true">۱</span>
      <div class="ai-steps__body">
        <h3>سرور را به دستیارتان اضافه کنید</h3>
        <div class="ai-tabs k-tabs k-tabs--segmented k-tabs--sm" data-ai-tabs>
          <div class="ai-tabs__list k-tabs__list" role="tablist" aria-label="دستیار">
            {clients.map((c, i) => (
              <button type="button" role="tab" class="k-tabs__tab" id={`t-${c.id}`} aria-controls={`p-${c.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{c.name}</button>
            ))}
          </div>
          {clients.map((c, i) => (
            <div class="ai-tabs__panel" role="tabpanel" id={`p-${c.id}`} aria-labelledby={`t-${c.id}`} hidden={i !== 0}>
              <p dir="auto">{c.where}</p>
              <CodeBlock code={c.code} lang={c.lang} />
            </div>
          ))}
        </div>
      </div>
    </li>
    <li>
      <span class="ai-steps__n" aria-hidden="true">۲</span>
      <div class="ai-steps__body">
        <h3>دستیار را دوباره باز کنید</h3>
        <p>ابزارهای kashi در فهرست ابزارها دیده می‌شوند؛ در Claude Code با دستور <code dir="ltr">/mcp</code> وضعیتش را ببینید.</p>
      </div>
    </li>
    <li>
      <span class="ai-steps__n" aria-hidden="true">۳</span>
      <div class="ai-steps__body">
        <h3>به زبان خودتان بخواهید</h3>
        <p>مثلاً: «با کاشی یک فرم ورود با موبایل و کد تأیید بساز.» دستیار خودش مستندات را می‌خواند.</p>
      </div>
    </li>
  </ol>

  <!-- ───── ابزارها ───── -->
  <h2 id="tools">ابزارها</h2>
  <p>دستیار خودش تصمیم می‌گیرد کدام ابزار را صدا بزند؛ لازم نیست اسمشان را بدانید.</p>
  <div class="ai-groups">
    {toolGroups.map((g) => (
      <section class="ai-group" aria-label={g.title}>
        <header><span set:html={ic(g.icon, 18)} />{g.title}</header>
        <ul role="list">
          {g.tools.map(([name, title, text]) => (
            <li>
              <code dir="ltr">{name}</code>
              <b>{title}</b>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="ai-note">همهٔ صفحه‌های مستندات به شکل resource هم در دسترس‌اند (<code dir="ltr">kashi://docs/…</code>) تا در دستیارهایی که این امکان را دارند، به گفتگو ضمیمه شوند.</p>

  <!-- ───── پرسش‌ها ───── -->
  <h2 id="prompts">چه بپرسیم</h2>
  <p>یکی را کپی کنید و در دستیارتان امتحان کنید.</p>
  <ul class="ai-prompts" role="list">
    {prompts.map((p) => (
      <li><span class="ai-prompts__icon" set:html={ic("ai-chat", 18)} /><span>{p}</span><button type="button" class="k-btn k-btn--tertiary k-btn--icon k-btn--sm ai-copy" aria-label="کپی متن" data-copy={p} set:html={ic("copy")} /></li>
    ))}
  </ul>

  <!-- ───── llms.txt ───── -->
  <h2 id="llms">llms.txt</h2>
  <p>برای دستیارهایی که MCP ندارند، همین مستندات به شکل متن ساده و طبق استاندارد <a href="https://llmstxt.org" target="_blank" rel="noopener">llms.txt<span class="k-sr-only"> (در پنجرهٔ جدید)</span></a> روی سایت هست:</p>
  <div class="ai-files">
    <a class="ai-file" href="/llms.txt">
      <span class="ai-file__icon" set:html={ic("file-text", 22)} />
      <span><code dir="ltr">/llms.txt</code><small>فهرست همهٔ صفحه‌ها با یک خط توضیح</small></span>
      <span class="ai-file__arrow" aria-hidden="true">←</span>
    </a>
    <a class="ai-file" href="/llms-full.txt">
      <span class="ai-file__icon" set:html={ic("book-open", 22)} />
      <span><code dir="ltr">/llms-full.txt</code><small>کل مستندات در یک فایل، برای ضمیمه کردن به گفتگو</small></span>
      <span class="ai-file__arrow" aria-hidden="true">←</span>
    </a>
  </div>

  <!-- ───── پرسش‌های رایج ───── -->
  <h2 id="faq">پرسش‌های رایج</h2>
  <div class="ai-faq">
    {faq.map(([q, a], i) => (
      <details open={i === 0}>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</Docs>

<style>
  .ai-mono { font-family: var(--k-font-mono); font-size: 0.9em; font-weight: var(--k-weight-semibold); color: var(--k-text-primary); }
  .t-k { color: var(--k-text-brand); } .t-c { color: var(--k-text-info); } .t-s { color: var(--k-text-warning); } .t-a { color: var(--k-text-tertiary); }
  .ai-copy { flex: none; }
  .ai-copy[data-copied] { color: var(--k-text-success); }
  .text-link { display: inline-flex; gap: var(--k-space-1); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); text-decoration: none; }
  .text-link:hover { text-decoration: underline; }

  /* ───── هیرو ───── */
  .ai-hero {
    position: relative; isolation: isolate; overflow: clip;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--k-space-8) var(--k-space-8); align-items: center;
    margin-block: var(--k-space-2) var(--k-space-6); padding: clamp(1.5rem, 3.5vw, 2.5rem) clamp(1.25rem, 3vw, 2.25rem) var(--k-space-5);
    border: 1px solid var(--k-border-primary); border-radius: var(--k-radius-2xl, var(--k-radius-xl));
    background:
      linear-gradient(var(--k-border-secondary) 1px, transparent 1px) 0 0 / 2rem 2rem,
      linear-gradient(90deg, var(--k-border-secondary) 1px, transparent 1px) 0 0 / 2rem 2rem,
      var(--k-bg-secondary);
  }
  .ai-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent, var(--k-bg-secondary) 85%); }
  .ai-hero__glow { position: absolute; inset: -30% -20% auto auto; z-index: -1; inline-size: 34rem; block-size: 26rem; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--k-text-brand) 22%, transparent), transparent), radial-gradient(closest-side at 20% 80%, color-mix(in srgb, #3d5ef8 14%, transparent), transparent); filter: blur(6px); }
  .ai-eyebrow { display: inline-flex; align-items: center; gap: var(--k-space-2); padding: 0.25rem var(--k-space-3); border: 1px solid var(--k-border-brand); border-radius: var(--k-radius-full); background: var(--k-bg-primary); color: var(--k-text-brand); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); }
  .ai-eyebrow bdi { font-family: var(--k-font-mono); color: var(--k-text-tertiary); }
  .ai-eyebrow__dot { inline-size: 7px; block-size: 7px; border-radius: 50%; background: var(--k-text-success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--k-text-success) 22%, transparent); }
  .ai-hero__title { margin: var(--k-space-4) 0 var(--k-space-3); color: var(--k-text-primary); font-size: clamp(1.6rem, 2.8vw, 2.25rem); font-weight: var(--k-weight-bold); line-height: 1.4; text-wrap: balance; }
  .ai-hero__title span { background: linear-gradient(90deg, var(--k-text-brand), color-mix(in srgb, var(--k-text-brand) 45%, #3d8bf0)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ai-hero__text { margin: 0; color: var(--k-text-tertiary); line-height: 1.95; }
