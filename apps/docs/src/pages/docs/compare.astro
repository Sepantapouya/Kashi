---
import Docs from "../../layouts/Docs.astro";

// ارزیابی بر اساس مستندات عمومی هر پروژه در آبان ۱۴۰۵. «اعلام نشده» یعنی در مستندات پیدا نشد، نه اینکه حتماً ندارد.
type Mark = "yes" | "part" | "no" | "na";
interface Cell { m: Mark; t?: string }
const systems = [
  { key: "kashi", name: "کاشی", kind: "فارسی" },
  { key: "farsi", name: "Farsi UI", kind: "فارسی" },
  { key: "shadcn", name: "shadcn/ui", kind: "بین‌المللی" },
  { key: "mui", name: "MUI", kind: "بین‌المللی" },
  { key: "antd", name: "Ant Design", kind: "بین‌المللی" },
] as const;

const rows: { group: string; label: string; cells: Cell[] }[] = [
  { group: "فارسی و راست‌به‌چپ", label: "راست‌به‌چپ", cells: [
    { m: "yes", t: "پیش‌فرض" }, { m: "yes", t: "پیش‌فرض" }, { m: "part", t: "با تنظیم rtl" }, { m: "part", t: "با تنظیم theme و افزونهٔ RTL" }, { m: "part", t: "با ConfigProvider" } ] },
  { group: "فارسی و راست‌به‌چپ", label: "تقویم و انتخاب تاریخ شمسی", cells: [
    { m: "yes", t: "داخلی؛ تاریخ، بازه، ماه و تعطیلات" }, { m: "yes", t: "Calendar پیش‌فرض شمسی" }, { m: "part", t: "با react-day-picker/persian" }, { m: "part", t: "در MUI X با AdapterDateFnsJalali" }, { m: "part", t: "با بستهٔ جامعه (antd-jalali)" } ] },
  { group: "فارسی و راست‌به‌چپ", label: "کد ملی، شبا، کارت، پلاک و کد پستی", cells: [
    { m: "yes", t: "ورودی و اعتبارسنجی، همه" }, { m: "yes", t: "کد ملی، شبا، کارت؛ پلاک به‌شکل بلوک" }, { m: "no" }, { m: "no" }, { m: "no" } ] },
  { group: "فارسی و راست‌به‌چپ", label: "پذیرش ارقام فارسی در ورودی‌ها", cells: [
    { m: "yes" }, { m: "yes" }, { m: "no" }, { m: "no" }, { m: "no" } ] },
  { group: "فارسی و راست‌به‌چپ", label: "برچسب‌ها و پیام‌های فارسی", cells: [
    { m: "yes", t: "پیش‌فرض" }, { m: "yes" }, { m: "no", t: "متن‌ها را خودتان می‌نویسید" }, { m: "part", t: "با locale فارسی" }, { m: "part", t: "با locale فارسی" } ] },
  { group: "فارسی و راست‌به‌چپ", label: "فونت فارسی همراه پکیج", cells: [
    { m: "yes", t: "وزیرمتن متغیر، همراه پکیج" }, { m: "yes", t: "وزیرمتن، با CLI" }, { m: "no" }, { m: "no" }, { m: "no" } ] },
  { group: "فارسی و راست‌به‌چپ", label: "لوگوی بانک‌ها و درگاه‌های ایرانی", cells: [
    { m: "yes", t: "۴۰ بانک و ۱۰ درگاه" }, { m: "yes", t: "در FarsiUI-Icons؛ با بلوبانک و بانکینو" }, { m: "no" }, { m: "no" }, { m: "no" } ] },
  { group: "فارسی و راست‌به‌چپ", label: "بلوک‌ها و قالب‌های آماده (داشبورد، فرم ورود…)", cells: [
    { m: "no", t: "فقط کامپوننت" }, { m: "yes", t: "بلوک و دموی فارسی" }, { m: "yes", t: "بلوک انگلیسی" }, { m: "part", t: "قالب‌های جدا، بعضی پولی" }, { m: "part", t: "Ant Design Pro" } ] },
  { group: "فنی", label: "شکل استفاده", cells: [
    { m: "yes", t: "پکیج npm یا کپی کد با shadcn" }, { m: "part", t: "کپی کد با CLI ‏farsiui" }, { m: "part", t: "کپی کد با CLI" }, { m: "yes", t: "پکیج npm" }, { m: "yes", t: "پکیج npm" } ] },
  { group: "فنی", label: "استفاده بدون React", cells: [
    { m: "yes", t: "CSS خالص و وب کامپوننت" }, { m: "no", t: "React و Tailwind" }, { m: "no", t: "React و Tailwind" }, { m: "no", t: "React" }, { m: "no", t: "React" } ] },
  { group: "فنی", label: "بررسی خودکار کنتراست در هر بیلد", cells: [
    { m: "yes", t: "بیلد ناموفق منتشر نمی‌شود" }, { m: "na" }, { m: "na" }, { m: "na" }, { m: "na" } ] },
  { group: "فنی", label: "لایسنس", cells: [
    { m: "yes", t: "MIT" }, { m: "yes", t: "MIT" }, { m: "yes", t: "MIT" }, { m: "part", t: "MIT؛ بخشی از MUI X پولی" }, { m: "yes", t: "MIT" } ] },
  { group: "بلوغ", label: "تعداد کامپوننت و اکوسیستم", cells: [
    { m: "part", t: "حدود ۷۰ کامپوننت" }, { m: "yes", t: "+۵۰۰ کامپوننت و بلوک، ۶ سبک" }, { m: "yes", t: "بزرگ" }, { m: "yes", t: "بسیار بزرگ" }, { m: "yes", t: "بسیار بزرگ" } ] },
  { group: "بلوغ", label: "جامعه و منابع آموزشی", cells: [
    { m: "part", t: "در حال شکل‌گیری" }, { m: "part", t: "در حال رشد" }, { m: "yes" }, { m: "yes" }, { m: "yes" } ] },
];
const groups = [...new Set(rows.map((r) => r.group))];
// امتیاز هر سامانه از همین جدول: «دارد» یک، «بخشی» نیم؛ «اعلام نشده» صفر
const fa = (n: number | string) => String(n).replace(/\d/g, (d) => "۰۱۲۳۴۵۶۷۸۹"[+d]).replace(".", "٫");
const scoreOf = (i: number) => rows.reduce((n, r) => n + (r.cells[i].m === "yes" ? 1 : r.cells[i].m === "part" ? 0.5 : 0), 0);
const scores = systems.map((sys, i) => ({ ...sys, score: scoreOf(i), persian: rows.filter((r) => r.group === "فارسی و راست‌به‌چپ").reduce((n, r) => n + (r.cells[i].m === "yes" ? 1 : r.cells[i].m === "part" ? 0.5 : 0), 0) }));
const persianTotal = rows.filter((r) => r.group === "فارسی و راست‌به‌چپ").length;
const MARK = { yes: "دارد", part: "بخشی یا با تنظیم", no: "ندارد", na: "اعلام نشده" } as const;
const PATHS = { yes: "m5 10.5 3.2 3L15 7", part: "M5 10h10", no: "m6 6 8 8M14 6l-8 8", na: "M5.5 10h.01M10 10h.01M14.5 10h.01" };
const icon = (m: Mark) => `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="${PATHS[m]}"/></svg>`;
const headings = [
  { depth: 2, slug: "score", text: "خلاصه" },
  { depth: 2, slug: "table", text: "جدول مقایسه" },
  { depth: 2, slug: "when", text: "کی سراغ کدام برویم" },
  { depth: 2, slug: "method", text: "روش ارزیابی" },
];
---
<Docs title="مقایسه با دیگران" description="کاشی در کنار دیزاین‌سیستم‌های فارسی و بین‌المللی؛ با صداقت دربارهٔ جایی که بهترین انتخاب نیست." headings={headings}>
  <h2 id="score">خلاصه</h2>
  <p>امتیاز هر سامانه از همین جدول پایین حساب شده: «دارد» یک امتیاز، «بخشی یا با تنظیم» نیم امتیاز. نوار دوم فقط معیارهای فارسی و راست‌به‌چپ است.</p>
  <ul class="cmp-score" role="list">
    {scores.map((sc, i) => (
      <li class:list={["cmp-score__item", { "cmp-score__item--us": i === 0 }]} style={`--i: ${i}`} data-col={i}>
        <div class="cmp-score__head"><b>{sc.name}</b><span class="k-badge k-badge--sm">{sc.kind}</span></div>
        <div class="k-meter" role="meter" aria-valuemin="0" aria-valuemax={rows.length} aria-valuenow={sc.score} aria-label={`امتیاز کل ${sc.name}`}>
          <div class="k-meter__head"><span class="k-meter__label">همهٔ معیارها</span><span class="k-meter__value">{fa(sc.score)} <span>از {fa(rows.length)}</span></span></div>
          <div class="k-meter__track"><div class="k-meter__fill" style={`inline-size: ${(sc.score / rows.length) * 100}%`}></div></div>
        </div>
        <div class="k-meter cmp-score__fa" role="meter" aria-valuemin="0" aria-valuemax={persianTotal} aria-valuenow={sc.persian} aria-label={`امتیاز فارسی ${sc.name}`}>
          <div class="k-meter__head"><span class="k-meter__label">فارسی و RTL</span><span class="k-meter__value">{fa(sc.persian)} <span>از {fa(persianTotal)}</span></span></div>
          <div class="k-meter__track"><div class="k-meter__fill" style={`inline-size: ${(sc.persian / persianTotal) * 100}%`}></div></div>
        </div>
      </li>
    ))}
  </ul>

  <h2 id="table">جدول مقایسه</h2>
  <div class="cmp-tools">
    <div class="k-chips" role="group" aria-label="گروه معیارها">
      <button type="button" class="k-chip" aria-pressed="true" data-cmp-group="all">همه</button>
      {groups.map((g) => <button type="button" class="k-chip" aria-pressed="false" data-cmp-group={g}>{g}</button>)}
    </div>
  </div>
  <ul class="cmp-legend" role="list">
    {(["yes", "part", "no", "na"] as const).map((m) => <li><span class={`mk mk--${m}`} aria-hidden="true" set:html={icon(m)} />{MARK[m]}</li>)}
  </ul>

  <div class="cmp-wrap" role="region" aria-label="جدول مقایسهٔ دیزاین‌سیستم‌ها" tabindex="0">
    <table class="cmp">
      <thead>
        <tr>
          <th scope="col" class="cmp__corner">ویژگی</th>
          {systems.map((s) => (
            <th scope="col" class:list={["cmp__sys", { "cmp__sys--us": s.key === "kashi" }]} data-col={systems.indexOf(s)}>
              <span class="cmp__name">{s.name}</span>
              <span class="cmp__kind">{s.kind}</span>
            </th>
          ))}
        </tr>
      </thead>
      {groups.map((g) => (
        <tbody data-group={g}>
          <tr class="cmp__group"><th scope="rowgroup" colspan={systems.length + 1}>{g}</th></tr>
          {rows.filter((r) => r.group === g).map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {r.cells.map((c, i) => (
                <td class:list={{ "cmp__us": i === 0 }} data-col={i}>
                  <span class="cmp__cell">
                    <span class={`mk mk--${c.m}`} aria-hidden="true" set:html={icon(c.m)} />
                    <span class="k-sr-only">{MARK[c.m]}{c.t ? "، " : ""}</span>
                    {c.t && <span class="cmp__note">{c.t}</span>}
                  </span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>

  <h2 id="when">کی سراغ کدام برویم</h2>
  <div class="cmp-cards">
    <article class="cmp-card cmp-card--us">
      <span class="cmp-card__logo" aria-hidden="true">ک</span>
      <h3>کاشی را انتخاب کنید اگر</h3>
      <ul>
        <li>محصول شما فارسی و راست‌به‌چپ است و نمی‌خواهید RTL را بعداً وصله کنید.</li>
        <li>تاریخ شمسی، کد ملی، شبا، کارت بانکی یا پلاک در فرم‌هایتان هست.</li>
        <li>دسترس‌پذیری برایتان شرط است، نه گزینه.</li>
        <li>بخشی از محصول بدون React است (وردپرس، HTML، Vue یا فریم‌ورک دیگر)؛ فیلدهای فارسی و تقویم شمسی آنجا هم به‌شکل وب کامپوننت هستند.</li>
        <li>یک پکیج نسخه‌دار می‌خواهید که با یک به‌روزرسانی، اصلاحات به همهٔ پروژه‌ها برسد، نه کدی که در هر پروژه جدا نگه داشته شود.</li>
      </ul>
    </article>
    <article class="cmp-card">
      <span class="cmp-card__logo" aria-hidden="true">M</span>
      <h3>MUI یا Ant Design بهتر است اگر</h3>
      <ul>
        <li>به صدها کامپوننت پیشرفته مثل جدول داده با ویرایش و گروه‌بندی نیاز دارید.</li>
        <li>تیم شما از قبل با آن‌ها کار می‌کند و اکوسیستم و منابع آموزشی بزرگ برایتان مهم‌تر است.</li>
        <li>محصول اصلاً فارسی نیست، یا RTL فقط یک حالت فرعی است.</li>
      </ul>
    </article>
    <article class="cmp-card">
      <span class="cmp-card__logo" aria-hidden="true">F</span>
      <h3>Farsi UI بهتر است اگر</h3>
      <ul>
        <li>پروژه با React و Tailwind است و می‌خواهید کد هر کامپوننت را مستقیم در پروژه داشته باشید و تغییرش دهید.</li>
        <li>به بلوک‌ها و صفحه‌های آمادهٔ فارسی (داشبورد، فرم‌ها) و تعداد زیادی کامپوننت نیاز دارید.</li>
        <li>لوگوی بانک‌های دیجیتال مثل بلوبانک یا آیکون برندهای ایرانی لازم دارید.</li>
      </ul>
    </article>
    <article class="cmp-card">
      <span class="cmp-card__logo" aria-hidden="true">s</span>
      <h3>shadcn/ui بهتر است اگر</h3>
      <ul>
        <li>محصول بین‌المللی است و فارسی فقط یکی از زبان‌هاست.</li>
        <li>اکوسیستم بزرگ و بلوک‌های آمادهٔ انگلیسی برایتان مهم است.</li>
      </ul>
    </article>
  </div>
  <p>این‌ها رقیب مطلق هم نیستند: می‌توانید ابزارهای <a href="/docs/persian/utilities/">@kashi-ui/persian</a> (تاریخ شمسی، اعتبارسنجی‌ها، ارقام) را کنار هر دیزاین‌سیستم دیگری استفاده کنید.</p>

  <h2 id="method">روش ارزیابی</h2>
  <p>ستون‌ها بر اساس مستندات عمومی هر پروژه در آبان ۱۴۰۵ پر شده‌اند. «اعلام نشده» یعنی چیزی در مستندات پیدا نکردیم، نه اینکه حتماً ندارد. پروژه‌ها مدام به‌روز می‌شوند؛ اگر خطایی دیدید، لطفاً <a href="https://github.com/Sepantapouya/Kashi/issues">در GitHub گزارش دهید</a> تا اصلاح شود.</p>
  <ul>
    <li><a href="https://github.com/MiladJoodi/FarsiUI">مخزن Farsi UI</a>، <a href="https://farsiui.ir/docs">مستندات</a> و <a href="https://github.com/MiladJoodi/FarsiUI-Icons">FarsiUI-Icons</a></li>
    <li><a href="https://ui.shadcn.com/docs/rtl">پشتیبانی RTL در shadcn/ui</a></li>
    <li><a href="https://mui.com/x/react-date-pickers/calendar-systems/">تقویم‌های غیرمیلادی در MUI X</a></li>
    <li><a href="https://ant.design/components/date-picker">DatePicker در Ant Design</a> و بستهٔ جامعهٔ <a href="https://npmjs.com/package/antd-jalali">antd-jalali</a></li>
  </ul>
</Docs>

<script>
  const table = document.querySelector<HTMLTableElement>(".cmp");
  if (table) {
    // فیلتر گروه و «فقط تفاوت‌ها»
    const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-cmp-group]")];
    let group = "all";
    const apply = () => {
      table.querySelectorAll<HTMLElement>("tbody").forEach((tb) => (tb.hidden = group !== "all" && tb.dataset.group !== group));
    };
    chips.forEach((c) => c.addEventListener("click", () => {
      group = c.dataset.cmpGroup!;
      chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
      apply();
    }));

    // نگه داشتن ماوس روی سرستون یا کارت امتیاز، کل ستون را روشن می‌کند
    const light = (col: string | null) => table.querySelectorAll<HTMLElement>("[data-col]").forEach((el) => el.toggleAttribute("data-lit", col !== null && el.dataset.col === col));
    document.querySelectorAll<HTMLElement>(".cmp__sys, .cmp-score__item").forEach((el) => {
      el.addEventListener("pointerenter", () => light(el.dataset.col ?? null));
      el.addEventListener("pointerleave", () => light(null));
    });
  }
</script>

<style>
  .cmp-score { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: var(--k-space-3); margin: var(--k-space-5) 0 var(--k-space-8); padding: 0; list-style: none; }
  .cmp-score__item { display: grid; align-content: start; gap: var(--k-space-3); padding: var(--k-space-4) var(--k-space-3); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: var(--k-bg-primary); transition: border-color var(--k-duration-normal), translate var(--k-duration-slow) var(--k-ease-spring); }
  .cmp-score__item:hover { border-color: var(--k-border-primary); }
  .cmp-score__item--us { border-color: color-mix(in srgb, var(--k-text-brand) 45%, transparent); background: linear-gradient(180deg, color-mix(in srgb, var(--k-text-brand) 9%, transparent), transparent 60%), var(--k-bg-primary); box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--k-text-brand) 45%, transparent); }
  .cmp-score__head { display: grid; justify-items: start; gap: var(--k-space-1); }
  .cmp-score .k-meter__head { flex-wrap: nowrap; }
  .cmp-score .k-meter__label, .cmp-score .k-meter__value { font-size: var(--k-text-xs); white-space: nowrap; }
  .cmp-score__head b { color: var(--k-text-primary); }
  .cmp-score__item:not(.cmp-score__item--us) .k-meter__fill { background: var(--k-text-tertiary); }
  .cmp-score__fa .k-meter__fill { background: var(--k-text-info) !important; }
  .cmp-score__item--us .cmp-score__fa .k-meter__fill { background: var(--k-text-brand) !important; opacity: 0.7; }
  @media (prefers-reduced-motion: no-preference) {
    .cmp-score .k-meter__fill { animation: cmp-grow 900ms var(--k-ease-standard) both; animation-delay: calc(var(--i) * 90ms + 200ms); }
    .cmp-score__item:hover { translate: 0 -2px; }
  }
  @keyframes cmp-grow { from { inline-size: 0; } }

  .cmp-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-space-3); margin-block: var(--k-space-4) var(--k-space-2); }
  .cmp [data-lit] { box-shadow: inset 0 0 0 9999px color-mix(in srgb, var(--k-text-brand) 7%, transparent); }
  .cmp thead [data-lit] .cmp__name { color: var(--k-text-brand); }
  .cmp tbody tr { transition: opacity var(--k-duration-normal); }
  .cmp-legend { display: flex; flex-wrap: wrap; gap: var(--k-space-2) var(--k-space-5); margin: var(--k-space-4) 0; padding: 0; list-style: none; color: var(--k-text-tertiary); font-size: var(--k-text-sm); }
  .cmp-legend li { display: inline-flex; align-items: center; gap: var(--k-space-1_5); }
  .cmp-wrap { margin-block: var(--k-space-4) var(--k-space-6); overflow-x: auto; border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); box-shadow: var(--k-shadow-xs), var(--k-highlight); scrollbar-width: thin; }
  .cmp-wrap:focus-visible { outline: 2px solid transparent; box-shadow: var(--k-ring-brand); }
  .cmp { inline-size: 100%; min-inline-size: 42rem; border-collapse: separate; border-spacing: 0; font-size: var(--k-text-sm); line-height: 1.6; }
  .cmp th, .cmp td { padding: var(--k-space-3) var(--k-space-3); border-block-end: 1px solid var(--k-border-secondary); text-align: start; vertical-align: middle; }
  .cmp tbody:last-child tr:last-child > * { border-block-end: 0; }
  .cmp thead th { position: sticky; inset-block-start: 0; z-index: 2; background: var(--k-bg-secondary); }
  .cmp__corner { color: var(--k-text-tertiary); font-weight: var(--k-weight-semibold); }
  .cmp__sys { min-inline-size: 0; }
  .cmp__name { display: block; color: var(--k-text-primary); font-weight: var(--k-weight-bold); }
  .cmp__kind { display: block; color: var(--k-text-tertiary); font-size: var(--k-text-xs); font-weight: var(--k-weight-regular); }
  /* ستون کاشی برجسته */
  .cmp__sys--us, .cmp__us { background: color-mix(in srgb, var(--k-bg-brand) 8%, var(--k-bg-primary)); }
