---
import Docs from "../../layouts/Docs.astro";
import { icons, categories, iconSvg } from "@kashi-ui/icons";
import { toFaDigits } from "@kashi-ui/persian";
import { author } from "../../data/author";
import pkg from "../../../../../packages/react/package.json";

// عددهای کیت؛ تعداد آیکون‌ها، دسته‌ها و نسخه از خود پکیج‌ها می‌آید تا با هر انتشار به‌روز بماند
const fa = (n: number) => toFaDigits(n.toLocaleString("en-US").replace(/,/g, "٬"));
const iconCount = Object.keys(icons).length;
const catCount = Object.keys(categories).length;
const ic = (name: string, size = 20) => iconSvg(name, { size }) ?? "";
const icv = (name: string, variant: string, size = 18) => iconSvg(name, { size, variant: variant as never }) ?? "";
const kitZip = "/downloads/kashi-figma-plugin.zip";
const iconsZip = "/downloads/kashi-icons-figma-plugin.zip";
const webExporter = "/icon-exporter.html";

const stats: [string, string][] = [
  [fa(272), "متغیر"],
  [fa(78), "کامپوننت"],
  [fa(748), "حالت (variant)"],
  [fa(iconCount), "آیکون در ۶ سبک"],
];

// متن هر کارت کوتاه: یک عنوان و حداکثر دو خط
const kitFeatures: [string, string, string][] = [
  ["variable", "همه‌چیز Variable", "رنگ، فاصله، گردی، فونت و سایه؛ یک متغیر را عوض کنید، کل کیت عوض می‌شود."],
  ["grid", "هر کامپوننت، یک صفحه", "همهٔ حالت‌ها در جدولی مرتب با برچسب ردیف و ستون."],
  ["ruler", "پیکسل‌به‌پیکسل با کد", "بیش از ۱۷۰۰ بخش با CSS واقعی کاشی اندازه‌گیری و تست شده‌اند."],
  ["globe", "فارسی از روز اول", "راست‌به‌چپ، کارت بانکی با ۵۰ لوگو، شبا، پلاک و تقویم شمسی."],
  ["sparkle", `${fa(iconCount)} آیکون`, `در ${fa(catCount)} دسته و پوشه‌بندی‌شده در پنل Assets، همان شکل کد.`],
  ["refresh", "به‌روزرسانی درجا", "نسخهٔ تازه را در همان فایل اجرا کنید؛ instance ها وصل می‌مانند."],
];

const iconFeatures: [string, string, string][] = [
  ["search", "جست‌وجوی فارسی و انگلیسی", "در نام، عنوان، کلیدواژه و دسته؛ «ویلچر» و wheelchair هر دو پیدا می‌شوند."],
  ["layers", "شش سبک، هر رنگ و اندازه", "خطی، توپر، حجمی، دورنگ، شکسته و منحنی؛ با ضخامت خط دلخواه."],
  ["plus", "کشیدن روی بوم", "با دوبار کلیک یا کشیدن، داخل فریم انتخاب‌شده می‌نشیند."],
  ["download", "SVG، PNG و ZIP", "PNG در ۱، ۲ و ۳ برابر؛ چند آیکون با هم در یک فایل ZIP."],
  ["copy", "کپی کد", "کد SVG، کامپوننت React یا iconSvg، با همان سبک و اندازه."],
  ["star", "علاقه‌مندی و اخیر", "آیکون‌های پرکاربرد همیشه دم دست؛ تنظیمات هم می‌ماند."],
];

const pages = ["Colors", "Typography", "Spacing", "Icons", "Bank logos", "Button", "Input", "Date picker", "Card number", "IBAN", "Plate", "Alert", "Dialog", "Table", "Tabs", "…"];

const faq: [string, string][] = [
  ["دو پلاگین چه فرقی دارند؟", "Kashi UI Kit کل دیزاین‌سیستم را در فایل شما می‌سازد: متغیرها، کامپوننت‌ها و صفحهٔ آیکون‌ها. Kashi Icons فقط برای پیدا کردن و برداشتن آیکون است و چیزی در فایل نمی‌سازد؛ برای هر فایلی، حتی بدون کیت."],
  ["در نسخهٔ مرورگر فیگما کار می‌کند؟", "پلاگین‌هایی که از روی کامپیوتر وارد می‌شوند فقط در اپ دسکتاپ فیگما اجرا می‌شوند. فایل ساخته‌شده را بعداً در مرورگر هم باز کنید، مشکلی ندارد. برای آیکون‌ها، نسخهٔ وب پلاگین هم هست."],
  ["با پلن رایگان فیگما چه فرقی دارد؟", "پلن رایگان برای هر مجموعهٔ متغیر فقط یک mode اجازه می‌دهد. Kashi UI Kit در این حالت فقط تمی را که انتخاب کرده‌اید می‌سازد؛ همه‌چیز دیگر کامل است."],
  ["فونت پولی خودم را می‌توانم بگذارم؟", "بله. نام فونتی را که روی سیستم نصب است در پنل پلاگین بنویسید، یا متغیر font/family/sans را عوض کنید."],
  ["برای همهٔ تیم چطور در دسترس بگذارم؟", "فایل کیت را از پنل Assets فیگما Publish کنید. با هر نسخهٔ جدید، پلاگین را در همان فایل اجرا و دوباره Publish کنید."],
];

const headings = [
  { depth: 2, slug: "ui-kit", text: "کیت کامپوننت‌ها" },
  { depth: 2, slug: "icons-plugin", text: "پلاگین آیکون‌ها" },
  { depth: 2, slug: "install", text: "نصب" },
  { depth: 2, slug: "update", text: "به‌روزرسانی کیت" },
  { depth: 2, slug: "customize", text: "سفارشی‌سازی" },
  { depth: 2, slug: "to-code", text: "از فیگما تا کد" },
  { depth: 2, slug: "faq", text: "پرسش‌های رایج" },
];

// نمونهٔ زندهٔ پنل آیکون‌ها با آیکون‌های واقعی کاشی
const mockIcons = ["home", "search", "bell", "wallet", "calendar", "camera", "chat", "map-pin", "si-o-se-pol", "gereh-chini", "shopping-bag", "rocket", "music", "heart", "lock", "send", "user", "settings"];
const mockStyles: [string, string][] = [["light", "خطی"], ["bold", "توپر"], ["bulk", "حجمی"], ["two-tone", "دورنگ"]];
---
<Docs title="پلاگین‌های فیگما" description="کل دیزاین‌سیستم کاشی یا فقط آیکون‌هایش را در فیگما داشته باشید؛ هر دو رایگان و از همان منبع کد." headings={headings}>
  <!-- ── دو پلاگین ─────────────────────────────────────────── -->
  <section class="fg-pick" aria-label="پلاگین‌ها">
    <article class="fg-card">
      <div class="fg-card__art fg-kit" aria-hidden="true">
        <div class="fg-kit__window">
          <div class="fg-kit__bar"><i></i><i></i><i></i></div>
          <div class="fg-kit__body">
            <ul class="fg-kit__pages"><li>🎨 Colors</li><li>🧩 Icons</li><li class="on">🔘 Button</li><li>📝 Input</li><li>🇮🇷 Card</li></ul>
            <div class="fg-kit__canvas">
              <div class="fg-kit__set">
                {["primary", "secondary"].map((v) => (
                  <div class="fg-kit__row">{["sm", "md"].map((s) => <span class={`k-btn k-btn--${v} k-btn--${s}`}>ثبت</span>)}</div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="fg-card__body">
        <span class="fg-card__eyebrow">Kashi UI Kit</span>
        <h2 class="fg-card__title">کل کیت، با یک کلیک</h2>
        <p class="fg-card__text">متغیرها، {fa(78)} کامپوننت با همهٔ حالت‌ها و صفحهٔ آیکون‌ها را مستقیم از روی کد کاشی در فایل شما می‌سازد.</p>
        <div class="fg-card__actions">
          <a class="k-btn k-btn--primary" href={kitZip} download><span set:html={ic("download", 18)} />دانلود کیت</a>
          <a class="k-btn k-btn--tertiary" href="#ui-kit">بیشتر</a>
        </div>
      </div>
    </article>

    <article class="fg-card fg-card--new">
      <div class="fg-card__art fg-ip" aria-hidden="true">
        <div class="fg-ip__panel">
          <div class="fg-ip__search"><span set:html={ic("search", 14)} />جست‌وجو در آیکون‌ها</div>
          <div class="fg-ip__styles">{mockStyles.map(([v, l], i) => <span class={i === 2 ? "on" : undefined}><i set:html={icv("heart", v, 13)} />{l}</span>)}</div>
          <div class="fg-ip__grid">{mockIcons.slice(0, 12).map((n, i) => <i class={i === 8 ? "on" : undefined} set:html={icv(n, "bulk", 18)} />)}</div>
          <div class="fg-ip__btn"><span set:html={ic("plus", 14)} />افزودن به فیگما</div>
        </div>
      </div>
      <div class="fg-card__body">
        <span class="fg-card__eyebrow">Kashi Icons <em>تازه</em></span>
        <h2 class="fg-card__title">فقط آیکون‌ها، سریع</h2>
        <p class="fg-card__text">{fa(iconCount)} آیکون در شش سبک؛ جست‌وجو کنید، بکشید روی بوم یا SVG و PNG بگیرید. بدون ساختن چیزی در فایل.</p>
        <div class="fg-card__actions">
          <a class="k-btn k-btn--primary" href={iconsZip} download><span set:html={ic("download", 18)} />دانلود پلاگین</a>
          <a class="k-btn k-btn--tertiary" href={webExporter}>نسخهٔ وب</a>
        </div>
      </div>
    </article>
  </section>

  <dl class="fg-stats">
    {stats.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}
  </dl>
  <p class="fg-meta">رایگان و متن‌باز (MIT) · <bdi dir="ltr">v{pkg.version}</bdi> · برای اپ دسکتاپ فیگما</p>

  <!-- ── کیت ───────────────────────────────────────────────── -->
  <h2 id="ui-kit">کیت کامپوننت‌ها</h2>
  <p>پلاگین <strong>Kashi UI Kit</strong> رنگ‌ها، فونت، فاصله‌ها و همهٔ کامپوننت‌ها را از روی کد کاشی می‌سازد؛ آنچه طراح در فیگما می‌بیند همان است که برنامه‌نویس در کد می‌سازد. ساختن کیت حدود یک دقیقه طول می‌کشد.</p>
  <ul class="fg-features" role="list">
    {kitFeatures.map(([icon, title, text]) => (
      <li>
        <span class="fg-features__icon" set:html={ic(icon, 20)} />
        <div><strong>{title}</strong><p>{text}</p></div>
      </li>
    ))}
  </ul>

  <!-- ── پلاگین آیکون‌ها ─────────────────────────────────── -->
  <h2 id="icons-plugin">پلاگین آیکون‌ها</h2>
  <p>وقتی فقط آیکون لازم دارید، <strong>Kashi Icons</strong> سبک‌تر است: چیزی در فایل نمی‌سازد و در هر فایلی کار می‌کند، حتی بدون کیت. همان آیکون‌های پکیج <code>@kashi-ui/icons</code>، با همان شکل.</p>
  <div class="fg-icons">
    <div class="fg-icons__mock" aria-hidden="true">
      <div class="fg-ipl">
        <div class="fg-ipl__top"><span class="fg-ipl__logo" />آیکون‌های کاشی<em>{fa(iconCount)} آیکون</em></div>
        <div class="fg-ipl__search"><span set:html={ic("search", 15)} />جست‌وجو، فارسی یا انگلیسی<kbd>/</kbd></div>
        <div class="fg-ipl__styles">{mockStyles.map(([v, l], i) => <span class={i === 3 ? "on" : undefined}>{l}</span>)}</div>
        <div class="fg-ipl__grid">{mockIcons.map((n, i) => <i class={i === 4 ? "on" : undefined} set:html={icv(n, "two-tone", 20)} />)}</div>
        <div class="fg-ipl__ins">
          <span class="fg-ipl__pv" set:html={icv("calendar", "two-tone", 26)} />
          <div><b>تقویم</b><code>calendar</code></div>
          <span class="fg-ipl__sw"><i /><i /><i /><i /></span>
        </div>
        <div class="fg-ipl__actions"><span class="fg-ipl__primary"><i set:html={ic("plus", 14)} />افزودن به فیگما</span><span>SVG</span><span>PNG</span></div>
      </div>
    </div>
    <ul class="fg-features fg-features--list" role="list">
      {iconFeatures.map(([icon, title, text]) => (
        <li>
          <span class="fg-features__icon" set:html={ic(icon, 20)} />
          <div><strong>{title}</strong><p>{text}</p></div>
        </li>
      ))}
    </ul>
  </div>
  <div class="fg-web">
    <span class="fg-web__icon" set:html={ic("globe", 20)} />
    <div>
      <strong>بیرون از فیگما هم</strong>
      <p>همین پنل در مرورگر باز می‌شود؛ برای دانلود SVG و PNG یا کپی کد، بدون نصب چیزی.</p>
    </div>
    <a class="k-btn k-btn--secondary k-btn--sm" href={webExporter}>باز کردن نسخهٔ وب</a>
  </div>

  <!-- ── نصب ──────────────────────────────────────────────── -->
  <h2 id="install">نصب</h2>
  <p>هر دو پلاگین یک بار و به یک شکل نصب می‌شوند، در <strong>اپ دسکتاپ</strong> فیگما.</p>
  <ol class="fg-steps" role="list">
    <li>
      <span class="fg-steps__n">۱</span>
      <strong>دانلود</strong>
      <p>فایل zip را دانلود و از حالت فشرده خارج کنید.</p>
      <div class="fg-steps__links">
        <a href={kitZip} download><span set:html={ic("download", 14)} />کیت</a>
        <a href={iconsZip} download><span set:html={ic("download", 14)} />آیکون‌ها</a>
      </div>
    </li>
    <li>
      <span class="fg-steps__n">۲</span>
      <strong>وارد کردن</strong>
      <p class="fg-path" dir="ltr"><kbd class="k-kbd">Plugins</kbd><span>›</span><kbd class="k-kbd">Development</kbd><span>›</span><kbd class="k-kbd">Import plugin from manifest…</kbd></p>
      <p>و فایل <code>manifest.json</code> پوشه را انتخاب کنید.</p>
    </li>
    <li>
      <span class="fg-steps__n">۳</span>
      <strong>اجرا</strong>
      <p>از <bdi dir="ltr">Plugins › Development</bdi> پلاگین را باز کنید. در کیت تم و فونت را انتخاب کنید و «ساخت کیت» را بزنید.</p>
    </li>
  </ol>
  <div class="k-alert k-alert--info k-alert--sm">
    <span class="k-alert__icon" set:html={ic("info", 16)} />
    <div class="k-alert__content"><p class="k-alert__description">برای فایل‌های دیگر تیم، فایل کیت را از پنل Assets فیگما <strong>Publish</strong> کنید تا کتابخانهٔ کاشی همه‌جا در دسترس باشد.</p></div>
  </div>

  <!-- ── به‌روزرسانی ──────────────────────────────────────── -->
  <h2 id="update">به‌روزرسانی کیت</h2>
  <p>برای نسخهٔ جدید فایل تازه نسازید: پلاگین جدید را در <strong>همان فایل</strong> اجرا کنید. پنل در پایان می‌گوید چند مورد اضافه و چند مورد به‌روز شد.</p>
  <div class="fg-update">
    <div class="fg-update__main">
      <span class="fg-update__label" dir="ltr">❖ Button · main</span>
      <span class="k-btn k-btn--primary">پرداخت امن</span>
      <span class="fg-update__tag">به‌روز شد</span>
    </div>
    <div class="fg-update__links" aria-hidden="true">{[0, 1, 2].map(() => <i />)}</div>
    <ul class="fg-update__instances" role="list" aria-label="instance ها در طرح‌های شما">
      {["سبد خرید", "کیف پول", "اشتراک"].map((p) => (
        <li><span>صفحهٔ {p}</span><span class="k-btn k-btn--primary k-btn--sm">پرداخت امن</span></li>
      ))}
    </ul>
  </div>
  <ul class="fg-checks" role="list">
    {[
      "کامپوننت‌های تازه صفحهٔ خودشان را می‌گیرند.",
      "کامپوننت‌های بهترشده درجا عوض می‌شوند و instance ها وصل می‌مانند.",
      "متن‌هایی که از پنل Properties عوض کرده‌اید حفظ می‌شوند.",
      "صفحه‌های خودتان دست نمی‌خورند.",
    ].map((t) => <li><span set:html={ic("check", 16)} />{t}</li>)}
  </ul>
  <p class="fg-note">فقط رنگ یا فونت را می‌خواهید به‌روز کنید؟ تیک «صفحه‌های کامپوننت» را بردارید تا فقط متغیرها در چند ثانیه به‌روز شوند.</p>

  <!-- ── سفارشی‌سازی ─────────────────────────────────────── -->
  <h2 id="customize">سفارشی‌سازی</h2>
  <div class="fg-custom">
    <article>
      <div class="fg-custom__art fg-art-theme" aria-hidden="true"><span /><span /></div>
      <div><strong>تم تیره و روشن</strong><p>فریم را انتخاب کنید و در Appearance، <code>Kashi · Theme</code> را روی Dark یا Light بگذارید.</p></div>
    </article>
    <article>
      <div class="fg-custom__art fg-art-brand" aria-hidden="true">{["#0b8077", "#2740ed", "#dd5e02", "#e51d2a"].map((c) => <i style={`background:${c}`} />)}</div>
      <div><strong>رنگ برند</strong><p><code>color/brand/*</code> را به رنگ دیگری از پالت وصل کنید؛ دکمه‌ها و فیلدها با هم عوض می‌شوند.</p></div>
    </article>
    <article>
      <div class="fg-custom__art fg-art-font" aria-hidden="true"><span>آ</span><span>ب</span><span>پ</span></div>
      <div><strong>فونت دلخواه، حتی پولی</strong><p>نام فونت نصب‌شده را در پنل بنویسید؛ اگر پیدا نشود، وزیرمتن جایش می‌نشیند.</p></div>
    </article>
    <article>
      <div class="fg-custom__art fg-art-radius" aria-hidden="true"><i style="border-radius:0" /><i style="border-radius:6px" /><i style="border-radius:14px" /></div>
      <div><strong>گردی، تراکم و اندازهٔ متن</strong><p>هر کدام یک mode در مجموعهٔ خودش؛ همان پیچ‌هایی که در CSS کاشی هست.</p></div>
    </article>
  </div>

  <!-- ── از فیگما تا کد ──────────────────────────────────── -->
  <h2 id="to-code">از فیگما تا کد</h2>
  <p>نام کامپوننت‌ها و ویژگی‌ها همان prop های React است و هر کامپوننت در فیگما لینک Documentation به صفحهٔ خودش در همین سایت دارد.</p>
  <div class="k-table-wrap">
    <table class="k-table">
      <thead><tr><th>فیگما</th><th>کد</th></tr></thead>
      <tbody>
        {[
          ["Button → Variant=Primary, Size=md", '<Button variant="primary" size="md">'],
          ["Input → Size=lg, State=Error", '<Input size="lg" error="…">'],
          [`Icon / ${categories[icons["credit-card"].category as keyof typeof categories]} / credit-card`, '<IconCreditCard />'],
          ["bg/brand (Variable)", "var(--k-bg-brand)"],
        ].map(([a, b]) => <tr><td><bdi dir="ltr">{a}</bdi></td><td><code dir="ltr">{b}</code></td></tr>)}
      </tbody>
    </table>
  </div>
  <p class="fg-pages-title">صفحه‌های فایل کیت</p>
  <ul class="fg-pages" role="list" dir="ltr">{pages.map((p) => <li>{p}</li>)}</ul>

  <!-- ── پرسش‌ها ─────────────────────────────────────────── -->
  <h2 id="faq">پرسش‌های رایج</h2>
  <div class="fg-faq">
    {faq.map(([q, a], i) => (
      <details open={i === 0}>
        <summary>{q}<span set:html={ic("chevron-down", 18)} /></summary>
        <p>{a}</p>
      </details>
    ))}
  </div>

  <!-- ── دعوت ───────────────────────────────────────────── -->
  <section class="fg-cta" aria-label="دانلود">
    <div>
      <p class="fg-cta__title">هر دو رایگان‌اند</p>
      <p>کد هر دو پلاگین در GitHub باز است؛ پیشنهاد و گزارش مشکل را همان‌جا بنویسید.</p>
    </div>
    <div class="fg-cta__actions">
      <a class="k-btn k-btn--primary" href={kitZip} download><span set:html={ic("download", 18)} />دانلود کیت</a>
      <a class="k-btn k-btn--primary" href={iconsZip} download><span set:html={ic("download", 18)} />دانلود آیکون‌ها</a>
