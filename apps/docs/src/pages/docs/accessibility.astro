---
import fs from "node:fs";
import path from "node:path";
import Docs from "../../layouts/Docs.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { iconSvg } from "@kashi-ui/icons";
import { palette, themes } from "@kashi-ui/tokens";
import { toFaDigits } from "@kashi-ui/persian";

const fa = (n: number | string) => toFaDigits(String(n));
const ic = (name: string, size = 20) => iconSvg(name, { size }) ?? "";

// ── کنتراست واقعی توکن‌ها؛ همان محاسبهٔ packages/tokens/contrast.mjs که بیلد را نگه می‌دارد
type Theme = Record<string, string>;
const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const lin = (c: number) => ((c /= 255) <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const lum = ([r, g, b]: number[]) => 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
const ratio = (a: number[], b: number[]) => {
  const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
  return (x + 0.05) / (y + 0.05);
};
const over = (fg: number[], a: number, bg: number[]) => fg.map((c, i) => Math.round(c * a + bg[i] * (1 - a)));
function resolve(theme: Theme, value: string, backdrop: number[]): number[] {
  let m;
  if ((m = value.match(/^var\(--k-([a-z]+)-(\d+)\)$/))) {
    const scale = m[1] === "brand" ? "firoozeh" : m[1];
    return hex((palette as Record<string, Record<string, string>>)[scale][m[2]]);
  }
  if ((m = value.match(/^var\(--k-([a-z-]+)\)$/))) return resolve(theme, theme[m[1]], backdrop);
  if ((m = value.match(/^rgb\((\d+) (\d+) (\d+) \/ ([\d.]+)\)$/))) return over([+m[1], +m[2], +m[3]], +m[4], backdrop);
  if ((m = value.match(/^color-mix\(in srgb, (var\([^)]+\)) (\d+)%, transparent\)$/)))
    return over(resolve(theme, m[1], backdrop), +m[2] / 100, backdrop);
  throw new Error(`cannot resolve ${value}`);
}
const rgb = (c: number[]) => `rgb(${c.join(" ")})`;

const samples: [string, string, string, number][] = [
  ["متن اصلی", "text-primary", "bg-primary", 4.5],
  ["متن دوم", "text-secondary", "bg-primary", 4.5],
  ["متن کم‌رنگ", "text-tertiary", "bg-primary", 4.5],
  ["لینک و برند", "text-brand", "bg-primary", 4.5],
  ["دکمهٔ اصلی", "text-on-brand", "bg-brand", 4.5],
  ["حاشیهٔ فیلد", "border-input", "bg-primary", 3],
];
const panels = (["light", "dark"] as const).map((name) => {
  const theme = themes[name] as Theme;
  const base = resolve(theme, theme["bg-primary"], [0, 0, 0]);
  const rows = samples.map(([label, fg, bg, min]) => {
    const b = resolve(theme, theme[bg], base);
    const f = resolve(theme, theme[fg], b);
    const r = ratio(f, b);
    const level = min === 3 ? "رابط" : r >= 7 ? "AAA" : "AA";
    return { label, fg: rgb(f), bg: rgb(b), r: fa(r.toFixed(1)).replace(".", "٫"), min: fa(min).replace(".", "٫"), level, border: min === 3 };
  });
  return { name, title: name === "light" ? "تم روشن" : "تم تیره", page: rgb(base), rows };
});

// عددها از خود کد شمرده می‌شوند تا با هر نسخه درست بمانند
const cssDir = path.resolve(process.cwd(), "../../packages/css/src/components");
const cssFiles = fs.existsSync(cssDir) ? fs.readdirSync(cssDir).filter((f) => f.endsWith(".css")) : [];
const withForced = cssFiles.filter((f) => fs.readFileSync(path.join(cssDir, f), "utf8").includes("forced-colors")).length;
const contrastPairs = 82;

const stats: [string, string][] = [
  [fa(contrastPairs), "جفت رنگ در هر بیلد بررسی می‌شود"],
  [`${fa(4)} px`, "حلقهٔ فوکوس، فقط با کیبورد"],
  [`${fa(24)} px`, "کمترین ارتفاع دکمه"],
  [fa(withForced || 35), "فایل استایل با حالت کنتراست بالا"],
];

const keys: [string[][], string, string][] = [
  [[["Tab"], ["Shift", "Tab"]], "جابه‌جایی بین کنترل‌ها", "همه‌جا؛ حلقهٔ فوکوس فقط وقتی دیده می‌شود که با کیبورد کار می‌کنید."],
  [[["Enter"], ["Space"]], "فعال کردن", "دکمه، چک‌باکس، سوییچ و رادیو؛ همه روی عنصر بومی، پس بی‌کد اضافه کار می‌کنند."],
  [[["Esc"]], "بستن", "دیالوگ، منو، پاپ‌اور، تولتیپ، انتخابگر تاریخ، کومبوباکس، تور و ویرایش درجا."],
  [[["←"], ["→"], ["↑"], ["↓"]], "حرکت در گزینه‌ها", "تب‌ها، منوها، تقویم، کومبوباکس، درخت، کاروسل، پالت فرمان، ورودی عدد و زمان."],
  [[["Home"], ["End"]], "اول و آخر فهرست", "منو، کومبوباکس، درخت، کاروسل، پالت فرمان و جداکننده."],
];

const yours: { icon: string; title: string; text: string; code?: string; warn?: string }[] = [
  {
    icon: "speaker",
    title: "دکمهٔ فقط‌آیکون را نام بگذارید",
    text: "صفحه‌خوان آیکون را نمی‌بیند. اگر aria-label را فراموش کنید، در حالت توسعه این هشدار را در کنسول می‌گیرید:",
    warn: "بدون aria-label برای صفحه‌خوان‌ها بی‌نام است.",
    code: `<Button iconOnly aria-label="حذف">\n  <TrashIcon />\n</Button>`,
  },
  {
    icon: "ruler",
    title: "سطح عنوان‌ها را با صفحه هماهنگ کنید",
    text: "CardTitle به‌طور پیش‌فرض h3 است. اگر در صفحهٔ شما جای h2 نشسته، با as عوضش کنید تا ساختار صفحه برای صفحه‌خوان درست بماند.",
    code: `<CardTitle as="h2">\n  سفارش‌های امروز\n</CardTitle>`,
  },
  {
    icon: "palette",
    title: "رنگ برند خودتان را بسنجید",
    text: "طیفی که createTheme() از رنگ برند شما می‌سازد در بیلد کاشی بررسی نمی‌شود. کنتراست متن روی آن را با ابزاری مثل WebAIM Contrast Checker کنترل کنید.",
  },
  {
    icon: "info",
    title: "پیام خطا را کامل بنویسید",
    text: "به‌جای «ورودی نامعتبر» بگویید چه چیزی اشتباه است و چطور درستش کنند: «شمارهٔ کارت ۱۶ رقم است؛ ۱۵ رقم وارد شده.»",
  },
];

const checklist = [
  "کل صفحه را فقط با Tab و Shift+Tab بگردید؛ ترتیب فوکوس منطقی است و هیچ‌جا گیر نمی‌کنید.",
  "صفحه را تا ۲۰۰٪ بزرگ کنید؛ چیزی بریده نمی‌شود و اسکرول افقی پیدا نمی‌شود.",
  "با VoiceOver یا NVDA فرم اصلی را پر کنید؛ هر فیلد نام و خطای خودش را می‌خواند.",
  "در DevTools حالت forced-colors را شبیه‌سازی کنید؛ مرز کنترل‌ها و حالت انتخاب هنوز دیده می‌شود.",
  "کاهش حرکت را روشن کنید؛ هیچ انیمیشنی برای فهم صفحه لازم نیست.",
];

const headings = [
  { depth: 2, slug: "automatic", text: "آنچه خودکار بررسی می‌شود" },
  { depth: 2, slug: "built-in", text: "آنچه در کامپوننت‌ها ساخته شده" },
  { depth: 2, slug: "keyboard", text: "نقشهٔ کیبورد" },
  { depth: 2, slug: "yours", text: "مسئولیت شما" },
  { depth: 2, slug: "checklist", text: "پیش از انتشار" },
  { depth: 2, slug: "report", text: "گزارش مشکل" },
];
const issue = "https://github.com/Sepantapouya/Kashi/issues/new?labels=a11y";
---
<Docs title="دسترس‌پذیری" description="کاشی چه چیزی را تضمین می‌کند، چطور آن را می‌سنجد و چه بخشی بر عهدهٔ شماست." headings={headings}>
  <!-- ── معرفی ─────────────────────────────────────────────── -->
  <section class="ax-hero" aria-label="معرفی">
    <div class="ax-hero__copy">
      <span class="k-badge k-badge--brand k-badge--sm" dir="ltr">WCAG 2.2 · AA</span>
      <p class="ax-hero__title">دسترس‌پذیری از پایه، نه وصله‌ای در آخر کار</p>
      <p class="ax-hero__text">کنترل‌های کاشی روی عنصرهای بومی مرورگر ساخته شده‌اند، کنتراست رنگ‌ها در هر بیلد اندازه گرفته می‌شود و اگر یک جفت رد شود، نسخه‌ای منتشر نمی‌شود. بخش کوچکی می‌ماند که فقط شما می‌توانید درستش کنید؛ آن را هم پایین همین صفحه آورده‌ایم.</p>
      <div class="ax-hero__actions">
        <a class="k-btn k-btn--primary k-btn--lg" href="#yours">مسئولیت شما</a>
        <a class="k-btn k-btn--secondary k-btn--lg" href="#keyboard"><span set:html={ic("keyboard")} />نقشهٔ کیبورد</a>
      </div>
    </div>

    <!-- نمونهٔ فرم: فوکوس کیبورد بین فیلد و دکمه جابه‌جا می‌شود و صفحه‌خوان آن را می‌خواند -->
    <div class="ax-demo" aria-hidden="true">
      <div class="ax-demo__card">
        <p class="ax-demo__title">ورود به حساب</p>
        <div class="ax-demo__field ax-step ax-step--1">
          <span class="ax-demo__label">شمارهٔ موبایل</span>
          <span class="ax-demo__input" dir="ltr">0912 345 6789</span>
        </div>
        <label class="ax-demo__check ax-step ax-step--2"><span class="ax-demo__box">{<Fragment set:html={ic("check", 12)} />}</span>مرا به خاطر بسپار</label>
        <span class="ax-demo__btn ax-step ax-step--3">دریافت کد</span>
      </div>
      <div class="ax-demo__sr">
        <span class="ax-demo__sr-icon" set:html={ic("speaker", 14)} />
        <span class="ax-demo__says">
          <span class="ax-demo__say ax-say--1">شمارهٔ موبایل، فیلد متنی</span>
          <span class="ax-demo__say ax-say--2">مرا به خاطر بسپار، چک‌باکس، انتخاب‌شده</span>
          <span class="ax-demo__say ax-say--3">دریافت کد، دکمه</span>
        </span>
      </div>
      <kbd class="k-kbd ax-demo__tab" dir="ltr">Tab ⇥</kbd>
    </div>
  </section>

  <dl class="ax-stats">
    {stats.map(([n, l]) => <div><dt>{l}</dt><dd dir="ltr">{n}</dd></div>)}
  </dl>

  <!-- ── خودکار ──────────────────────────────────────────── -->
  <h2 id="automatic">آنچه خودکار بررسی می‌شود</h2>
  <p>پیش از ساخت پکیج توکن‌ها، کنتراست {fa(contrastPairs / 2)} جفت متن و پس‌زمینه در <strong>هر دو تم</strong> محاسبه می‌شود: متن دست‌کم <strong>{fa("4.5").replace(".", "٫")} به ۱</strong> و حاشیهٔ فیلد، چک‌باکس و سوییچ دست‌کم <strong>۳ به ۱</strong> (معیار 1.4.11). عددهای زیر از همان محاسبه آمده‌اند، نه از یک جدول دستی.</p>

  <div class="ax-contrast">
    {panels.map((pnl) => (
      <section class="ax-contrast__panel" style={`--_page:${pnl.page}`} aria-label={pnl.title}>
        <p class="ax-contrast__head"><span set:html={ic(pnl.name === "light" ? "sun" : "moon", 16)} />{pnl.title}</p>
        <ul role="list">
          {pnl.rows.map((r) => (
            <li>
              <span class="ax-contrast__swatch" style={`background:${r.bg};color:${r.fg}`}>
                {r.border ? <i style={`border-color:${r.fg}`} /> : "آب"}
              </span>
              <span class="ax-contrast__label">{r.label}<small>حداقل {r.min} به ۱</small></span>
              <span class="ax-contrast__ratio"><b dir="ltr">{r.r}:۱</b><em>{r.level}</em></span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="ax-gate">
    <div class="ax-gate__term" dir="ltr" aria-label="خروجی بیلد">
      <span><i>$</i> npm run build -w @kashi-ui/tokens</span>
      <span class="ok">contrast: {contrastPairs} pairs pass WCAG AA</span>
    </div>
    <p>اگر حتی یک جفت زیر حد باشد، بیلد با نام آن جفت و نسبتش متوقف می‌شود؛ رنگی که کنتراست کافی ندارد هیچ‌وقت به دست شما نمی‌رسد.</p>
  </div>

  <p>کنار کنتراست، تست‌های خودکار ساختار ARIA را هم نگه می‌دارند: برچسب، راهنما و پیام خطا به فیلد وصل‌اند، سوییچ نقش <code>switch</code> دارد، هشدار <code>role="alert"</code> دارد و دکمهٔ بستنش نام دارد، و دکمهٔ در حال بارگذاری فوکوس را از دست نمی‌دهد.</p>

  <!-- ── در کامپوننت‌ها ─────────────────────────────────── -->
  <h2 id="built-in">آنچه در کامپوننت‌ها ساخته شده</h2>
  <p>این‌ها را لازم نیست روشن کنید؛ با نصب کاشی همراه کامپوننت‌ها می‌آیند. نمونه‌ها زنده‌اند و با تنظیمات سیستم شما رفتار می‌کنند.</p>

  <div class="ax-cards">
    <article>
      <div class="ax-art ax-art--focus">
        <button type="button" class="k-btn k-btn--secondary k-btn--sm">انصراف</button>
        <button type="button" class="k-btn k-btn--primary k-btn--sm">ذخیره</button>
      </div>
      <strong>فوکوس کیبورد</strong>
      <p>حلقهٔ ۴ پیکسلی روی همهٔ کنترل‌ها، فقط با <code>:focus-visible</code>؛ با موس دیده نمی‌شود، با کیبورد هیچ‌وقت گم نمی‌شود. روی این دو دکمه Tab بزنید.</p>
    </article>
    <article>
      <div class="ax-art ax-art--native">
        <label class="k-check"><input type="checkbox" class="k-checkbox" checked /><span class="k-check__text"><span class="k-check__label">خبرنامه</span></span></label>
        <label class="ax-art__switch"><input type="checkbox" role="switch" class="k-switch" checked />اعلان‌ها</label>
      </div>
      <strong>کنترل‌های بومی</strong>
      <p>چک‌باکس، سوییچ و رادیو روی <code>&lt;input&gt;</code> واقعی ساخته شده‌اند و دیالوگ روی <code>&lt;dialog&gt;</code> بومی؛ کیبورد، فرم و صفحه‌خوان بی‌کد اضافه کار می‌کنند.</p>
    </article>
    <article>
      <div class="ax-art ax-art--forced" aria-hidden="true">
        <span class="ax-forced__btn">ذخیره</span>
        <span class="ax-forced__box" set:html={ic("check", 12)} />
        <span class="ax-forced__link">لینک</span>
      </div>
      <strong>کنتراست بالای ویندوز</strong>
      <p>در حالت <code>forced-colors</code> رنگ‌های سیستم جای رنگ‌های کاشی می‌نشینند و چک‌باکس و سوییچ به کنترل بومی برمی‌گردند تا حالت انتخاب گم نشود.</p>
    </article>
    <article>
      <div class="ax-art ax-art--more" aria-hidden="true">
        <span><small>عادی</small><em class="soft">متن کم‌رنگ</em></span>
        <span set:html={ic("arrow-left", 16)} />
        <span><small>کنتراست بیشتر</small><em>متن کم‌رنگ</em></span>
      </div>
      <strong>کنتراست بیشتر</strong>
      <p>اگر کاربر در سیستم کنتراست بیشتر خواسته باشد (<code>prefers-contrast: more</code>)، متن کم‌رنگ و حاشیه‌ها خودکار یک پله پررنگ‌تر می‌شوند.</p>
    </article>
    <article>
      <div class="ax-art ax-art--motion" aria-hidden="true">
        <span class="ax-motion__track"><i /></span>
        <span class="ax-motion__state" data-on="در حال حرکت" data-off="متوقف؛ کاهش حرکت روشن است" />
      </div>
      <strong>کاهش حرکت</strong>
      <p>با <code>prefers-reduced-motion</code> انیمیشن‌ها و ترنزیشن‌ها عملاً صفر می‌شوند. اگر کاهش حرکت در سیستم شما روشن باشد، نوار بالا ایستاده است.</p>
    </article>
    <article>
      <div class="ax-art ax-art--target" aria-hidden="true">
        <span class="ax-target"><span class="k-btn k-btn--tertiary k-btn--icon k-btn--sm" set:html={ic("close", 16)} /></span>
        <span class="ax-target__dim" dir="ltr">≥ 24 × 24</span>
      </div>
      <strong>ناحیهٔ لمس</strong>
      <p>هیچ دکمه‌ای، حتی کوچک‌ترین دکمهٔ آیکونی، کوتاه‌تر از ۲۴ پیکسل نیست (معیار 2.5.8)؛ انگشت و موس به اندازهٔ کافی جا دارند.</p>
    </article>
  </div>

  <!-- ── کیبورد ──────────────────────────────────────────── -->
  <h2 id="keyboard">نقشهٔ کیبورد</h2>
  <p>کامپوننت‌ها همان کلیدهایی را می‌فهمند که کاربر از سیستم‌عامل انتظار دارد. در صفحه‌های راست‌به‌چپ، جهت فلش‌ها هم با جهت صفحه می‌چرخد.</p>
  <ul class="ax-keys" role="list">
    {keys.map(([k, title, where]) => (
      <li>
        <span class="ax-keys__k" dir="ltr">{k.map((combo) => <span class="ax-keys__combo">{combo.map((x, i) => <>{i > 0 && <i>+</i>}<kbd class="k-kbd">{x}</kbd></>)}</span>)}</span>
        <span class="ax-keys__t"><strong>{title}</strong><span>{where}</span></span>
      </li>
    ))}
  </ul>
  <p class="ax-note">برای کاربران کیبورد، کلاس <code>k-skip-link</code> لینک «رفتن به محتوای اصلی» را می‌سازد که فقط با اولین Tab ظاهر می‌شود؛ همین سایت هم از آن استفاده می‌کند.</p>

  <!-- ── مسئولیت شما ─────────────────────────────────────── -->
  <h2 id="yours">مسئولیت شما</h2>
  <p>هیچ دیزاین‌سیستمی نمی‌تواند همه‌چیز را تضمین کند. این چهار مورد به نحوهٔ استفادهٔ شما بستگی دارد:</p>
  <div class="ax-yours">
    {yours.map((y) => (
      <article>
        <span class="ax-yours__icon" set:html={ic(y.icon, 20)} />
        <strong>{y.title}</strong>
        <p>{y.text}</p>
        {y.warn && <p class="ax-yours__warn"><span set:html={ic("info", 14)} /><code><bdi dir="ltr">[kashi] &lt;Button iconOnly&gt;</bdi> {y.warn}</code></p>}
        {y.code && <CodeBlock code={y.code} />}
      </article>
    ))}
  </div>

  <!-- ── چک‌لیست ─────────────────────────────────────────── -->
  <h2 id="checklist">پیش از انتشار</h2>
  <p>پنج دقیقه آزمون دستی، بیشتر مشکل‌هایی را می‌گیرد که هیچ تست خودکاری نمی‌بیند. موردهایی را که انجام داده‌اید تیک بزنید:</p>
  <ul class="ax-list" role="list">
    {checklist.map((c) => (
      <li><label class="k-check"><input type="checkbox" class="k-checkbox" /><span class="k-check__text"><span class="k-check__label">{c}</span></span></label></li>
    ))}
  </ul>

  <!-- ── گزارش ───────────────────────────────────────────── -->
  <h2 id="report">گزارش مشکل</h2>
  <div class="ax-report">
    <span class="ax-report__icon" set:html={ic("accessibility", 28)} />
    <div>
      <strong>جایی از کاشی برای کسی کار نمی‌کند؟</strong>
