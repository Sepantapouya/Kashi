---
import Docs from "../../layouts/Docs.astro";
import { palette } from "@kashi-ui/tokens";

const NAMES: Record<string, [string, string]> = {
  firoozeh: ["فیروزه‌ای", "رنگ برند و عملکرد اصلی"],
  lajvard: ["لاجوردی", "اطلاعات و لینک‌ها"],
  zafaran: ["زعفرانی", "هشدار"],
  anar: ["اناری", "خطا و عملیات مخرب"],
  pesteh: ["پسته‌ای", "موفقیت"],
  shab: ["شب", "خاکستری‌ها: پس‌زمینه، متن و حاشیه"],
};

const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const lin = (c: number) => ((c /= 255) <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const lum = (h: string) => { const [r, g, b] = hex(h); return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b); };
const onDark = (h: string) => lum(h) < 0.18;
const headings = Object.keys(palette).map((k) => ({ depth: 2, slug: k, text: NAMES[k]?.[0] ?? k }));
---
<Docs title="رنگ‌ها" description="رنگ‌های پایهٔ کاشی، الهام‌گرفته از کاشی‌کاری و رنگ‌های ایرانی. کامپوننت‌ها از توکن‌های معنایی استفاده می‌کنند، نه مستقیم از این طیف‌ها." headings={headings}>
  <p>هر طیف یازده پله دارد و با متغیر <code>--k-{"{نام}"}-{"{پله}"}</code> در دسترس است؛ برای مثال <code>--k-firoozeh-500</code>. برای کپی، روی هر رنگ کلیک کنید.</p>
  {Object.entries(palette).map(([name, scale]) => (
    <section class="palette" aria-labelledby={name}>
      <h2 id={name}>{NAMES[name]?.[0] ?? name} <code class="palette__key">{name}</code></h2>
      <p class="palette__desc">{NAMES[name]?.[1]}</p>
      <ul class="swatch-grid" role="list">
        {Object.entries(scale as Record<string, string>).map(([step, value]) => (
          <li>
            <button type="button" class="chip" data-copy={`var(--k-${name}-${step})`} style={`--c: ${value}`} aria-label={`کپی متغیر ${name} پلهٔ ${step}`}>
              <span class:list={["chip__color", { "chip__color--dark": onDark(value) }]}>{step}</span>
              <span class="chip__hex" dir="ltr">{value}</span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Docs>

<style>
  .palette h2 { display: flex; align-items: baseline; gap: var(--k-space-3); }
  .palette__key { font-size: var(--k-text-sm); font-weight: var(--k-weight-regular); }
  .palette__desc { margin-block: var(--k-space-1) var(--k-space-4); color: var(--k-text-tertiary); }
  .swatch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(4.25rem, 1fr)); gap: var(--k-space-2); margin: 0; padding: 0; list-style: none; }
  .chip { display: grid; gap: var(--k-space-1_5); inline-size: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: start; cursor: pointer; border-radius: var(--k-radius-md); }
  .chip__color {
    display: flex;
    align-items: flex-end;
    block-size: 3.5rem;
    padding: var(--k-space-1_5);
    border-radius: var(--k-radius-md);
    background: var(--c);
    color: #0d0f14;
    font-size: var(--k-text-xs);
    font-weight: var(--k-weight-semibold);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .chip__color--dark { color: #fff; }
  .chip__hex { color: var(--k-text-tertiary); font-family: var(--k-font-mono); font-size: 0.6875rem; text-align: start; }
  .chip:hover .chip__color { outline: 2px solid var(--k-border-primary); outline-offset: 2px; }
  .chip[data-copied] .chip__hex { color: var(--k-text-success); }
</style>
