---
import DocsEn from "../../../../layouts/DocsEn.astro";
import { EN_COMPONENTS, EN_PERSIAN } from "../../../../data/en";

// Link to an English translation only when that MDX page exists in this branch.
// All other cards retain the Persian destination instead of pointing to 404s.
const englishPages = new Set(
  Object.keys(import.meta.glob("./*.mdx"))
    .map((file) => `/docs/components/${file.slice(2, -4)}/`)
    .concat(
      Object.keys(import.meta.glob("../persian/*.mdx"))
        .map((file) => `/docs/persian/${file.slice(11, -4)}/`)
    )
);

const groups = [
  ...EN_COMPONENTS.map((g) => ({ ...g, base: "/docs/components/" })),
  ...EN_PERSIAN.map((g) => ({ ...g, base: "/docs/persian/" })),
];
const total = groups.reduce((n, g) => n + g.items.length, 0);
const headings = groups.map((g) => ({ depth: 2, slug: g.title.toLowerCase().replace(/[^a-z]+/g, "-"), text: g.title }));
---
<DocsEn
  title="Components"
  description={`All ${total} Kashi components and Persian tools. Each links to its full page with live demos, code and props.`}
  fa="/docs/components/"
  headings={headings}
>
  <p>The full component pages are in Persian for now, but you don't need to read Persian to use them: the live demos, the React and HTML code, and the prop tables use the same names in every language. Every component also reads its built-in text in English under <code>KashiProvider locale="en"</code>.</p>
  {groups.map((g, i) => (
    <section>
      <h2 id={headings[i].slug}>{g.title}</h2>
      <ul class="en-cards" role="list">
        {g.items.map(([slug, name, text]) => (
          <li>
            {englishPages.has(`${g.base}${slug}/`)
              ? <a href={`/en${g.base}${slug}/`}><b>{name}</b><span>{text}</span></a>
              : <a href={`${g.base}${slug}/`} hreflang="fa"><b>{name}</b><span>{text}</span></a>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsEn>
