---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { Button, Badge } from '@kashi-ui/react';
import { iconSvg } from '@kashi-ui/icons';
import '../styles/pro.css';
const features = [ ['layers','از کامپوننت تا صفحه','چیدمان‌های کامل، ساخته‌شده با کامپوننت‌های خود کاشی.'], ['palette','با رنگ و نشان شما','رنگ، فونت و جزئیات را با توکن‌های کاشی شخصی‌سازی کنید.'], ['code','برای ادامهٔ کار شما','قالب React با ساختار قابل ویرایش؛ نقطهٔ شروع محصول خودتان.'] ];
---
<Base title="کاشی پرو — صفحات آماده برای محصول بعدی شما" description="قالب‌های فارسی و راست‌چین ساخته‌شده با کاشی. پیش‌نمایش واقعی را ببینید و هر قالب را جداگانه انتخاب کنید.">
<Header />
<main id="main" class="pro">
 <section class="pro-hero">
  <div class="pro-eyebrow"><Logo size={22}/><span>کاشی پرو</span><Badge tone="brand" size="sm">برای سازنده‌ها</Badge></div>
  <div class="pro-hero-row"><h1>ایده از شما.<br/><span>شروع زیبا از کاشی.</span></h1><div class="pro-hero-note"><p>صفحات آماده‌ای که جزئیاتشان فکر شده؛<br/>برای محصولی که قرار است مال شما باشد.</p><div class="pro-actions"><Button href="#templates" variant="primary">کشف اولین قالب <span set:html={iconSvg('arrow-down',{size:17})}/></Button><a href="#why-pro">چرا کاشی پرو؟ <span set:html={iconSvg('arrow-left',{size:16})}/></a></div></div></div>
  <div class="pro-traits"><span>طراحی فارسی و راست‌چین</span><span>ساخته‌شده با خود کاشی</span><span>خرید جداگانهٔ هر قالب</span><span class="pro-collection-note">مجموعه‌ای که تازه شروع شده <i></i></span></div>
 </section>
 <section id="templates" class="pro-catalog" aria-labelledby="catalog-title">
  <div class="pro-section-head"><div><span class="pro-kicker">اولین عضو مجموعه</span><h2 id="catalog-title">با سنجه آشنا شوید.</h2></div><span class="pro-index"><b>۰۱</b> / اولین قالب</span></div>
  <article class="pro-product">
   <div class="pro-window"><div class="pro-window-bar"><span class="pro-dots" aria-hidden="true"><i/><i/><i/></span><span><span set:html={iconSvg('lock',{size:12})}/> پیش‌نمایش سنجه</span><a href="/templates/landing/" aria-label="باز کردن پیش‌نمایش سنجه" set:html={iconSvg('arrow-up-right',{size:16})}/></div><div class="pro-preview"><iframe src="/templates/landing/?embed=1" title="پیش‌نمایش قالب سنجه" loading="eager" tabindex="-1" aria-hidden="true" inert></iframe><a class="pro-preview-link" href="/templates/landing/" aria-label="مشاهدهٔ قالب سنجه"><span>داخل قالب را ببینید <span set:html={iconSvg('arrow-up-left',{size:18})}/></span></a></div><div class="pro-preview-footer"><span><i/> پیش‌نمایش واقعی قالب</span><span>فارسی · روشن و تیره</span></div></div>
   <div class="pro-product-info"><div class="pro-product-kind"><span>LANDING PAGE</span><Badge variant="outline" size="sm">React</Badge></div><h3>سنجه<span>یک شروع روشن،<br/>برای محصول بعدی شما.</span></h3><p>یک صفحهٔ فرود برای معرفی محصول؛ از اولین نگاه تا نمایش قابلیت‌ها و انتخاب پلن. با همان کامپوننت‌هایی که در کاشی می‌شناسید.</p><ul class="pro-includes">{['هیرو و پیشخوان تعاملی','معرفی قابلیت‌ها و قیمت‌گذاری','پرسش‌های رایج و کارت‌های محتوا','نمای موبایل و منوی واکنش‌گرا'].map(t=><li><span set:html={iconSvg('check',{size:15})}/>{t}</li>)}</ul><div class="pro-product-action"><div><Badge tone="brand" size="sm">در حال آماده‌سازی فروش</Badge><small>قیمت به‌زودی اعلام می‌شود</small></div><Button href="/templates/landing/" variant="primary" block>دیدن سنجه <span set:html={iconSvg('arrow-left',{size:18})}/></Button></div></div>
  </article>
  <p class="pro-demo-note"><span set:html={iconSvg('info',{size:15})}/> سنجه یک قالب نمایشی است؛ آمار و قیمت‌های داخل دمو، قیمت فروش قالب نیستند.</p>
 </section>
 <section class="pro-value" id="why-pro"><div class="pro-value-title"><span class="pro-kicker">فاصلهٔ کمتر تا محصول شما</span><h2>از صفحهٔ سفید<br/>شروع نکنید.</h2><p>ترکیب‌بندی، فاصله‌ها و هماهنگی اجزا آماده‌اند.<br/>وقتتان را برای خاص‌کردن محصولتان بگذارید.</p></div><div class="pro-value-visual" aria-hidden="true"><div class="pro-wireframe"><div></div><div></div><div></div><span></span></div><span class="pro-value-arrow" set:html={iconSvg('arrow-left',{size:22})}/><div class="pro-built"><div class="pro-built-top"><Logo size={20}/><span>محصول شما</span><i/></div><b>شروع یک ایدهٔ تازه.</b><span class="pro-built-line"></span><span class="pro-built-line pro-built-line--short"></span><div class="pro-built-bottom"><span>شروع کنید ←</span><div><i/><i/><i/></div></div></div></div></section>
 <section class="pro-features" aria-label="چرا کاشی پرو">{features.map(([icon,title,text],i)=><article><div class="pro-feature-top"><span set:html={iconSvg(icon,{size:24})}/><small>{['۰۱','۰۲','۰۳'][i]}</small></div><h2>{title}</h2><p>{text}</p></article>)}</section>
 <section class="pro-open"><div class="pro-open-icon" set:html={iconSvg('heart',{size:28})}/><div><h2>یک خانواده؛ دو راه برای ساختن.</h2><p>از کامپوننت‌های رایگان کاشی بسازید، یا با صفحات آمادهٔ پرو جلوتر شروع کنید. هستهٔ کاشی رایگان و متن‌باز می‌ماند.</p></div><Button href="/docs/" variant="secondary">دیدن کاشی رایگان</Button></section>
 <section class="pro-faq"><div><span class="pro-kicker">پیش از انتخاب</span><h2>قبل از شروع، بدانید.</h2></div><div>
 <details><summary>برای هر قالب جداگانه پرداخت می‌کنم؟</summary><p>بله. مدل کاشی پرو خرید جداگانهٔ هر قالب است؛ قالبی را انتخاب می‌کنید که برای پروژه‌تان نیاز دارید.</p></details>
 <details><summary>الان می‌توانم قالب را بخرم؟</summary><p>در حال حاضر پیش‌نمایش قابل بررسی است. قیمت، شرایط استفاده و جزئیات فایل‌های تحویلی پیش از فعال‌شدن خرید منتشر می‌شوند.</p></details>
 <details><summary>سنجه یک سرویس واقعی است؟</summary><p>خیر؛ سنجه محصولی نمایشی برای معرفی قالب است. نام‌ها، آمار، نظرها و قیمت‌های داخل آن نمونه‌اند و به کاشی یا یک سرویس واقعی مربوط نیستند.</p></details>
 <details><summary>برای استفاده از کاشی به پرو نیاز دارم؟</summary><p>خیر. با کامپوننت‌های رایگان کاشی می‌توانید صفحات خودتان را بسازید. پرو، چیدمان و طراحی آمادهٔ صفحات را به آن اضافه می‌کند.</p></details>
 </div></section>
</main><Footer/>
</Base>
