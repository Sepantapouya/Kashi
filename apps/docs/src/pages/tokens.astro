  /* ۰۴ کامپوننت‌ها (کلاس‌های واقعی k-*) */
  .tk-c-btn { position: absolute; translate: -50% -50%; pointer-events: none; }
  .tk-c-card { position: absolute; display: grid; gap: 2px; inline-size: 210px; padding: 12px 14px; direction: rtl; text-align: start; }
  .tk-c-title { color: var(--k-text-primary); font-size: 16px; }
  .tk-c-card small { color: var(--k-text-tertiary); font-size: 12px; }
  .tk-c-badge, .tk-c-switch, .tk-c-input { position: absolute; translate: -50% -50%; pointer-events: none; direction: rtl; }
  .tk-c-input { inline-size: 170px; }
  .tk-c-input :global(input) { direction: rtl; }

  /* ستون‌های نور */
  .tk-beam { position: absolute; inline-size: 0; block-size: 0; transform-style: preserve-3d; }
