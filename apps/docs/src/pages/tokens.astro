    position: absolute; inset-inline-start: -2px; inset-block-start: 0;
    inline-size: 4px; block-size: calc(3 * var(--gap));
    transform-origin: 50% 0; transform: rotateX(90deg);
    border-radius: 2px;
    background: linear-gradient(to bottom, transparent, var(--k-brand-400) 10%, var(--k-brand-300) 90%, transparent);
    box-shadow: 0 0 14px var(--k-brand-400);
    transition: block-size 0.9s var(--k-ease-standard);
  }
  .tk-beam--b i { background: linear-gradient(to bottom, transparent, var(--k-text-secondary) 10%, var(--k-text-primary) 90%, transparent); box-shadow: 0 0 10px color-mix(in srgb, var(--k-text-primary) 50%, transparent); }
  .tk-beam i::after { content: ""; position: absolute; inset-inline: -3px; block-size: 18px; border-radius: 5px; background: #fff; box-shadow: 0 0 16px 4px var(--k-brand-300); opacity: 0.9; animation: tk-rise 2.6s var(--k-ease-standard) infinite; }
  .tk-beam--b i::after { animation-delay: 1.3s; box-shadow: 0 0 14px 3px color-mix(in srgb, var(--k-text-primary) 60%, transparent); }
  @keyframes tk-rise { from { inset-block-start: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } to { inset-block-start: calc(100% - 18px); opacity: 0; } }

  .tk-stack.is-flat { --gap: 0.9rem; }
  .tk-stack.is-flat .tk-beam i::after { animation: none; opacity: 0; }

  .tk-caption { margin: var(--k-space-4) auto 0; color: var(--k-text-quaternary); font-size: var(--k-text-xs); text-align: center; }

  /* ── بخش‌ها ── */
  .tk-band { padding-block: clamp(4rem, 8vw, 6rem); border-block-end: 1px solid var(--k-border-secondary); }
  .tk-band--alt { background: var(--k-bg-secondary); }
  .tk-head { max-inline-size: 44rem; margin-block-end: clamp(2rem, 4vw, 3rem); }
  .tk-kicker { display: flex; align-items: center; gap: var(--k-space-2); margin: 0; color: var(--k-text-brand); font-size: var(--k-text-sm); font-weight: var(--k-weight-semibold); }
  .tk-kicker span { padding-inline-end: var(--k-space-2); border-inline-end: 1px solid var(--k-border-primary); color: var(--k-text-quaternary); font-family: var(--k-font-mono); font-size: var(--k-text-xs); }
  .tk-head h2 { margin: var(--k-space-3) 0 0; color: var(--k-text-primary); font-size: clamp(1.6rem, 3.4vw, 2.3rem); font-weight: var(--k-weight-bold); line-height: 1.4; }
  .tk-band__lead { margin: var(--k-space-3) 0 0; color: var(--k-text-tertiary); line-height: 1.9; }

  .tk-rows { display: grid; gap: var(--k-space-3); margin: 0; padding: 0; list-style: none; }
  .tk-row { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.1fr); align-items: center; gap: var(--k-space-4) var(--k-space-6); padding: var(--k-space-5) var(--k-space-6); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: var(--k-bg-elevated); transition: border-color var(--k-duration-fast), translate var(--k-duration-normal) var(--k-ease-standard); }
  .tk-row:hover { border-color: var(--k-border-primary); translate: 0 -2px; }
  .tk-row__n { color: var(--k-text-brand); font: 700 var(--k-text-2xl) var(--k-font-mono); }
  .tk-row h3 { margin: 0; color: var(--k-text-primary); font-size: var(--k-text-lg); font-weight: var(--k-weight-bold); }
  .tk-row__body p { margin: var(--k-space-1) 0 0; color: var(--k-text-tertiary); font-size: var(--k-text-sm); line-height: 1.85; }
  .tk-row__body .tk-row__count { color: var(--k-text-secondary); }
  .tk-row__count b { color: var(--k-text-primary); font-size: var(--k-text-lg); }
  .tk-row__code { margin: 0; overflow-x: auto; padding: var(--k-space-3) var(--k-space-4); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-md); background: var(--k-bg-secondary); color: var(--k-text-secondary); font: 13px/1.8 var(--k-font-mono); text-align: left; }

  .tk-outs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--k-space-3); margin: 0; padding: 0; list-style: none; }
  .tk-out { display: grid; align-content: start; gap: var(--k-space-1); padding: var(--k-space-5); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: var(--k-bg-primary); transition: border-color var(--k-duration-fast), translate var(--k-duration-normal) var(--k-ease-standard); }
  .tk-out:hover { border-color: var(--k-border-brand); translate: 0 -2px; }
  .tk-out__icon { display: grid; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; margin-block-end: var(--k-space-2); border-radius: var(--k-radius-md); background: var(--k-bg-brand-subtle); color: var(--k-text-brand); }
  .tk-out b { color: var(--k-text-primary); font-size: var(--k-text-md); }
  .tk-out small { color: var(--k-text-tertiary); font-size: var(--k-text-sm); }
  .tk-out code { margin-block-start: var(--k-space-3); overflow: hidden; padding: var(--k-space-2) var(--k-space-3); border-radius: var(--k-radius-sm); background: var(--k-bg-secondary); color: var(--k-text-secondary); font: 12px var(--k-font-mono); text-align: left; text-overflow: ellipsis; white-space: nowrap; }

  .tk-cta { padding-block: clamp(3.5rem, 7vw, 5rem); }
  .tk-cta__box { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-space-6); }
  .tk-cta__box > div:first-child { padding: 0; }
  .tk-cta h2 { margin: 0; color: var(--k-text-primary); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: var(--k-weight-bold); }
  .tk-cta p { margin: var(--k-space-2) 0 0; color: var(--k-text-tertiary); }
  .tk-cta__actions { display: flex; flex-wrap: wrap; gap: var(--k-space-2); }

  @media (max-width: 64rem) {
