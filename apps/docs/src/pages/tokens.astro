  .tk-sem { position: absolute; display: inline-flex; align-items: center; gap: 7px; translate: -50% -50%; padding: 6px 10px 6px 7px; border: 1px solid var(--k-border-secondary); border-radius: 10px; background: var(--k-bg-primary); white-space: nowrap; }
