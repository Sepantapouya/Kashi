  .tk-plate__label em { margin-inline-end: 6px; color: var(--k-text-brand); font-family: var(--k-font-mono); font-size: 12px; font-style: normal; }
  /* لبهٔ صفحه برای حس ضخامت، مثل تصویرسازی ایزومتریک */
  .tk-edge { position: absolute; background: color-mix(in srgb, var(--k-bg-elevated) 55%, var(--k-text-primary) 10%); }
