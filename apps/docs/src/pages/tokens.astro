    .tk-view { --s: 0.8; block-size: 38rem; }
  }
  @media (max-width: 48rem) {
    .tk-legend { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tk-view { --s: 0.5; block-size: 26rem; }
    .tk-stack { --gap: 5.5rem; }
    .tk-row { grid-template-columns: auto minmax(0, 1fr); }
    .tk-row__code { grid-column: 1 / -1; }
    .tk-outs { grid-template-columns: 1fr; }
  }
  @media (max-width: 30rem) { .tk-view { --s: 0.42; block-size: 22rem; } }
  @media (prefers-reduced-motion: reduce) {
    .tk-stack, .tk-plate, .tk-beam i { transition: none; }
    .tk-beam i::after { animation: none; opacity: 0; }
  }
</style>

<script>
  import { createTheme } from "@kashi-ui/tokens";

  const stage = document.querySelector<HTMLElement>("[data-tk-stage]");
  const stack = document.querySelector<HTMLElement>("[data-stack]");
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // رنگ برند کل صفحه با createTheme واقعی کاشی (توکن‌های معنایی روی :root حل می‌شوند)
  const style = document.createElement("style");
  document.head.append(style);
  const sws = document.querySelectorAll<HTMLButtonElement>(".tk-sw");
  sws.forEach((btn) => btn.addEventListener("click", () => {
    const v = btn.dataset.brand;
    style.textContent = v ? createTheme({ brand: v }) : "";
    sws.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
  }));

  // باز و جمع کردن لایه‌ها
  const ex = document.querySelector<HTMLButtonElement>("[data-explode]");
  const exLabel = document.querySelector<HTMLElement>("[data-explode-label]");
  ex?.addEventListener("click", () => {
    const flat = stack!.classList.toggle("is-flat");
    ex.setAttribute("aria-pressed", String(!flat));
    if (exLabel) exLabel.textContent = flat ? "باز کردن لایه‌ها" : "جمع کردن لایه‌ها";
  });

  // تمرکز روی یک لایه از راهنما
  const items = document.querySelectorAll<HTMLButtonElement>("[data-layer]");
  const focus = (key: string | null) => {
    if (key) stack!.dataset.focus = key; else delete stack!.dataset.focus;
    items.forEach((i) => i.classList.toggle("is-on", i.dataset.layer === key));
  };
  items.forEach((i) => {
    i.addEventListener("mouseenter", () => focus(i.dataset.layer!));
    i.addEventListener("focus", () => focus(i.dataset.layer!));
    i.addEventListener("mouseleave", () => focus(null));
    i.addEventListener("blur", () => focus(null));
    i.addEventListener("click", () => focus(stack!.dataset.focus === i.dataset.layer ? null : i.dataset.layer!));
  });

  // ورود: لایه‌ها از حالت جمع باز می‌شوند؛ کمی چرخش با حرکت ماوس
  if (!calm && stack) {
    stack.classList.add("is-flat");
    const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { setTimeout(() => stack.classList.remove("is-flat"), 250); io.disconnect(); } }, { threshold: 0.35 });
    io.observe(stack);
    if (matchMedia("(pointer: fine)").matches && stage) {
      stage.addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        stack.style.setProperty("--rz", `${-42 + x * 8}deg`);
        stack.style.setProperty("--rx", `${58 - y * 6}deg`);
      });
      stage.addEventListener("pointerleave", () => { stack.style.removeProperty("--rz"); stack.style.removeProperty("--rx"); });
    }
  }
</script>
