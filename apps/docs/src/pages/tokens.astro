  .tk-chipnote { position: absolute; translate: -50% 0; padding: 2px 8px; border-radius: 6px; background: var(--k-bg-primary); color: var(--k-text-secondary); font: 600 11px var(--k-font-mono); white-space: nowrap; box-shadow: 0 0 0 1px var(--k-border-secondary); }
