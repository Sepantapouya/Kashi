---
// کیت پرو کاشی: صفحهٔ فرود (محصول ساختگی «سنجه»)؛ هنوز در فهرست سایت نیست
import "../../styles/layers.css";
import "@kashi-ui/css";
import "../../styles/landing.css";
import Landing from "../../templates/Landing";
---
<!doctype html>
<html lang="fa" dir="rtl" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>سنجه · تحلیل داده برای رشد</title>
  <script is:inline>
    try {
      const t = localStorage.getItem("kashi-template-theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    } catch {}
  </script>
</head>
<body>
  <aside class="template-notice" aria-label="پیش‌نمایش قالب"><a href="/pro/">کاشی پرو <span>← همهٔ قالب‌ها</span></a><p>پیش‌نمایش سنجه · نام‌ها، آمار و قیمت‌ها نمایشی‌اند.</p><span>فروش به‌زودی</span></aside>
  <Landing client:load />
  <button class="tpl-theme k-btn k-btn--secondary k-btn--icon" type="button" aria-label="تغییر تم روشن و تیره" data-theme-toggle>
    <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.5"/><path d="M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.3 4.3l1.1 1.1M14.6 14.6l1.1 1.1M4.3 15.7l1.1-1.1M14.6 5.4l1.1-1.1"/></svg>
  </button>
  <script is:inline>if(new URLSearchParams(location.search).has('embed'))document.documentElement.dataset.embed='';</script>
  <script>
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      const el = document.documentElement;
      el.dataset.theme = el.dataset.theme === "dark" ? "light" : "dark";
      try { localStorage.setItem("kashi-template-theme", el.dataset.theme); } catch {}
    });
  </script>
</body>
</html>
