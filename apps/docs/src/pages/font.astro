<script>
  const fa = (n: number | string) => String(n).replace(/\d/g, (d) => "۰۱۲۳۴۵۶۷۸۹"[+d]);
  const text = document.getElementById("kf-text") as HTMLElement;
  const w = document.getElementById("kf-w") as HTMLInputElement;
  const s = document.getElementById("kf-s") as HTMLInputElement;
  const ss = document.getElementById("kf-ss02") as HTMLInputElement;
  const x = document.getElementById("kf-x") as HTMLInputElement;
  let dots = "";
  const apply = () => {
    text.style.fontWeight = w.value;
    text.style.fontSize = `${s.value}px`;
    text.style.fontStretch = `${x.value}%`;
    const feats = [ss.checked && '"ss02"', dots && `"${dots}"`].filter(Boolean);
    text.style.fontFeatureSettings = feats.length ? feats.join(", ") : "normal";
    document.getElementById("kf-w-out")!.textContent = fa(w.value);
    document.getElementById("kf-s-out")!.textContent = fa(s.value);
    document.getElementById("kf-x-out")!.textContent = fa(x.value);
  };
  [w, s, ss, x].forEach((el) => el.addEventListener("input", apply));
  document.querySelectorAll<HTMLButtonElement>("[data-dots]").forEach((b, _, all) =>
    b.addEventListener("click", () => {
      all.forEach((y) => y.setAttribute("aria-pressed", String(y === b)));
      dots = b.dataset.dots ?? "";
      apply();
    }));
  document.querySelectorAll<HTMLButtonElement>(".kf-seg--fam button").forEach((b, _, all) =>
    b.addEventListener("click", () => {
      all.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      text.style.fontFamily = `"${b.dataset.fam}", Tahoma, sans-serif`;
    }));
  apply();

  // زبانه‌های راهنمای نصب: کلیک و کلیدهای جهت (در راست‌به‌چپ، چپ یعنی بعدی)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".kf-guide [role=tab]")];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute("aria-selected", String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute("aria-controls")!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(t));
    t.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowLeft" ? 1 : e.key === "ArrowRight" ? -1 : e.key === "Home" ? -i : e.key === "End" ? tabs.length - 1 - i : 0;
      if (!d) return;
      e.preventDefault();
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n);
      n.focus();
    });
  });

  // وزن واژهٔ بزرگ با حرکت آرام، اگر کاربر حرکت کم را نخواسته باشد
  const word = document.getElementById("kf-hero-word");
  const dot = document.getElementById("kf-axis-dot");
  if (word && dot && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let start = 0;
    const tick = (t: number) => {
      start ||= t;
      const p = 0.5 - 0.5 * Math.cos(((t - start) / 7000) * Math.PI * 2);
      const v = 900 - 800 * p;
      word.style.setProperty("--w", String(Math.round(v)));
      dot.style.insetInlineStart = `${((v - 100) / 800) * 100}%`;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
