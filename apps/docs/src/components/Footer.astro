---
import Logo from "./Logo.astro";
import { author } from "../data/author";
import pkg from "@kashi-ui/react/package.json";
const columns = [
  { title: "محصول", links: [["معرفی", "/docs/"], ["نصب", "/docs/installation/"], ["کامپوننت‌ها", "/docs/components/"], ["کامپوننت‌های فارسی", "/docs/persian/"], ["آیکون‌ها", "/docs/icons/"], ["وب کامپوننت‌ها", "/docs/web-components/"]] },
  { title: "ابزارها", links: [["تم‌ساز", "/docs/theming/"], ["پلاگین فیگما", "/docs/figma/"], ["Tailwind", "/docs/tailwind/"], ["رجیستری shadcn", "/docs/installation/#رجیستری-shadcn"], ["سرور MCP", "/docs/ai/"]] },
  { title: "راهنماها", links: [["مقاله‌ها", "/articles/"], ["نوشتن متن رابط", "/docs/writing/"], ["دسترس‌پذیری", "/docs/accessibility/"], ["فونت و تایپوگرافی", "/docs/typography/"], ["حرکت و ریزتعامل‌ها", "/docs/motion/"], ["رنگ‌ها", "/docs/colors/"], ["دوزبانه", "/docs/i18n/"], ["مقایسه با دیگران", "/docs/compare/"]] },
  { title: "پایداری", links: [["وضعیت سرویس‌ها", "/status/"], ["سیاست تغییرات", "/docs/versioning/"], ["مهاجرت به ۲.۰", "/docs/migration/"], ["امنیت", "/docs/security/"], ["حجم کامپوننت‌ها", "/docs/sizes/"], ["نسخه‌ها", "/docs/changelog/"]] },
  { title: "جامعه", links: [["GitHub", author.repo], ["گزارش مشکل", `${author.repo}/issues`], ["راهنمای مشارکت", `${author.repo}/blob/main/CONTRIBUTING.md`], ["دونیت و حمایت", author.telegram.href]] },
];
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="brand" aria-label="کاشی، صفحهٔ اصلی"><Logo size={24} /><span class="brand__name" aria-hidden="true">کاشی</span></a>
      <p>دیزاین‌سیستم متن‌باز فارسی.<br />منتشرشده با لایسنس MIT.</p>
      <a class="credit" href={author.site} target="_blank" rel="noopener">
        <img src={author.photo} alt="" width="28" height="28" loading="lazy" />
        <span>ساخته‌شده توسط <strong>{author.name}</strong><span class="k-sr-only"> (در پنجرهٔ جدید)</span></span>
      </a>
    </div>
    {columns.map((c) => (
      <nav aria-label={c.title}>
        <p class="site-footer__title">{c.title}</p>
        <ul role="list">{c.links.map(([label, href]) => {
          const external = href.startsWith("http");
          return <li><a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>{label}{external && <span class="k-sr-only"> (در پنجرهٔ جدید)</span>}</a></li>;
        })}</ul>
      </nav>
    ))}
  </div>
  <div class="site-footer__legal">
    <span>© ۲۰۲۶ مشارکت‌کنندگان کاشی · لایسنس MIT</span>
    <span class="site-footer__status"><span class="site-footer__dot" aria-hidden="true"></span>نسخهٔ پایدار <bdi dir="ltr">v{pkg.version}</bdi></span>
    <span>فونت وزیرمتن اثر صابر راستی‌کردار، تحت لایسنس SIL OFL 1.1</span>
  </div>
</footer>
