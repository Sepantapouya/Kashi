---
// Google Tag Manager برای سایت کاشی. فقط روی دامنهٔ واقعی بار می‌شود، نه روی localhost،
// تا بازدیدهای توسعه و تست‌های تصویری در آمار نیایند.
const GTM_ID = "GTM-TWGR2P8Z";
---
<script is:inline define:vars={{ GTM_ID }}>
  if (!/^(localhost|127\.0\.0\.1|\[::1\])$|\.(local|localhost|test)$/.test(location.hostname)) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
    const s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtm.js?id=" + GTM_ID;
    document.head.appendChild(s);
  }
</script>
