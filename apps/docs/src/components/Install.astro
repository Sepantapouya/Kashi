---
import { iconSvg } from "@kashi-ui/icons";
// دستور نصب با دکمهٔ کپی
interface Props { command?: string }
const { command = "npm i @kashi-ui/react @kashi-ui/css" } = Astro.props;
---
<div class="install">
  <span class="install__prompt" aria-hidden="true">$</span>
  <code class="install__cmd">{command}</code>
  <button type="button" class="k-btn k-btn--tertiary k-btn--icon k-btn--sm copy-btn" aria-label="کپی دستور نصب" data-copy={command}>
    <Fragment set:html={iconSvg("copy")} />
  </button>
</div>
