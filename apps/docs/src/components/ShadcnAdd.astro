---
// دستور نصب کامپوننت همین صفحه با رجیستری shadcn، زیر عنوان صفحه‌های کامپوننت
import { iconSvg } from "@kashi-ui/icons";
import { registryItems } from "../data/registry";

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const slug = path.split("/").at(-2);
const SITE = "https://kashi.sepantapouya.com";
const items = registryItems(SITE).filter((it) => !it.meta!.helper && it.meta!.href === path);
// اگر چند فایل به این صفحه می‌رسند، آن که هم‌نام صفحه است
const item = items.find((it) => it.name === slug) ?? items[0];
const cmd = item && `npx shadcn@latest add ${SITE}/r/${item.name}.json`;
---
{cmd && (
  <div class="shadcn-add">
    <a class="shadcn-add__label" href="/docs/installation/#رجیستری-shadcn">shadcn</a>
    <code dir="ltr">{cmd}</code>
    <button type="button" class="k-btn k-btn--tertiary k-btn--icon k-btn--sm shadcn-add__copy" aria-label="کپی دستور نصب با shadcn" data-copy={cmd} set:html={iconSvg("copy", { size: 15 })} />
  </div>
)}

<style>
  .shadcn-add { display: flex; align-items: center; gap: var(--k-space-2); max-inline-size: 100%; margin-block-start: var(--k-space-5); padding: 3px 3px 3px var(--k-space-3); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-md); background: var(--k-bg-secondary); inline-size: fit-content; }
  .shadcn-add__label { flex: none; padding: 0.125rem var(--k-space-2); border-radius: var(--k-radius-sm); background: var(--k-bg-tertiary); color: var(--k-text-secondary); font: 600 0.75rem var(--k-font-mono); text-decoration: none; }
  .shadcn-add__label:hover { color: var(--k-text-brand); }
  .shadcn-add code { min-inline-size: 0; overflow: hidden; padding: 0; border: 0; background: none; color: var(--k-text-tertiary); font-size: 0.75rem; text-overflow: ellipsis; white-space: nowrap; }
  .shadcn-add__copy { flex: none; }
  .shadcn-add__copy[data-copied] { color: var(--k-text-success); }
</style>
