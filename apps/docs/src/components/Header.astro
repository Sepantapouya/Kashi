---
import { iconSvg } from "@kashi-ui/icons";
import Logo from "./Logo.astro";
import { author } from "../data/author";
import Sidebar from "./Sidebar.astro";
import SiteSearch from "./SiteSearch";

const path = Astro.url.pathname;
// پیوندهای اصلی کم و ثابت؛ ابزارها در یک منوی کشویی تا سربرگ شلوغ نشود
const links = [
  { href: "/docs/", label: "مستندات", match: (p: string) => p.startsWith("/docs/") && !/^\/docs\/(components|persian|icons)\//.test(p) && !MENU_HREFS.some((h) => p.startsWith(h)) },
  { href: "/docs/components/", label: "کامپوننت‌ها", match: (p: string) => p.startsWith("/docs/components/") },
  { href: "/docs/persian/", label: "فارسی", match: (p: string) => p.startsWith("/docs/persian/") },
  { href: "/docs/icons/", label: "آیکون‌ها", match: (p: string) => p.startsWith("/docs/icons/") },
];
// منوهای کشویی: هر بخش عنوان دارد و آیتم‌ها در شبکهٔ هم‌اندازه می‌نشینند؛ متن کد لاتین داخل `بک‌تیک`
type MenuItem = { href: string; icon: string; label: string; text: string };
const menus: { id: string; label: string; cols: number; sections: { title?: string; items: MenuItem[] }[] }[] = [
  {
    id: "tools", label: "ابزارها", cols: 3,
    sections: [{ items: [
      { href: "/docs/theming/", icon: "palette", label: "تم‌ساز", text: "رنگ برند، گردی و تراکم را زنده بسازید" },
      { href: "/docs/figma/", icon: "pen-tool", label: "پلاگین فیگما", text: "کل کیت با یک کلیک در فایل شما" },
      { href: "/docs/tailwind/", icon: "wind", label: "Tailwind", text: "توکن‌های کاشی به‌شکل کلاس‌ها" },
      { href: "/docs/web-components/", icon: "puzzle", label: "وب کامپوننت‌ها", text: "بدون React، برای هر فریم‌ورکی" },
      { href: "/docs/installation/#رجیستری-shadcn", icon: "terminal", label: "رجیستری shadcn", text: "کد کامپوننت‌ها با `@kashi`" },
      { href: "/docs/ai/", icon: "ai-chat", label: "سرور MCP", text: "کاشی در دستیار هوش مصنوعی" },
    ] }],
  },
  {
    id: "guides", label: "راهنماها", cols: 2,
    sections: [
      { title: "طراحی و محتوا", items: [
        { href: "/docs/writing/", icon: "pen", label: "نوشتن متن رابط", text: "لحن، پیام خطا و فارسی‌نویسی" },
        { href: "/docs/accessibility/", icon: "accessibility", label: "دسترس‌پذیری", text: "WCAG 2.2 AA در همهٔ کامپوننت‌ها" },
        { href: "/docs/typography/", icon: "type", label: "فونت و تایپوگرافی", text: "وزیرمتن، اندازه‌ها و ارقام" },
        { href: "/docs/colors/", icon: "color-swatch", label: "رنگ‌ها", text: "پالت، رنگ‌های معنایی و کنتراست" },
      ] },
      { title: "پایداری", items: [
        { href: "/docs/i18n/", icon: "language", label: "دوزبانه", text: "فارسی و انگلیسی با یک تنظیم" },
        { href: "/docs/versioning/", icon: "git-branch", label: "سیاست تغییرات", text: "نسخه‌ها، منسوخ‌کردن و پشتیبانی" },
        { href: "/docs/security/", icon: "shield-check", label: "امنیت", text: "گزارش آسیب‌پذیری و زمان پاسخ" },
        { href: "/docs/sizes/", icon: "scale", label: "حجم کامپوننت‌ها", text: "حجم هر کامپوننت و سقف آن" },
      ] },
    ],
  },
];
const MENU_HREFS = menus.flatMap((m) => m.sections.flatMap((s) => s.items.map((i) => i.href))).filter((h) => !h.includes("#"));
const isCurrent = (href: string) => !href.includes("#") && path.startsWith(href);
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
// کد لاتین داخل متن فارسی در <bdi> تا «@kashi» به «kashi@» برنگردد
const inline = (t: string) => t.split("`").map((part, i) => (i % 2 ? `<bdi dir="ltr">${esc(part)}</bdi>` : esc(part))).join("");
---
<header class="site-header">
  <div class="site-header__inner">
    <button class="k-btn k-btn--tertiary k-btn--icon menu-btn" type="button" aria-label="باز کردن منو" aria-haspopup="dialog" data-open-menu>
      <Fragment set:html={iconSvg("menu")} />
    </button>
    <a href="/" class="brand" aria-label="کاشی، صفحهٔ اصلی">
      <Logo />
      <span class="brand__name" aria-hidden="true">کاشی</span>
    </a>

    <nav class="site-nav" aria-label="اصلی">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match(path) ? "page" : undefined}>{l.label}</a>
      ))}
      {menus.map((m) => (
        <div class="nav-menu" data-nav-menu>
          <button type="button" class="nav-menu__btn" aria-expanded="false" aria-controls={`${m.id}-menu`} data-active={m.sections.some((sec) => sec.items.some((i) => isCurrent(i.href))) ? "" : undefined}>
            {m.label}
            <Fragment set:html={iconSvg("chevron-down", { size: 16, className: "nav-menu__chev" })} />
          </button>
          <div class={`nav-menu__panel nav-menu__panel--${m.id}`} id={`${m.id}-menu`} style={`--cols: ${m.cols}`} hidden>
            {m.sections.map((sec) => (
              <div class="nav-menu__section">
                {sec.title && <p class="nav-menu__title">{sec.title}</p>}
                <div class="nav-menu__grid">
                  {sec.items.map((t) => (
                    <a class="nav-menu__item" href={t.href} aria-current={isCurrent(t.href) ? "page" : undefined}>
                      <span class="nav-menu__icon" set:html={iconSvg(t.icon, { size: 20 })} />
                      <span class="nav-menu__body"><b>{t.label}</b><small set:html={inline(t.text)} /></span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="site-header__end">
      <SiteSearch client:idle />
      <a class="k-btn k-btn--tertiary gh-btn" href={author.repo} target="_blank" rel="noopener" aria-label="مخزن کاشی در GitHub (در پنجرهٔ جدید)">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <span class="gh-btn__stars" data-gh-wait aria-hidden="true"><svg viewBox="0 0 20 20" fill="currentColor"><path d="m10 2.5 2.3 4.7 5.2.75-3.75 3.65.9 5.15L10 14.3l-4.65 2.45.9-5.15L2.5 7.95l5.2-.75Z"/></svg><span data-gh="stars"></span></span>
      </a>
      <button class="k-btn k-btn--tertiary k-btn--icon" type="button" data-theme-toggle aria-label="تم روشن">
        <Fragment set:html={iconSvg("sun", { className: "icon-sun" })} />
        <Fragment set:html={iconSvg("moon", { className: "icon-moon" })} />
      </button>
      <a class="k-btn k-btn--primary k-btn--sm install-btn" href="/docs/installation/" aria-current={path.startsWith("/docs/installation") ? "page" : undefined}>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3.5v9m0 0-3.5-3.5M10 12.5l3.5-3.5M4 15.5h12" /></svg>
        نصب
      </a>
    </div>
  </div>
</header>

<dialog class="menu-dialog" data-menu-dialog aria-label="منو">
  <div class="menu-dialog__head">
    <span>منو</span>
    <button class="k-btn k-btn--tertiary k-btn--icon k-btn--sm" type="button" aria-label="بستن منو" data-close-menu>
      <Fragment set:html={iconSvg("close")} />
    </button>
  </div>
  <Sidebar />
</dialog>

<script>
  import "../scripts/github-stats";

  // منوهای «ابزارها» و «راهنماها»: کلیک یا Enter باز می‌کند؛ باز شدن یکی، دیگری را می‌بندد؛ Escape، کلیک بیرون یا رفتن فوکوس می‌بندد
  document.querySelectorAll<HTMLElement>("[data-nav-menu]").forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>(".nav-menu__btn")!;
    const panel = root.querySelector<HTMLElement>(".nav-menu__panel")!;
    const items = () => [...panel.querySelectorAll<HTMLAnchorElement>("a")];
    const set = (open: boolean) => {
      if (open) document.querySelectorAll<HTMLElement>("[data-nav-menu]").forEach((other) => other !== root && other.dispatchEvent(new Event("kashi-close-menu")));
      btn.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    };
    root.addEventListener("kashi-close-menu", () => set(false));
    btn.addEventListener("click", () => set(panel.hidden));
    btn.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); set(true); items()[0]?.focus(); }
    });
    panel.addEventListener("keydown", (e) => {
      const list = items();
      const i = list.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === "ArrowDown") { e.preventDefault(); list[(i + 1) % list.length].focus(); }
      if (e.key === "ArrowUp") { e.preventDefault(); list[(i - 1 + list.length) % list.length].focus(); }
    });
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) { set(false); btn.focus(); }
    });
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node)) set(false);
    });
    document.addEventListener("pointerdown", (e) => {
      if (!root.contains(e.target as Node)) set(false);
    });
  });
</script>
