---
// بخش «راهنمای استفاده» پایان صفحه‌های کامپوننت: کِی استفاده کنیم، کِی نه (با جایگزین) و نمونهٔ درست و نادرست.
// محتوا از data/guidelines.ts می‌آید و همان متن با guidelineMarkdown به llms.txt و سرور MCP هم می‌رسد.
import { GUIDELINES } from "../data/guidelines";
import { iconSvg } from "@kashi-ui/icons";

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const g = GUIDELINES[path];
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// کد لاتین داخل متن فارسی در <code> جدا می‌شود تا ترتیب نمایش به‌هم نریزد
const inline = (t: string) => t.split("`").map((part, i) => (i % 2 ? `<code dir="ltr">${esc(part)}</code>` : esc(part))).join("");
const ok = iconSvg("check", { size: 16 }) ?? "";
const no = iconSvg("close", { size: 16 }) ?? "";
---
{g && (
  <section class="ug" aria-labelledby="راهنمای-استفاده">
    <h2 id="راهنمای-استفاده">راهنمای استفاده</h2>
    <div class="ug__cols">
      <div class="ug__col ug__col--use">
        <h3><span class="ug__badge" set:html={ok} />کِی استفاده کنیم</h3>
        <ul role="list">{g.use.map((u) => <li><span class="ug__bullet" set:html={ok} /><span set:html={inline(u)} /></li>)}</ul>
      </div>
      <div class="ug__col ug__col--avoid">
        <h3><span class="ug__badge" set:html={no} />کِی استفاده نکنیم</h3>
        <ul role="list">
          {g.avoid.map(([text, href, label]) => (
            <li><span class="ug__bullet" set:html={no} /><span><span set:html={inline(text)} />{href && <> <a class="ug__alt" href={href}>{label ?? "جایگزین"}<span aria-hidden="true"> ←</span></a></>}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <h3 class="ug__pairs-title">درست و نادرست</h3>
    <ol class="ug__pairs" role="list">
      {g.pairs.map((p, i) => (
        <li class="ug__pair">
          <span class="ug__n" aria-hidden="true">{(i + 1).toLocaleString("fa-IR")}</span>
          <figure class="ug__ex ug__ex--do">
            <div class="ug__stage">
              <span class="ug__tag"><span class="ug__tag-ic" set:html={ok} />درست</span>
              {p.do.html && <div class="ug__preview" inert set:html={p.do.html} />}
            </div>
            <figcaption><strong class="k-sr-only">درست: </strong><span set:html={inline(p.do.text)} /></figcaption>
          </figure>
          <figure class="ug__ex ug__ex--dont">
            <div class="ug__stage">
              <span class="ug__tag"><span class="ug__tag-ic" set:html={no} />نادرست</span>
              {p.dont.html && <div class="ug__preview" inert set:html={p.dont.html} />}
            </div>
            <figcaption><strong class="k-sr-only">نادرست: </strong><span set:html={inline(p.dont.text)} /></figcaption>
          </figure>
        </li>
      ))}
    </ol>

    {g.writing && (
      <>
        <h3>متن</h3>
        <ul class="ug__writing" role="list">{g.writing.map((w) => <li><span class="ug__bullet ug__bullet--pen" set:html={iconSvg("pen", { size: 14 }) ?? ""} /><span set:html={inline(w)} /></li>)}</ul>
        <p class="ug__more">قاعده‌های کلی لحن، برچسب دکمه و پیام خطا: <a href="/docs/writing/">نوشتن متن رابط</a></p>
      </>
    )}
  </section>
)}

<style>
  /* کِی استفاده کنیم / نکنیم */
  .ug__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--k-space-4); margin-block: var(--k-space-5); }
  .ug__col { --_c: var(--k-text-success); position: relative; overflow: hidden; padding: var(--k-space-5) var(--k-space-5) var(--k-space-4); border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: linear-gradient(180deg, color-mix(in srgb, var(--_c) 6%, transparent), transparent 55%), var(--k-bg-primary); }
  .ug__col--avoid { --_c: var(--k-text-error); }
  .ug__col::before { content: ""; position: absolute; inset-inline: 0; inset-block-start: 0; block-size: 2px; background: linear-gradient(90deg, transparent, var(--_c), transparent); opacity: 0.7; }
  .ug__col h3 { display: flex; align-items: center; gap: var(--k-space-2); margin: 0 0 var(--k-space-3); color: var(--k-text-primary); font-size: var(--k-text-md); }
  .ug__badge { display: grid; place-items: center; inline-size: 1.75rem; block-size: 1.75rem; border-radius: var(--k-radius-md); background: color-mix(in srgb, var(--_c) 14%, transparent); color: var(--_c); box-shadow: 0 0 0 1px color-mix(in srgb, var(--_c) 25%, transparent) inset; }
  .ug__col ul, .ug__writing { display: grid; gap: var(--k-space-2); margin: 0; padding: 0; list-style: none; }
  .ug__col li, .ug__writing li { display: flex; align-items: flex-start; gap: var(--k-space-2); color: var(--k-text-secondary); line-height: 1.85; }
  .ug__bullet { display: grid; flex: none; place-items: center; inline-size: 1.125rem; block-size: 1.125rem; margin-block-start: 0.35rem; border-radius: 50%; color: var(--_c); }
  .ug__bullet :global(svg) { inline-size: 0.875rem; block-size: 0.875rem; }
  .ug__bullet--pen { color: var(--k-text-brand); }
  .ug__alt { display: inline-flex; align-items: center; gap: 2px; margin-inline-start: var(--k-space-1); padding: 0 0.45rem; border-radius: var(--k-radius-full); background: var(--k-bg-brand-subtle); color: var(--k-text-brand); font-size: var(--k-text-xs); font-weight: var(--k-weight-semibold); text-decoration: none; white-space: nowrap; transition: background-color var(--k-duration-fast); }
  .ug__alt:hover { background: color-mix(in srgb, var(--k-text-brand) 20%, transparent); }

  /* درست و نادرست */
  .ug__pairs-title { margin-block-start: var(--k-space-10); }
  .ug__pairs { display: grid; gap: var(--k-space-5); margin: var(--k-space-4) 0 var(--k-space-6); padding: 0; list-style: none; counter-reset: none; }
  .ug__pair { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--k-space-3); }
  .ug__n { position: absolute; z-index: 2; inset-block-start: 50%; inset-inline-start: 50%; translate: 50% -50%; display: grid; place-items: center; inline-size: 1.75rem; block-size: 1.75rem; border: 1px solid var(--k-border-primary); border-radius: 50%; background: var(--k-bg-primary); color: var(--k-text-tertiary); font-size: var(--k-text-xs); font-weight: var(--k-weight-bold); box-shadow: 0 0 0 4px var(--k-bg-primary); }
  .ug__ex { --_c: var(--k-text-success); display: grid; grid-template-rows: 1fr auto; margin: 0; overflow: hidden; border: 1px solid var(--k-border-secondary); border-radius: var(--k-radius-xl); background: var(--k-bg-primary); transition: border-color var(--k-duration-normal), translate var(--k-duration-slow) var(--k-ease-spring), box-shadow var(--k-duration-slow); }
  .ug__ex--dont { --_c: var(--k-text-error); }
  .ug__ex:hover { border-color: color-mix(in srgb, var(--_c) 45%, transparent); box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--_c) 45%, transparent); }
  @media (prefers-reduced-motion: no-preference) { .ug__ex:hover { translate: 0 -2px; } }
  .ug__stage {
    position: relative;
    display: grid;
    min-block-size: 9rem;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--k-border-primary) 60%, transparent) 1px, transparent 0) 0 0 / 1.25rem 1.25rem,
      radial-gradient(80% 90% at 50% 0%, color-mix(in srgb, var(--_c) 9%, transparent), transparent 70%),
      var(--k-bg-secondary);
  }
  .ug__stage:not(:has(.ug__preview)) { min-block-size: 3.25rem; }
  .ug__stage::after { content: ""; position: absolute; inset-inline: 0; inset-block-end: 0; block-size: 3px; background: var(--_c); transform-origin: right; transition: scale var(--k-duration-slow) var(--k-ease-standard); }
  .ug__ex:not(:hover) .ug__stage::after { scale: 0.18 1; }
  :global([dir="ltr"]) .ug__stage::after { transform-origin: left; }
  .ug__tag { position: absolute; z-index: 1; inset-block-start: var(--k-space-3); inset-inline-start: var(--k-space-3); display: inline-flex; align-items: center; gap: 4px; padding: 0.2rem 0.65rem 0.2rem 0.25rem; border-radius: var(--k-radius-full); gap: 6px; background: color-mix(in srgb, var(--_c) 14%, var(--k-bg-primary)); color: var(--_c); font-size: var(--k-text-xs); font-weight: var(--k-weight-bold); box-shadow: 0 0 0 1px color-mix(in srgb, var(--_c) 30%, transparent) inset; }
  .ug__tag-ic { display: grid; flex: none; place-items: center; inline-size: 1.125rem; block-size: 1.125rem; border-radius: 50%; background: var(--_c); color: var(--k-bg-primary); }
  .ug__tag-ic :global(svg) { display: block; inline-size: 0.75rem; block-size: 0.75rem; stroke-width: 2.4; }
  .ug__preview { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--k-space-2); padding: var(--k-space-10) var(--k-space-5) var(--k-space-6); }
  .ug__preview > * { max-inline-size: 100%; }
  .ug__ex--dont .ug__preview { filter: saturate(0.7); opacity: 0.85; transition: filter var(--k-duration-slow), opacity var(--k-duration-slow); }
  .ug__ex--dont:hover .ug__preview { filter: none; opacity: 1; }
  .ug__ex figcaption { padding: var(--k-space-3) var(--k-space-4) var(--k-space-4); border-block-start: 1px solid var(--k-border-secondary); color: var(--k-text-secondary); font-size: var(--k-text-sm); line-height: 1.85; }
  .ug__more { color: var(--k-text-tertiary); font-size: var(--k-text-sm); }
  @media (max-width: 40rem) {
    .ug__pair { grid-template-columns: minmax(0, 1fr); }
    .ug__n { inset-block-start: 0; inset-inline-start: auto; inset-inline-end: 0; translate: 30% -30%; }
  }
</style>
