---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import Footer from "../components/Footer.astro";
import PageInstall from "../components/PageInstall.astro";
import ElementSection from "../components/ElementSection.astro";
import UsageSection from "../components/UsageSection.astro";
import { GUIDELINES } from "../data/guidelines";
import { ELEMENT_DOCS } from "../data/elements";
import { nav, siblings } from "../data/nav";

interface Props {
  frontmatter?: { title: string; description?: string; status?: string };
  title?: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const fm = Astro.props.frontmatter ?? { title: Astro.props.title ?? "", description: Astro.props.description };
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
// بخش «وب کامپوننت» که ElementSection در پایان صفحه می‌سازد در فهرست «در این صفحه» هم بیاید
const headings = [
  ...(Astro.props.headings ?? []),
  ...(GUIDELINES[path] ? [{ depth: 2, slug: "راهنمای-استفاده", text: "راهنمای استفاده" }] : []),
  ...(ELEMENT_DOCS[path] ? [{ depth: 2, slug: "وب-کامپوننت", text: "وب کامپوننت" }] : []),
];
const { prev, next } = siblings(Astro.url.pathname);
const group = nav.find((g) => g.items.some((i) => i.href === (Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/")))?.title;
---
<Base title={fm.title} description={fm.description}>
  <Header />

  <div class="docs">
    <aside class="docs__sidebar"><Sidebar /></aside>
    <main id="main" class="docs__main" tabindex="-1">
      <article class="prose">
        <header class="page-head">
          {group && <p class="page-head__crumb">{group}</p>}
          <h1>{fm.title}</h1>
          {fm.description && <p class="page-head__lead">{fm.description}</p>}
          <PageInstall />
        </header>
        <slot />
        <UsageSection />
        <ElementSection />
      </article>
      <nav class="pager" aria-label="صفحه‌های مجاور">
        {prev ? <a class="pager__link" href={prev.href} rel="prev"><span>قبلی</span>{prev.title}</a> : <span />}
        {next && <a class="pager__link pager__link--next" href={next.href} rel="next"><span>بعدی</span>{next.title}</a>}
      </nav>
    </main>
    <aside class="docs__toc"><Toc headings={headings} /></aside>
  </div>
  <Footer />
</Base>

<script>
  // نشانهٔ پیوند کنار عنوان بخش‌ها، برای فرستادن لینک همان بخش
  for (const h of document.querySelectorAll<HTMLElement>(".prose > h2[id], .prose > h3[id]")) {
    if (h.querySelector(".h-anchor")) continue;
    const a = document.createElement("a");
    a.className = "h-anchor";
    a.href = `#${h.id}`;
    a.setAttribute("aria-label", `پیوند به بخش ${h.textContent}`);
    a.innerHTML = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 11.5a3 3 0 0 0 4.2 0l2.6-2.6a3 3 0 0 0-4.2-4.2l-.8.8M11.5 8.5a3 3 0 0 0-4.2 0l-2.6 2.6a3 3 0 0 0 4.2 4.2l.8-.8"/></svg>';
    h.append(a);
  }
</script>
